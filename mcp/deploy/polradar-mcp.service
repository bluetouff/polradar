[Unit]
Description=Polradar MCP public en lecture seule
Requires=polradar-mcp.socket
After=polradar-mcp.socket

[Service]
Type=simple
ExecStart=/usr/local/lib/polradar-mcp/polradar-mcp
DynamicUser=yes
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
UMask=0077
StateDirectory=polradar-mcp
StateDirectoryMode=0700
InaccessiblePaths=-/etc/apache2 -/var/lib/polradar-stats -/etc/polradar-gsc -/var/lib/polradar-gsc -/var/lib/polradar-gsc-report -/var/log
Environment=GOMEMLIMIT=136MiB
MemoryMax=192M
TasksMax=64
Restart=on-failure
RestartSec=3s
