---
import type { DocumentaryRelation } from '../lib/documentary-relations';
import { documentaryLabel } from '../lib/documentary-relations';
import Icon from './Icon.astro';

interface Props {
  relations: DocumentaryRelation[];
  perspectives: readonly string[];
}
const { relations, perspectives } = Astro.props;
const selected = new Set(perspectives);
const families = {
  'question-proposition': 'Questions et propositions',
  'rapprochement-scrutin': 'Scrutins et votes',
  'comparaison-droit': 'Droit en vigueur',
  'poste-budgetaire': 'Chiffrages et financements',
  'version-precedente': 'Versions de la fiche',
};
const names: Record<string, string> = {
  reponse: 'Réponse documentée',
  complement: 'Complément de contexte',
  correction: 'Correction',
  enrichissement: 'Enrichissement',
  programme: 'Nouvelle publication de programme',
  'meme-objet': 'Même objet',
  'texte-plus-large': 'Texte au périmètre plus large',
  'mise-en-regard-editoriale': 'Comparaison avec les règles en vigueur',
  reliee: 'Chiffrage relié',
};
const groups = Object.entries(families)
  .map(([type, name]) => ({
    name,
    links: relations.filter((relation) => relation.type === type),
  }))
  .filter(({ links }) => links.length);
---

{groups.length > 0 && (
  <section class="evidence-links" id="preuves" aria-labelledby="proof-title">
    <header class="proof-heading">
      <span class="proof-icon" aria-hidden="true">
        <Icon name="layers" />
      </span>
      <h2 id="proof-title">Dossier de preuves</h2>
      <a href="/api/relations-documentaires.json">
        Graphe documentaire en JSON
      </a>
    </header>
    {groups.map(({ name, links }) => (
      <details class="reader-options" id={`preuve-${links[0].type}`}>
        <summary>
          <span>{name}</span>
          <span class="proof-count">({links.length})</span>
        </summary>
        <ul class="evidence-rows">
          {links.map((relation) => {
            const target =
              selected.has(relation.target.id) &&
              !selected.has(relation.origin.id)
                ? relation.origin
                : relation.target;
            return (
              <li>
                <p class="proof-qualification">
                  {names[relation.qualification] ?? relation.qualification}
                </p>
                <a href={target.url}>{documentaryLabel(target)}</a>
                <p>{relation.justification}</p>
                <ul>
                  {relation.sources.map((source) => (
                    <li>
                      <a href={source.url} rel="noreferrer">
                        {source.passage} ↗
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            );
          })}
        </ul>
      </details>
    ))}
  </section>
)}
<script>
  const section = document.querySelector('#preuves');
  if (section) {
    const openFragment = () => {
      const target = document.getElementById(location.hash.slice(1));
      if (target instanceof HTMLDetailsElement && section.contains(target))
        target.open = true;
    };
    openFragment();
    window.addEventListener('hashchange', openFragment);
  }
</script>
<style>
  .evidence-links {
    margin-block: 1.5rem;
    padding: clamp(0.9rem, 2vw, 1.4rem);
    border: 1px solid var(--line);
    border-radius: 0.7rem;
    background: var(--sheet);
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .proof-heading {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem 0.65rem;
    margin-block-end: 0.55rem;
    color: var(--ink);
  }
  .proof-heading h2 {
    flex: 1 1 13ch;
    margin: 0;
    font: 400 1.3rem/1.25 var(--serif);
  }
  .proof-icon {
    display: grid;
    place-items: center;
    inline-size: 2rem;
    block-size: 2rem;
    border-radius: 0.4rem 0.15rem 0.4rem 0.4rem;
    background: var(--light);
    color: var(--accent);
  }
  .proof-icon :global(.icon) {
    inline-size: 1rem;
    block-size: 1rem;
  }
  .proof-heading a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--target-size);
    color: var(--accent);
    font-size: 0.83rem;
  }
  .evidence-links .reader-options {
    background: var(--paper);
  }
  .evidence-links .reader-options:last-child {
    margin-block-end: 0;
  }
  .proof-count {
    font-size: 0.86em;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }
  .evidence-rows {
    display: grid;
    gap: 0.48rem;
    margin: 0 0 0.65rem;
    padding-inline: 0.65rem;
    list-style: none;
  }
  .evidence-rows > li {
    padding: 0.72rem 0.85rem;
    border-inline-start: 2px solid var(--accent);
    border-radius: 0.3rem;
    background: var(--sheet);
    font-size: 0.9rem;
  }
  .evidence-rows p {
    margin-block: 0.2rem;
  }
  .proof-qualification {
    color: var(--accent);
    font-size: 0.8rem;
    font-weight: 620;
  }
  .evidence-rows ul {
    padding-inline-start: 1rem;
  }
</style>
