---
import { candidates, byCandidate, type Candidate } from '../lib/data';
interface Props {
  candidate: Candidate;
}
const { candidate } = Astro.props;
const count = byCandidate(candidate.id, false).length;
const index = candidates.findIndex((item) => item.id === candidate.id) + 1;
---

<article
  class="candidate-card"
  data-search={`${candidate.name} ${candidate.party}`}
>
  <span class="candidate-index" aria-hidden="true">
    {String(index).padStart(2, '0')}
  </span>
  <div class="candidate-identity">
    <h3>
      <a href={`/candidats/${candidate.id}/`}>{candidate.name}</a>
    </h3>
    <p class="party-label">{candidate.party}</p>
    <p class="candidate-note">{candidate.note}</p>
  </div>
  <p class="candidate-status">
    <span class="tag">{candidate.status}</span>
  </p>
  <p class="candidate-coverage">
    <strong>{count}</strong> thème{count > 1 ? 's' : ''}
    <small>hors archives</small>
  </p>
  <a
    class="candidate-open"
    href={`/candidats/${candidate.id}/`}
    aria-label={`Lire le dossier de ${candidate.name}`}
  >
    ↗
  </a>
</article>
