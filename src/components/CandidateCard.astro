---
import { candidates, measures, themes, type Candidate } from '../lib/data';
import { portraitLinks } from '../lib/portrait-links.mjs';
import { portraitFor } from '../lib/portraits';
import CandidatePortrait from './CandidatePortrait.astro';
interface Props {
  candidate: Candidate;
}
const { candidate } = Astro.props;
const externalPortrait =
  !portraitFor(candidate.id) && portraitLinks[candidate.id];
const records = measures.filter(
  (row) => row.candidate === candidate.id && row.scope !== 'archive',
);
const counts = Object.fromEntries(
  themes.map((theme) => [
    theme.id,
    records.filter((row) => row.theme === theme.id).length,
  ]),
);
const covered = Object.values(counts).filter((count) => count > 0).length;
const index = candidates.findIndex((item) => item.id === candidate.id) + 1;
---

<article
  class="person"
  data-search={`${candidate.name} ${candidate.party}`}
  data-theme-counts={JSON.stringify(counts)}
>
  <a
    class="person-link"
    href={`/candidats/${candidate.id}/`}
    data-person-link
    data-base-url={`/candidats/${candidate.id}/`}
  >
    <div class="person-visual">
      <CandidatePortrait candidate={candidate} eager={index <= 5} />
      <span class="person-open" aria-hidden="true">
        ↗
      </span>
    </div>
    <div class="person-title">
      <h2>{candidate.name}</h2>
      <p class="person-party">{candidate.party}</p>
    </div>
  </a>
  {externalPortrait && (
    <a class="portrait-link" href={externalPortrait.url} rel="noreferrer">
      {externalPortrait.label} ↗
    </a>
  )}
  <p class="person-status">{candidate.status}</p>
  <div class="person-topics" aria-hidden="true">
    {themes.map((theme) => (
      <span
        data-theme-cell={theme.id}
        data-covered={counts[theme.id] > 0 ? 'yes' : 'no'}
        title={`${theme.label} : ${counts[theme.id]} fiche${counts[theme.id] > 1 ? 's' : ''}`}
      />
    ))}
  </div>
  <p
    class="person-count"
    data-person-count
    data-default-label={
      records.length
        ? `${records.length} fiches · ${covered} thèmes`
        : 'Dossier à documenter'
    }
  >
    {records.length
      ? `${records.length} fiches · ${covered} thèmes`
      : 'Dossier à documenter'}
  </p>
</article>

<style>
  .portrait-link {
    display: inline-block;
    align-self: start;
    margin: 0.3rem 1rem;
    font-size: 0.8rem;
    line-height: 1.4;
    color: #245667;
  }
</style>
