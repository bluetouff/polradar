---
import { sameSentence, sourceCountLabel } from '../lib/measure-text';
import Icon from './Icon.astro';
import CandidatePortrait from './CandidatePortrait.astro';
import { candidateById, themeById, scopes, type Measure } from '../lib/data';
interface Props {
  measure: Measure;
  compact?: boolean;
  showAuthor?: boolean;
  level?: 'h3' | 'h4';
}
const {
  measure,
  compact = false,
  showAuthor = false,
  level = 'h3',
} = Astro.props;
const Heading = level;
const candidate = candidateById(measure.candidate),
  theme = themeById(measure.theme);
const portrait =
  showAuthor && measure.scope !== 'parti' && !measure.partyAuthor;
---

<article
  class:list={['measure-row', { compact }]}
  data-scope={measure.scope}
  data-search={`${measure.partyAuthor ?? candidate.name} ${theme.label} ${measure.title} ${measure.description}`}
>
  {portrait ? (
    <a
      class="measure-symbol measure-author"
      href={`/candidats/${candidate.id}/`}
      aria-label={candidate.name}
    >
      <CandidatePortrait candidate={candidate} compact />
    </a>
  ) : (
    <a
      class="measure-symbol"
      href={`/themes/${theme.id}/`}
      aria-label={theme.label}
    >
      <Icon name={theme.id} />
    </a>
  )}
  <div class="measure-content">
    <div class="measure-meta">
      {measure.partyAuthor ? (
        <strong>{measure.partyAuthor}</strong>
      ) : (
        <a href={`/candidats/${candidate.id}/`}>{candidate.name}</a>
      )}
      <span class:list={['tag', { archive: measure.scope === 'archive' }]}>
        {scopes[measure.scope]}
      </span>
    </div>
    <Heading>
      <a href={`/mesures/${measure.id}/`}>{measure.title}</a>
    </Heading>
    {!compact && !sameSentence(measure.title, measure.description) && (
      <p>{measure.description}</p>
    )}
    {(measure.metrics.length > 0 || measure.amounts.length > 0) && (
      <div class="measure-quantities">
        {measure.metrics.map((metric) => (
          <span>
            <b>{metric.value.toLocaleString('fr-FR')}</b> {metric.unit}
          </span>
        ))}
        {measure.amounts.map((amount) => (
          <span>
            <b>
              {amount.value.toLocaleString('fr-FR')} {amount.unit}
            </b>{' '}
            / {amount.period}{' '}
            {amount.basis === 'non-applicable' ? '' : amount.basis}
          </span>
        ))}
      </div>
    )}
    <div class="measure-links">
      <a href={`/mesures/${measure.id}/#sources`}>
        <Icon name="source" />
        {sourceCountLabel(measure.sourceRefs)}
      </a>
      <a href={`/historique/?mesure=${measure.id}`}>
        <Icon name="historique" />
        {measure.revision} version{measure.revision > 1 ? 's' : ''}
      </a>
    </div>
  </div>
</article>
