---
import BrandLogo from './BrandLogo.astro';
import { meta, formatDate } from '../lib/data';
import { footerColumns as columns } from '../lib/footer-links';
const landing = Astro.url.pathname.split('/').filter(Boolean).length <= 1;
---

<footer class="publication-footer">
  <div class="footer-inner">
    <div class="footer-intro">
      <div>
        <a href="/" class="footer-brand" aria-label="Polradar, accueil">
          <BrandLogo />
        </a>
        <p>
          Présidentielle française 2027
          <br />
          Programmes, candidatures et campagne.
        </p>
      </div>
      <a href="/suivi/" class="footer-follow">
        <span>
          Mon suivi<small>Choisir mes candidats et mes thèmes</small>
        </span>
      </a>
    </div>
    <nav
      class="footer-columns"
      aria-label="Plan du site"
      id="plan-du-site"
      data-footer-links={landing ? undefined : ''}
    >
      {landing ? (
        columns.map((column) => (
          <div>
            <h2 class={`menu-${column.icon}`}>{column.title}</h2>
            <div class="footer-links">
              {column.links.map(([url, label]) => (
                <a href={url}>{label}</a>
              ))}
            </div>
          </div>
        ))
      ) : (
        <div class="footer-links">
          <a href="/#plan-du-site">Plan du site complet</a>
          <a href="/mentions/">Mentions et confidentialité</a>
        </div>
      )}
    </nav>
    <div class="footer-meta">
      <p>
        Corpus mis à jour le{' '}
        <time datetime={meta.corpusUpdated}>
          {formatDate(meta.corpusUpdated)}
        </time>
        <span> · Sélection non exhaustive</span>
      </p>
      <a href={meta.repository} target="_blank" rel="noopener noreferrer">
        GitHub · Licence MIT
      </a>
    </div>
    <div class="footer-bottom">
      <span class="footer-credit">
        <span>Polradar · a</span>
        <a href="https://l0g.fr/" class="log-wordmark" aria-label="l0g_">
          l<span class="log-wordmark-zero">0</span>g
          <span class="log-wordmark-cursor">_</span>
        </a>
        <span>website by</span>
        <a href="https://bluetouff.com/">bluetouff</a>
      </span>
      <a href="/reperes/">Calendrier électoral</a>
    </div>
  </div>
</footer>
