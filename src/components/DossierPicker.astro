---
import Icon from './Icon.astro';
import PagedResults from './PagedResults.astro';
import type { voteCases } from '../lib/votes-data';
import type { Candidate } from '../lib/data';
interface Props {
  type: 'votes' | 'evolution' | 'financements';
  choices: {
    id: string;
    title: string;
    candidate: Candidate;
    topic: string;
    icon: string;
    detail: string;
    subject?: string;
    ballot?: (typeof voteCases)[number]['ballots'][number];
    comparison?: { first: string; last: string; note: string };
    amount?: { value: string; horizon: string };
  }[];
}
const { type, choices } = Astro.props;
const votes = type === 'votes';
const key = type === 'financements' ? 'carte' : 'dossier';
const ordered = [...choices].sort(
  (a, b) =>
    a.title.localeCompare(b.title, 'fr') ||
    a.candidate.name.localeCompare(b.candidate.name, 'fr'),
);
---

<nav class="dossier-picker" aria-label="Choisir un dossier">
  <label class="dossier-select">
    Accès direct
    <select
      data-vote-select={votes || undefined}
      data-evidence-select={!votes || undefined}
    >
      <option value="">Tous les dossiers</option>
      {ordered.map((choice) => (
        <option value={choice.id}>
          {choice.title} · {choice.candidate.name}
        </option>
      ))}
    </select>
  </label>
  <details open class="dossier-directory">
    <summary>
      <Icon name="layers" />
      Les {choices.length} dossiers
      <Icon name="chevron" />
    </summary>
    <PagedResults total={ordered.length}>
      <div class="subject-directory" data-document-list>
        {ordered.map((choice) => (
          <a
            class="subject-card"
            data-page-item
            href={`#${key}=${choice.id}`}
            data-vote-tab={votes ? choice.id : undefined}
            data-evidence-tab={!votes ? choice.id : undefined}
          >
            <span class="subject-topic">
              <Icon name={choice.icon} />
              {choice.topic}
            </span>
            <strong>{choice.title}</strong>
            {choice.subject && (
              <span class="subject-ballot">{choice.subject}</span>
            )}
            {choice.ballot && (
              <span class="vote-preview">
                <span>Résultat du scrutin</span>
                {choice.ballot.kind === 'motion-censure' ? (
                  <strong>
                    {choice.ballot.tally.for} voix pour la motion ·{' '}
                    {choice.ballot.tally.majority} requises
                  </strong>
                ) : (
                  <>
                    <svg
                      viewBox={`0 0 ${choice.ballot.tally.voters} 1`}
                      preserveAspectRatio="none"
                      aria-hidden="true"
                    >
                      <rect
                        width={choice.ballot.tally.for}
                        height="1"
                        fill="#23736e"
                      />
                      <rect
                        x={choice.ballot.tally.for}
                        width={choice.ballot.tally.against!}
                        height="1"
                        fill="#a75839"
                      />
                      <rect
                        x={choice.ballot.tally.expressed}
                        width={choice.ballot.tally.abstained!}
                        height="1"
                        fill="#7c8794"
                      />
                    </svg>
                    <strong>
                      {choice.ballot.tally.for} pour ·{' '}
                      {choice.ballot.tally.against} contre ·{' '}
                      {choice.ballot.tally.abstained}{' '}
                      {choice.ballot.tally.abstained! > 1
                        ? 'abstentions'
                        : 'abstention'}
                    </strong>
                  </>
                )}
              </span>
            )}
            {choice.comparison && (
              <span class="track-preview">
                <span>{choice.comparison.note}</span>
                <strong>{choice.comparison.first}</strong>
                <strong>{choice.comparison.last}</strong>
              </span>
            )}
            {choice.amount && (
              <span class="amount-preview">
                <b>{choice.amount.value}</b>
                <span>{choice.amount.horizon}</span>
              </span>
            )}
            <small>{choice.detail}</small>
            <span class="subject-person">
              {choice.candidate.name}
              <Icon name="arrow" />
            </span>
          </a>
        ))}
      </div>
    </PagedResults>
  </details>
</nav>
<script src="../scripts/document-pages.ts"></script>
<style>
  .vote-preview,
  .track-preview,
  .amount-preview {
    width: 100%;
    display: grid;
    gap: 0.28rem;
    border-top: 1px solid #c6d5da;
    padding: 0.5rem 0 0.15rem;
  }
  .vote-preview > span,
  .track-preview > span,
  .amount-preview > span {
    color: #495f69;
    font-size: 0.77rem;
  }
  .vote-preview svg {
    width: 100%;
    height: 0.55rem;
    border-radius: 0.15rem;
  }
  .subject-card .vote-preview strong,
  .subject-card .track-preview strong {
    color: #183a46;
    font-size: 0.84rem;
    line-height: 1.4;
    font-variant-numeric: tabular-nums;
  }
  .track-preview {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.3rem 0.5rem;
  }
  .track-preview span {
    grid-column: 1/-1;
  }
  .track-preview strong {
    border-inline-start: 3px solid #548192;
    padding-inline-start: 0.45rem;
  }
  .track-preview strong:last-child {
    border-color: #ae7053;
  }
  .amount-preview b {
    font-size: 1.3rem;
    color: #1a535f;
    font-variant-numeric: tabular-nums;
  }

  .subject-directory {
    padding: 0.75rem;
    display: grid;
    gap: 0.65rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }
  .dossier-directory .subject-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    padding: 0.9rem 1rem;
    text-decoration: none;
    color: #18323f;
    background: linear-gradient(135deg, #fff 0%, #eef4f5 100%);
  }
  .subject-card[hidden] {
    display: none;
  }
  .subject-card strong {
    font: 630 1.03rem/1.28 var(--sans);
  }
  .subject-topic,
  .subject-person {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.76rem;
  }
  .subject-topic {
    color: #305b6b;
    margin-bottom: 0.2rem;
  }
  .subject-topic :global(.icon) {
    width: 1.1rem;
    height: 1.1rem;
  }
  .subject-ballot {
    font-size: 0.85rem;
    line-height: 1.4;
  }
  .subject-card small {
    font-size: 0.76rem;
    color: #465f6d;
  }
  .subject-person {
    width: 100%;
    border-top: 1px solid #b9cdd3;
    padding-top: 0.5rem;
    margin-top: auto;
    color: #3d5661;
  }
  .subject-person :global(.icon) {
    width: 0.9rem;
    height: 0.9rem;
    margin-left: auto;
  }
  .dossier-directory .subject-card:hover,
  .dossier-directory .subject-card:focus-visible {
    border-color: #367086;
    background: #e8f3f6;
  }
  .dossier-directory .subject-card[aria-current] {
    border-color: #347183;
    color: #18323f;
    background: #e1eff1;
  }
</style>
