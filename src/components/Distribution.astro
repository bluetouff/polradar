---
interface Props {
  title: string;
  note: string;
  parts: { label: string; count: number }[];
}
const { title, note, parts } = Astro.props;
const total = parts.reduce((sum, part) => sum + part.count, 0);
let x = 0;
---

<figure class="distribution">
  <figcaption>
    <strong>{title}</strong>
    <span>{note}</span>
  </figcaption>
  {total > 0 && (
    <svg
      viewBox={`0 0 ${total} 1`}
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      {parts.map(({ count }) => {
        const start = x;
        x += count;
        return <rect x={start} width={count} height="1" />;
      })}
    </svg>
  )}
  <ul>
    {parts.map(({ label, count }) => (
      <li>
        <b>{count.toLocaleString('fr-FR')}</b>
        <span>{label}</span>
      </li>
    ))}
  </ul>
</figure>
<style>
  .distribution {
    --one: #80c8cd;
    --two: #e9ab82;
    --three: #9bb6dc;
    --four: #e1d49a;
    color: #f4f8f9;
    background: linear-gradient(116deg, #112a37 8%, #1a404f 88%);
    border: 1px solid #375c69;
    border-radius: 0.75rem;
    margin: 0 0 1rem;
    padding: clamp(0.9rem, 1.8vw, 1.4rem) clamp(1rem, 2.3vw, 1.8rem);
  }
  .distribution figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    align-items: baseline;
    justify-content: space-between;
    line-height: 1.4;
  }
  .distribution figcaption strong {
    font-size: 1.08rem;
    color: #f4f8f9;
  }
  .distribution figcaption span {
    color: #c3d8df;
    font-size: 0.84rem;
  }
  .distribution svg {
    width: 100%;
    height: 0.85rem;
    display: block;
    border-radius: 0.18rem;
    margin-block: 0.8rem;
    overflow: hidden;
  }
  .distribution :is(rect, li):nth-child(1) {
    --tone: var(--one);
  }
  .distribution :is(rect, li):nth-child(2) {
    --tone: var(--two);
  }
  .distribution :is(rect, li):nth-child(3) {
    --tone: var(--three);
  }
  .distribution :is(rect, li):nth-child(4) {
    --tone: var(--four);
  }
  .distribution rect {
    fill: var(--tone);
    stroke: #193846;
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }
  .distribution ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr));
    gap: 0.65rem 1rem;
  }
  .distribution li {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    line-height: 1.24;
    font-size: 0.85rem;
    color: #ebf3f5;
  }
  .distribution li b {
    color: var(--tone);
    font-variant-numeric: tabular-nums;
    font-size: 1.35rem;
    font-weight: 600;
  }
  @media (max-width: 450px) {
    .distribution ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media print {
    .distribution {
      color: black;
      background: white;
      border: 1px solid;
    }
    .distribution :is(li, b, figcaption strong, figcaption span) {
      color: black;
    }
  }
</style>
