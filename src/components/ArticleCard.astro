---
import { formatDate } from '../lib/data';
import type { CollectionEntry } from 'astro:content';
interface Props {
  article: CollectionEntry<'articles'>;
  index?: number;
}
const { article, index = 0 } = Astro.props;
---

<article class="article-card">
  <div class:list={['article-art', `art-${index % 3}`]} aria-hidden="true">
    <svg viewBox="0 0 360 170">
      <circle cx="180" cy="85" r="62" />
      <circle cx="180" cy="85" r="37" />
      <path d="M60 85h240M180 8v154M100 140 260 30" />
      <rect
        x="143"
        y="48"
        width="74"
        height="74"
        transform="rotate(45 180 85)"
      />
    </svg>
    <span>{String(index + 1).padStart(2, '0')}</span>
  </div>
  <div class="article-card-text">
    <p class="eyebrow">
      {article.data.category} · {formatDate(article.data.published)}
    </p>
    <h3>
      <a href={`/dossiers/${article.id}/`}>{article.data.title}</a>
    </h3>
    <p>{article.data.description}</p>
    <a class="text-link" href={`/dossiers/${article.id}/`}>
      Lire le décryptage <span aria-hidden="true">↗</span>
    </a>
  </div>
</article>
