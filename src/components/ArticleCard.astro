---
import { formatDate } from '../lib/data';
import Icon from './Icon.astro';
import type { CollectionEntry } from 'astro:content';
interface Props {
  article: CollectionEntry<'articles'>;
}
const { article } = Astro.props;
---

<article class="article-card">
  <span class="article-symbol" aria-hidden="true">
    <Icon name={article.data.themes[0] ?? 'source'} />
  </span>
  <div class="article-card-text">
    <p class="article-meta">
      {article.data.category} <span aria-hidden="true">/</span>{' '}
      <time datetime={article.data.published}>
        {formatDate(article.data.published)}
      </time>
    </p>
    <h2>
      <a href={`/dossiers/${article.id}/`}>{article.data.title}</a>
    </h2>
    <p>{article.data.description}</p>
  </div>
  <span class="article-open" aria-hidden="true">
    <Icon name="arrow" />
  </span>
</article>
