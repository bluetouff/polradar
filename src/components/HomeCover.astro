---
import Icon from './Icon.astro';
import { candidates, events, measures, sources } from '../lib/data';
import smallPrint from '../assets/edition/scrutin-480.webp?url';
import largePrint from '../assets/edition/scrutin-1200.webp?url';

const dates = events.filter(({ id }) =>
  ['premier-tour', 'second-tour'].includes(id),
);
const month = new Intl.DateTimeFormat('fr-FR', {
  month: 'long',
  year: 'numeric',
  timeZone: 'Europe/Paris',
});
const register = [
  {
    url: '/candidats/',
    icon: 'people',
    count: candidates.length,
    label: 'profils suivis',
  },
  {
    url: '/mesures/',
    icon: 'mesures',
    count: measures.filter(({ scope }) => scope !== 'archive').length,
    label: 'fiches hors archives',
  },
  { url: '/sources/', icon: 'source', count: sources.length, label: 'sources' },
];
---

<header class="election-cover">
  <div class="cover-title">
    <h1>Présidentielle 2027</h1>
    <p>Programmes, données publiques et calendrier électoral.</p>
  </div>
  <img
    class="cover-print"
    src={largePrint}
    srcset={`${smallPrint} 480w, ${largePrint} 1200w`}
    sizes="(max-width: 620px) 39vw, (max-width: 1536px) 49vw, 720px"
    width="1200"
    height="800"
    fetchpriority="high"
    alt=""
  />
  <div class="cover-calendar">
    <a href="/reperes/" class="calendar-link">
      <Icon name="clock" /> Calendrier électoral
    </a>
    <dl>
      {dates.map((event) => (
        <div>
          <dt>{event.title}</dt>
          <dd>
            <time datetime={event.date}>
              <span class="day">{Number(event.date.slice(8))}</span>{' '}
              <span>{month.format(new Date(event.date))}</span>
            </time>
          </dd>
        </div>
      ))}
    </dl>
  </div>
  <nav class="cover-register" aria-label="Accès rapides">
    {register.map(({ url, icon, count, label }) => (
      <a href={url}>
        <Icon name={icon} />
        <strong>{count}</strong> <span>{label}</span>
      </a>
    ))}
  </nav>
</header>

<style>
  .election-cover {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    grid-template-areas: 'title art' 'calendar art' 'register register';
    grid-template-rows: auto 1fr auto;
    isolation: isolate;
    color: var(--ink);
    background: #bda8f0;
    border: 1px solid var(--ink);
    margin-bottom: clamp(1rem, 2vw, 1.6rem);
  }
  .cover-title {
    grid-area: title;
    padding: clamp(1.15rem, 2.6vw, 2.35rem) clamp(1rem, 2.6vw, 2.4rem) 0;
  }
  .cover-title h1 {
    font-size: clamp(1.5rem, 2.1vw, 1.75rem);
    letter-spacing: -0.055em;
    line-height: 1.1;
  }
  .cover-title p {
    max-width: 39ch;
    font-size: 1rem;
    margin-top: 0.5rem;
    line-height: 1.4;
  }
  .cover-print {
    grid-area: art;
    width: 100%;
    height: 100%;
    min-height: 0;
    min-width: 0;
    object-fit: cover;
    object-position: center 48%;
    aspect-ratio: auto;
    contain: size;
    clip-path: polygon(4% 0, 100% 0, 100% 100%, 0 100%);
  }
  .cover-calendar {
    grid-area: calendar;
    align-self: end;
    margin: clamp(1.25rem, 2vw, 1.8rem) clamp(1rem, 2.6vw, 2.4rem)
      clamp(1rem, 2vw, 1.7rem);
    border-top: 1px solid #736487;
  }
  .calendar-link {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    min-height: 2.55rem;
    font: 650 0.82rem var(--sans);
    text-decoration-thickness: 1px;
  }
  .calendar-link .icon {
    width: 1rem;
    height: 1rem;
  }
  .cover-calendar dl {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: 0.15rem 0 0;
    gap: 0.65rem;
  }
  .cover-calendar dl > div + div {
    border-inline-start: 1px solid #736487;
    padding-inline-start: clamp(0.7rem, 1.5vw, 1.6rem);
  }
  .cover-calendar dt {
    font-size: 0.82rem;
    line-height: 1.3;
    font-weight: 650;
  }
  .cover-calendar dd {
    margin: 0;
  }
  .cover-calendar time {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.6rem;
    font-size: 0.88rem;
  }
  .cover-calendar .day {
    font: 400 clamp(2.7rem, 4.8vw, 4.6rem)/0.95 var(--display);
    letter-spacing: -0.045em;
  }
  .cover-register {
    grid-area: register;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    background: var(--citron);
    border-top: 1px solid var(--ink);
  }
  .cover-register a {
    display: flex;
    align-items: center;
    min-width: 0;
    padding: 0.7rem clamp(0.7rem, 2.5vw, 2.4rem);
    gap: 0.55rem;
    color: var(--ink);
    text-decoration: none;
    line-height: 1.2;
    font-size: 0.88rem;
  }
  .cover-register a + a {
    border-inline-start: 1px solid #818451;
  }
  .cover-register .icon {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
  }
  .cover-register strong {
    font: 750 clamp(1.35rem, 2vw, 1.75rem)/1 var(--sans);
    letter-spacing: -0.055em;
    font-variant-numeric: tabular-nums;
  }
  .cover-register a:hover {
    background: #f4ffac;
  }
  .cover-register a:hover span {
    text-decoration: underline;
  }
  @media (max-width: 620px) {
    .election-cover {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      grid-template-areas: 'title art' 'calendar calendar' 'register register';
    }
    .cover-title {
      align-self: center;
      padding: 1rem 0.72rem;
    }
    .cover-title h1 {
      font-size: 1.5rem;
    }
    .cover-title p {
      font-size: 0.87rem;
    }
    .cover-calendar {
      margin: 0;
      padding: 0.25rem 0.72rem 0.85rem;
    }
    .cover-register a {
      display: grid;
      grid-template-columns: auto 1fr;
      align-content: start;
      gap: 0.3rem;
      padding: 0.65rem 0.55rem;
    }
    .cover-register .icon {
      width: 0.95rem;
      height: 0.95rem;
    }
    .cover-register span {
      grid-column: 1 / -1;
      font-size: 0.78rem;
    }
  }
  @media print {
    .election-cover {
      background: white;
      color: black;
    }
    .cover-print {
      display: none;
    }
    .election-cover {
      grid-template-columns: 1fr;
      grid-template-areas: 'title' 'calendar' 'register';
    }
  }
</style>
