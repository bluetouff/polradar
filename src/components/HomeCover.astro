---
import Icon from './Icon.astro';
import { electionRounds } from '../lib/data';
import photoSmall from '../assets/edition/palais-bourbon-680.webp?url';
import photoLarge from '../assets/edition/palais-bourbon-1360.webp?url';
import photoMobile from '../assets/edition/palais-bourbon-680.avif?url';

const subjects = [
  ['/themes/retraites/', 'Retraites'],
  ['/comparer/?theme=climat&question=climat-production-nucleaire', 'Nucléaire'],
  ['/votes/recherche/', 'Votes au Parlement'],
] as const;
const date = new Intl.DateTimeFormat('fr-FR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'Europe/Paris',
});
---

<header class="election-cover">
  <picture class="cover-photo">
    <source media="(max-width: 760px)" type="image/avif" srcset={photoMobile} />
    <img
      src={photoSmall}
      srcset={`${photoSmall} 680w, ${photoLarge} 1360w`}
      sizes="(max-width: 760px) 100vw, (max-width: 1400px) 66vw, 880px"
      width="1360"
      height="848"
      alt=""
      fetchpriority="high"
      decoding="async"
    />
  </picture>
  <div class="cover-intro">
    <h1>
      Présidentielle <span>2027</span>
    </h1>
    <p>
      Comparez les programmes, vérifiez les votes et retrouvez les documents
      d’origine.
    </p>
    <form
      action="/recherche/"
      class="cover-search"
      role="search"
      data-cover-search
    >
      <label for="cover-query">Que voulez-vous comprendre ?</label>
      <div>
        <input
          id="cover-query"
          type="search"
          maxlength="200"
          placeholder="Ex. retraites"
          autocomplete="off"
          required
        />
        <button class="button primary" type="submit">
          <Icon name="search" /> Rechercher
        </button>
      </div>
    </form>
    <noscript>
      <p class="cover-noscript">
        Accédez aux sujets et aux votes via les liens ci-dessous.
      </p>
    </noscript>
    <nav class="cover-subjects" aria-label="Recherches suggérées">
      {subjects.map(([url, label]) => (
        <a href={url}>{label}</a>
      ))}
    </nav>
  </div>
  {electionRounds.length > 0 && (
    <div class="cover-calendar">
      <a href="/reperes/" class="calendar-link">
        <Icon name="clock" /> Calendrier électoral
      </a>
      <dl>
        {electionRounds.map((event) => (
          <div>
            <dt>{event.title}</dt>
            <dd>
              <time datetime={event.date}>
                {date.format(new Date(event.date))}
              </time>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  )}
  <a class="cover-credit" href="/credits-photos/#palais-bourbon">
    Palais Bourbon · Getfunky Paris
  </a>
</header>
<script>
  const form = document.querySelector<HTMLFormElement>('[data-cover-search]');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const input = form.querySelector<HTMLInputElement>('input');
    const query = input?.value.trim().slice(0, 200);
    if (!query) {
      input?.focus();
      return;
    }
    location.assign(form.action + '#' + new URLSearchParams({ q: query }));
  });
</script>
<style>
  .election-cover {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(15.5rem, 1fr);
    gap: 0.55rem clamp(1.3rem, 4vw, 4.25rem);
    align-items: center;
    overflow: hidden;
    min-height: 19rem;
    padding: clamp(1.25rem, 3.2vw, 2.4rem) clamp(1.2rem, 4vw, 3.25rem) 0.75rem;
    border: 1px solid #365662;
    border-radius: 1.25rem;
    background: #142a39;
    color: #f6fafb;
  }
  .election-cover::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    background:
      linear-gradient(0deg, #0b1b29c9, transparent 54%),
      linear-gradient(
        92deg,
        #142a39 31%,
        #142a39f2 42%,
        #12273648 70%,
        #12273620
      );
  }
  .cover-photo {
    position: absolute;
    z-index: -2;
    inset: 0 0 0 auto;
    width: 68%;
    height: 100%;
  }
  .cover-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 53%;
  }
  .cover-intro {
    min-width: 0;
  }
  .cover-intro h1 {
    margin: 0;
    color: inherit;
    font-size: 1.75rem;
    letter-spacing: -0.045em;
    line-height: 1.08;
  }
  .cover-intro h1 span {
    color: #addfd9;
    white-space: nowrap;
  }
  .cover-intro p {
    max-width: 49ch;
    margin: 0.6rem 0 1.05rem;
    color: #e2eff1;
    font-size: clamp(0.92rem, 1.6vw, 1.12rem);
    line-height: 1.5;
  }
  .cover-search {
    max-width: 46rem;
  }
  .cover-search label {
    display: block;
    margin-bottom: 0.4rem;
    font-size: 0.9rem;
    font-weight: 660;
  }
  .cover-search > div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.3rem;
    padding: 0.25rem;
    border: 1px solid #adc7ce;
    border-radius: 0.75rem;
    background: #f8faf9;
  }
  .cover-search input,
  .cover-search button {
    min-height: 3rem;
    border-radius: 0.5rem;
    font-family: var(--sans);
  }
  .cover-search input {
    width: 100%;
    min-width: 0;
    border: 1px solid transparent;
    background: transparent;
    color: #172f3c;
    font-size: 0.98rem;
  }
  .cover-search input::placeholder {
    color: #50636e;
  }
  .cover-search input:focus-visible {
    outline: 2px solid #245c60;
    outline-offset: -2px;
  }
  .cover-search button {
    gap: 0.38rem;
    border-color: #23565b;
    background: #23565b;
    color: white;
  }
  .cover-search button:hover {
    background: #142f3e;
  }
  .cover-search button:focus-visible {
    outline-color: #23565b;
  }
  .cover-search button :global(.icon) {
    width: 1.05rem;
    height: 1.05rem;
    flex: none;
  }
  .cover-subjects {
    display: flex;
    flex-wrap: wrap;
    gap: 0.37rem;
    margin-top: 0.65rem;
  }
  .cover-subjects a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    border: 1px solid #a9d1dc68;
    border-radius: 50vw;
    padding: 0.12rem 0.65rem;
    background: #0f2637bb;
    color: #edf7f8;
    font-size: 0.83rem;
    text-decoration: none;
  }
  .cover-subjects a:hover {
    text-decoration: underline;
    background: #335969;
  }
  .cover-intro .cover-noscript {
    margin: 0.55rem 0 0;
    font-size: 0.86rem;
  }
  .cover-calendar {
    align-self: end;
    padding: 0.85rem clamp(0.85rem, 2vw, 1.4rem) 1rem;
    border: 1px solid #b9d8de80;
    border-radius: 0.85rem;
    background: #18333f;
  }
  .calendar-link {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    min-height: 2rem;
    color: #dbf4f2;
    font-size: 0.87rem;
    font-weight: 640;
  }
  .calendar-link :global(.icon) {
    width: 1rem;
    height: 1rem;
  }
  .cover-calendar dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.7rem;
    margin: 0.65rem 0 0;
  }
  .cover-calendar dt {
    color: #d0e2e7;
    font-size: 0.78rem;
    line-height: 1.3;
  }
  .cover-calendar dd {
    margin: 0.25rem 0 0;
    font-size: clamp(0.9rem, 1.4vw, 1.1rem);
    font-weight: 680;
    line-height: 1.25;
    font-variant-numeric: tabular-nums;
  }
  .cover-calendar dl > div + div {
    border-inline-start: 1px solid #b1d0d85c;
    padding-inline-start: 0.7rem;
  }
  .cover-credit {
    grid-column: 1 / -1;
    justify-self: end;
    padding: 0.16rem 0.4rem;
    border-radius: 0.25rem;
    background: #0e2432dd;
    color: #e3eef0;
    font-size: 0.75rem;
    text-underline-offset: 0.13em;
  }
  .cover-calendar a:focus-visible,
  .cover-credit:focus-visible,
  .cover-subjects a:focus-visible {
    outline-color: #ccefe8;
  }
  @media (max-width: 760px) {
    .election-cover {
      grid-template-columns: minmax(0, 1fr);
      min-height: 0;
      gap: 0.7rem;
      padding-top: 1.3rem;
    }
    .election-cover::before {
      background:
        linear-gradient(105deg, #132b3bf7, #142a39db 57%, #182f3dac),
        linear-gradient(0deg, #132b3b, transparent 50%);
    }
    .cover-photo {
      width: 100%;
    }
    .cover-photo img {
      object-position: 54% 45%;
    }
    .cover-calendar {
      padding-block: 0.35rem 0.6rem;
      background: #0e2838e6;
    }
    .cover-calendar dl {
      margin-top: 0.25rem;
    }
    .cover-intro p {
      margin-bottom: 0.9rem;
    }
  }
  @media (max-width: 420px) {
    .election-cover {
      padding-inline: 0.85rem;
      border-radius: 1rem;
    }
    .cover-search button {
      padding-inline: 0.65rem;
    }
    .cover-search button :global(.icon) {
      display: none;
    }
  }
</style>
