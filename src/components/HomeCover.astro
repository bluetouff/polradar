---
import Icon from './Icon.astro';
import {
  activeCandidates as candidates,
  electionRounds,
  measures,
  sources,
} from '../lib/data';
import smallCover from '../assets/edition/scrutin-480.webp?url';
import largeCover from '../assets/edition/scrutin-1200.webp?url';

const month = new Intl.DateTimeFormat('fr-FR', {
  month: 'long',
  year: 'numeric',
  timeZone: 'Europe/Paris',
});
const number = new Intl.NumberFormat('fr-FR', { useGrouping: 'always' });
const register = [
  {
    url: '/candidats/',
    icon: 'people',
    count: candidates.length,
    label: 'candidats suivis',
  },
  {
    url: '/mesures/',
    icon: 'mesures',
    count: measures.filter(({ scope }) => scope !== 'archive').length,
    label: 'fiches hors\u00a0archives',
  },
  { url: '/sources/', icon: 'source', count: sources.length, label: 'sources' },
];
---

<header class="election-cover">
  <div class="cover-title">
    <h1>Présidentielle 2027</h1>
  </div>
  <img
    class="cover-image"
    src={largeCover}
    srcset={`${smallCover} 480w, ${largeCover} 1200w`}
    sizes="(max-width: 620px) 47vw, (max-width: 960px) 48vw, 32rem"
    width="1200"
    height="800"
    fetchpriority="high"
    alt=""
  />
  <div class="cover-calendar">
    <a href="/reperes/" class="calendar-link">
      <Icon name="clock" /> Calendrier électoral
    </a>
    <dl>
      {electionRounds.map((event) => (
        <div>
          <dt>{event.title}</dt>
          <dd>
            <time datetime={event.date}>
              <span class="day">{Number(event.date.slice(8))}</span>{' '}
              <span>{month.format(new Date(event.date))}</span>
            </time>
          </dd>
        </div>
      ))}
    </dl>
  </div>
  <nav class="cover-register" aria-label="Accès rapides">
    {register.map(({ url, icon, count, label }) => (
      <a href={url}>
        <strong>{number.format(count)}</strong>
        <Icon name={icon} />
        <span>{label}</span>
      </a>
    ))}
  </nav>
</header>

<style>
  .election-cover {
    position: relative;
    container-type: inline-size;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.04fr);
    grid-template-areas: 'title art' 'calendar art' 'register register';
    grid-template-rows: auto 1fr auto;
    isolation: isolate;
    overflow: hidden;
    color: #f2f8fa;
    background:
      radial-gradient(ellipse at 51% 120%, #295360 0, transparent 63%),
      linear-gradient(115deg, #102431 0%, #163544 49%, #112632 78%);
    border: 1px solid #3d5967;
    border-radius: 0.85rem;
    box-shadow: 0 7px 22px #17344016;
    margin-bottom: clamp(1rem, 2vw, 1.6rem);
  }
  .cover-title {
    grid-area: title;
    padding: clamp(1.15rem, 2.8vw, 2.55rem) clamp(1rem, 2.8vw, 2.6rem) 0;
  }
  .cover-title h1 {
    color: #f1f7f9;
    font-size: clamp(1.5rem, 2.1vw, 1.75rem);
    font-weight: 620;
    letter-spacing: -0.038em;
    line-height: 1.12;
  }
  .cover-title p {
    max-width: 49ch;
    color: #c6d7de;
    font-size: 1rem;
    margin-top: 0.55rem;
    line-height: 1.45;
  }
  .cover-image {
    grid-area: art;
    position: absolute;
    inset: 0 0 0 auto;
    width: auto;
    max-width: 100%;
    height: 100%;
    aspect-ratio: 1.8;
    object-fit: cover;
    object-position: 56% 42%;
    mask-image: linear-gradient(90deg, transparent, #000 24%);
  }
  .cover-calendar {
    grid-area: calendar;
    align-self: end;
    margin: clamp(1.15rem, 2vw, 1.8rem) clamp(1rem, 2.8vw, 2.6rem)
      clamp(1rem, 2vw, 1.7rem);
    border-top: 1px solid #58727f;
  }
  .calendar-link {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    min-height: 2.6rem;
    color: #c1dfe5;
    font: 580 0.83rem var(--sans);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.19em;
  }
  .calendar-link :global(.icon) {
    width: 1rem;
    height: 1rem;
  }
  .cover-calendar dl {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: 0.15rem 0 0;
    gap: 0.65rem;
  }
  .cover-calendar dl > div + div {
    border-inline-start: 1px solid #516d79;
    padding-inline-start: clamp(0.7rem, 1.5vw, 1.6rem);
  }
  .cover-calendar dl > div {
    display: flex;
    flex-direction: column;
  }
  .cover-calendar dt {
    color: #d0e1e5;
    font-size: 0.82rem;
    line-height: 1.3;
    font-weight: 550;
  }
  .cover-calendar dd {
    margin: auto 0 0;
    padding-block-start: 0.32rem;
  }
  .cover-calendar time {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.12rem 0.5rem;
    color: #d5e3e8;
    font-size: 0.88rem;
  }
  .cover-calendar .day {
    color: #f5f9fa;
    font: 500 clamp(2.2rem, 3.65vw, 3.35rem)/1 var(--sans);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.055em;
  }
  .cover-register {
    grid-area: register;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid #496672;
    background: linear-gradient(112deg, #102633, #173944 72%, #193e46);
  }
  .cover-register a {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-rows: auto 1fr;
    align-items: baseline;
    min-width: 0;
    padding: 0.85rem clamp(0.65rem, 3.2cqi, 1.55rem) 0.95rem;
    gap: 0.36rem 0.3rem;
    color: #f1faf9;
    text-decoration: none;
  }
  .cover-register a + a::before {
    content: '';
    position: absolute;
    inset-block: 0.85rem;
    inset-inline-start: 0;
    border-inline-start: 1px solid #496773;
  }
  .cover-register :global(.icon) {
    align-self: center;
    width: 1rem;
    height: 1rem;
    color: #97cfcb;
  }
  .cover-register strong {
    font: 520 clamp(1.45rem, 5cqi, 2.05rem)/1 var(--sans);
    letter-spacing: -0.045em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .cover-register span {
    grid-column: 1 / -1;
    color: #d0e2e4;
    font: 500 0.82rem/1.28 var(--sans);
    text-wrap: balance;
  }
  .cover-register a:hover {
    background: #ffffff0d;
  }
  .cover-register a:hover span {
    text-decoration: underline;
  }
  .calendar-link:focus-visible {
    outline-color: var(--ice);
  }
  .cover-register a:focus-visible {
    outline: 2px solid #b3e6df;
    outline-offset: -3px;
  }
  @container (max-width: 28rem) {
    .cover-register {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr) minmax(0, 0.8fr);
    }
  }
  @container (max-width: 20rem) {
    .cover-register a {
      grid-template-columns: 1fr;
      padding-inline: 0.6rem;
    }
    .cover-register :global(.icon) {
      display: none;
    }
  }
  @container (max-width: 16rem) {
    .cover-register a {
      grid-column: 1 / -1;
      display: flex;
      align-items: baseline;
      gap: 0.75rem;
      padding: 0.55rem 0.7rem;
    }
    .cover-register a + a::before {
      content: none;
    }
  }
  @media (max-width: 620px) {
    .election-cover {
      grid-template-columns: minmax(0, 1.13fr) minmax(0, 1fr);
      grid-template-areas: 'title art' 'calendar calendar' 'register register';
    }
    .cover-title {
      align-self: center;
      padding: 1.08rem 0 1rem 0.82rem;
    }
    .cover-title p {
      font-size: 0.87rem;
    }
    .cover-image {
      width: 100%;
      object-position: 56% 42%;
    }
    .cover-calendar {
      margin: 0 0.82rem 0.9rem;
    }
  }
  @media print {
    .election-cover {
      background: white;
      border: 1px solid #536671;
      color: black;
      box-shadow: none;
      grid-template-columns: 1fr;
      grid-template-areas: 'title' 'calendar' 'register';
    }
    .cover-image {
      display: none;
    }
    .cover-title h1,
    .cover-title p,
    .cover-calendar dt,
    .cover-calendar time,
    .cover-calendar .day,
    .calendar-link,
    .cover-register a,
    .cover-register span {
      color: black;
    }
    .cover-register {
      background: white;
    }
  }
</style>
