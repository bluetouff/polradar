---
import Icon from './Icon.astro';
import { electionRounds } from '../lib/data';

const subjects = [
  ['retraites', 'Retraites'],
  ['travail', 'Travail et salaires'],
  ['sante', 'Santé'],
  ['logement', 'Logement'],
  ['education', 'Éducation'],
] as const;
const date = new Intl.DateTimeFormat('fr-FR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'Europe/Paris',
});
---

<header class="election-cover">
  <div class="cover-intro">
    <h1>Présidentielle 2027</h1>
    <p>
      Comparez les programmes, retrouvez les votes et vérifiez les chiffres de
      la campagne dans les documents d’origine.
    </p>
    <form
      action="/recherche/"
      class="cover-search"
      role="search"
      data-cover-search
    >
      <label for="cover-query">Rechercher dans Polradar</label>
      <div>
        <input
          id="cover-query"
          type="search"
          maxlength="200"
          placeholder="Ex. retraite à 64 ans"
          autocomplete="off"
        />
        <button class="button primary" type="submit">
          <Icon name="search" /> Rechercher
        </button>
      </div>
    </form>
    <nav class="cover-subjects" aria-label="Exemples de thèmes">
      {subjects.map(([id, label]) => (
        <a href={'/themes/' + id + '/'}>{label}</a>
      ))}
    </nav>
  </div>
  {electionRounds.length > 0 && (
    <div class="cover-calendar">
      <a href="/reperes/" class="calendar-link">
        <Icon name="clock" /> Calendrier électoral
      </a>
      <dl>
        {electionRounds.map((event) => (
          <div>
            <dt>{event.title}</dt>
            <dd>
              <time datetime={event.date}>
                {date.format(new Date(event.date))}
              </time>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  )}
</header>
<script>
  const form = document.querySelector<HTMLFormElement>('[data-cover-search]');
  form?.addEventListener('submit', (event) => {
    const input = form.querySelector<HTMLInputElement>('input');
    const query = input?.value.trim().slice(0, 200);
    if (!query) return;
    event.preventDefault();
    location.assign(form.action + '#' + new URLSearchParams({ q: query }));
  });
</script>
<style>
  .election-cover {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(15rem, 0.44fr);
    gap: clamp(1.65rem, 3vw, 3.25rem);
    align-items: center;
    padding-block: clamp(0.75rem, 2vw, 1.8rem) 1.15rem;
  }
  .cover-intro {
    min-width: 0;
  }
  .cover-intro h1 {
    margin: 0;
    font-size: clamp(1.55rem, 4vw, 1.75rem);
    line-height: 1.15;
  }
  .cover-intro p {
    max-width: 60ch;
    margin: 0.5rem 0 1.1rem;
    color: var(--muted);
  }
  .cover-search {
    max-width: 46rem;
  }
  .cover-search label {
    display: block;
    margin-bottom: 0.25rem;
    font-size: 0.9rem;
    font-weight: 660;
  }
  .cover-search > div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.45rem;
  }
  .cover-search input,
  .cover-search button {
    min-height: 3rem;
    font-family: var(--sans);
  }
  .cover-search input {
    width: 100%;
    font-size: 1rem;
    border-color: #80989a;
  }
  .cover-search button {
    gap: 0.38rem;
    background: var(--accent);
    color: white;
  }
  .cover-search button:hover {
    background: #194b4d;
  }
  .cover-search button :global(.icon) {
    width: 1.05rem;
    height: 1.05rem;
    flex: none;
  }
  .cover-subjects {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.5rem;
    margin-top: 0.35rem;
  }
  .cover-subjects a {
    display: inline-flex;
    align-items: center;
    min-height: 2.125rem;
    border-radius: 0.3rem;
    padding: 0.15rem 0.55rem;
    color: var(--accent);
    font-size: 0.83rem;
    text-decoration: none;
  }
  .cover-subjects a:hover {
    text-decoration: underline;
    background: var(--light);
  }
  .cover-calendar {
    padding: 0.95rem clamp(0.9rem, 2vw, 1.5rem) 1.05rem;
    border-inline-start: 3px solid var(--accent);
    background: linear-gradient(115deg, #e2ebe5, #f1f1e7);
  }
  .calendar-link {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    min-height: 2rem;
    color: var(--accent);
    font-size: 0.87rem;
    font-weight: 640;
  }
  .calendar-link :global(.icon) {
    width: 1rem;
    height: 1rem;
  }
  .cover-calendar dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.7rem;
    margin: 0.65rem 0 0;
  }
  .cover-calendar dt {
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.3;
  }
  .cover-calendar dd {
    margin: 0.25rem 0 0;
    font-size: clamp(0.9rem, 1.4vw, 1.1rem);
    font-weight: 650;
    line-height: 1.25;
    font-variant-numeric: tabular-nums;
  }
  .cover-calendar dl > div + div {
    border-inline-start: 1px solid #b4c4c0;
    padding-inline-start: 0.7rem;
  }
  @media (max-width: 690px) {
    .election-cover {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.85rem;
    }
    .cover-calendar {
      padding-block: 0.45rem 0.75rem;
    }
    .cover-calendar dl {
      margin-top: 0.25rem;
    }
  }
  @media (max-width: 420px) {
    .cover-search button :global(.icon) {
      display: none;
    }
  }
</style>
