---
interface Props {
  target: string;
  label?: string;
  placeholder?: string;
  total: number;
}
const {
  target,
  label = 'Rechercher',
  placeholder = 'Un mot-clé, un nom, un sujet…',
  total,
} = Astro.props;
---

<form class="filter-bar" id={target + '-filters'}>
  <label>
    {label}
    <input
      type="search"
      name="q"
      maxlength="200"
      placeholder={placeholder}
      autocomplete="off"
    />
  </label>
  <p id={target + '-count'} class="filter-count" role="status">
    {total} résultats
  </p>
</form>
