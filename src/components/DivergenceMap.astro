---
import { getImage } from 'astro:assets';
import {
  divergenceLayout,
  formatDivergenceValue,
  formatMetricValue,
} from '../lib/divergences.mjs';
import { initials, scopes } from '../lib/data';
import { portraitFor } from '../lib/portraits';
import SourceLinks from './SourceLinks.astro';
import Icon from './Icon.astro';
interface Props {
  group: ReturnType<
    typeof import('../lib/divergences.mjs').divergenceGroups
  >[number];
  related?: { id: string; label: string; total: number };
}
const { group, related } = Astro.props;
const layout = divergenceLayout(group.values, 720);
const faces = new Map(
  await Promise.all(
    group.values.map(async (row) => {
      const portrait = row.measure.partyAuthor
        ? null
        : portraitFor(row.candidate);
      return [
        row.measureId,
        portrait?.preserveOriginal
          ? portrait.image.src
          : portrait
            ? (
                await getImage({
                  src: portrait.image,
                  width: 112,
                  height: 112,
                  fit: 'cover',
                  position: 'north',
                  format: 'avif',
                  quality: 65,
                })
              ).src
            : null,
      ] as const;
    }),
  ),
);
const format = (value: number) => formatMetricValue(value);
const exact = (value: number) => formatDivergenceValue(value, group.unit);
---

<section
  class="divergence-panel"
  id={group.id}
  data-divergence-panel
  data-axis-label={group.label}
>
  <header class="divergence-panel-heading">
    <p>{group.themeLabel}</p>
    <h2>{group.label}</h2>
    <span>
      {group.values.length} candidats et partis · {group.unit}
    </span>
  </header>
  {related && (
    <a class="divergence-related" href={`#${related.id}`}>
      {related.label} · {related.total} candidats et partis{' '}
      <Icon name="arrow" />
    </a>
  )}
  <figure class="divergence-figure">
    <svg
      class="divergence-svg"
      width={layout.width}
      height={layout.height}
      viewBox={`0 0 ${layout.width} ${layout.height}`}
      role="img"
      aria-label={`${group.label} en ${group.unit}. ${group.values.map((row) => `${row.name} : ${exact(row.value)}`).join('. ')}`}
    >
      <g data-axis-ticks>
        {layout.ticks.map((tick, index) => (
          <g>
            <line
              x1={tick.x}
              x2={tick.x}
              y1={layout.axisY - 4}
              y2={layout.axisY + 5}
            />
            <text
              x={tick.x}
              y={layout.axisY + 25}
              text-anchor={
                index === 0
                  ? 'start'
                  : index === layout.ticks.length - 1
                    ? 'end'
                    : 'middle'
              }
            >
              {format(tick.value)}
            </text>
          </g>
        ))}
      </g>
      <line
        data-axis-line
        class="divergence-axis"
        x1="38"
        x2={layout.width - 38}
        y1={layout.axisY}
        y2={layout.axisY}
      />
      {group.values.map((row, index) => {
        const point = layout.points[index],
          face = faces.get(row.measureId);
        return (
          <g
            data-divergence-point
            data-candidate={
              row.measure.partyAuthor ? row.measureId : row.candidate
            }
            data-value={row.value}
          >
            <line
              data-leader
              x1={point.x}
              x2={point.x}
              y1={point.y + 54}
              y2={layout.axisY}
            />
            <a
              href={`/mesures/${row.measureId}/`}
              aria-label={`${row.name}, ${exact(row.value)} : lire la proposition`}
            >
              <title>{row.name} : {exact(row.value)}</title>
              <circle
                data-halo
                class="divergence-halo"
                cx={point.x}
                cy={point.y}
                r="29"
              />
              {face ? (
                <svg
                  data-face
                  x={point.x - 25}
                  y={point.y - 25}
                  width="50"
                  height="50"
                  viewBox="0 0 50 50"
                >
                  <defs>
                    <clipPath id={`face-${group.id}-${row.measureId}`}>
                      <circle cx="25" cy="25" r="25" />
                    </clipPath>
                  </defs>
                  <image
                    href={face}
                    width="50"
                    height="50"
                    clip-path={`url(#face-${group.id}-${row.measureId})`}
                  />
                </svg>
              ) : (
                <text
                  data-initials
                  x={point.x}
                  y={point.y + 4}
                  text-anchor="middle"
                >
                  {initials(row.name)}
                </text>
              )}
              <text
                data-point-value
                class="divergence-value"
                x={point.x}
                y={point.y + 46}
                text-anchor="middle"
              >
                {format(row.value)}
              </text>
            </a>
          </g>
        );
      })}
    </svg>
    <figcaption>
      Cibles annoncées en {group.unit}. Les modalités de chaque proposition
      figurent ci-dessous.
      {group.key === 'smic-mensuel-net' &&
        ' Cet axe compare les montants mensuels nets. Les annonces brutes ou sans base précisée figurent dans les dossiers.'}
    </figcaption>
  </figure>
  <div class="divergence-records">
    {group.values.map((row) => {
      const { measure } = row;
      return (
        <article
          class="divergence-record"
          data-focus-candidate={
            measure.partyAuthor ? row.measureId : row.candidate
          }
        >
          <header>
            <span class="divergence-record-name">{row.name}</span>
            <strong>
              {group.unit === 'ans' &&
              !Number.isInteger(row.value) &&
              Number.isInteger(row.value * 12) ? (
                exact(row.value)
              ) : (
                <>
                  {format(row.value)} <small>{group.unit}</small>
                </>
              )}
            </strong>
          </header>
          <p class="divergence-scope">
            {scopes[measure.scope]} · {measure.edition}
          </p>
          <h3>
            <a href={`/mesures/${measure.id}/`}>{measure.title} ↗</a>
          </h3>
          <p>{measure.description}</p>
          {measure.timing && (
            <p class="divergence-detail">
              <Icon name="clock" />
              <span>{measure.timing}</span>
            </p>
          )}
          <SourceLinks
            ids={[...new Set(measure.sourceRefs.map((ref) => ref.sourceId))]}
            compact
          />
        </article>
      );
    })}
  </div>
</section>
