---
import { collectiveLabel } from '../lib/attribution.mjs';
import { candidateById, themeById, scopes, type Engagement } from '../lib/data';
import Icon from './Icon.astro';
interface Props {
  item: Engagement;
}
const { item } = Astro.props;
const collective = collectiveLabel(item);
const candidate = candidateById(item.candidate);
---

<article class="engagement-card">
  <div class="card-meta">
    <a href={`/themes/${item.theme}/`}>
      <Icon name={item.theme} /> {themeById(item.theme).label}
    </a>
    <span class:list={['tag', { archive: item.scope === 'archive' }]}>
      {scopes[item.scope]}
    </span>
  </div>
  <h3>
    <a href={`/engagements/${item.id}/`}>{item.title}</a>
  </h3>
  <p>{item.bullets[0]}</p>
  <div class="engagement-author">
    {collective ? (
      <strong>{collective}</strong>
    ) : (
      <a href={`/candidats/${candidate.id}/`}>{candidate.name}</a>
    )}
    <a
      href={`/engagements/${item.id}/`}
      aria-label={`Lire la fiche ${item.title}`}
    >
      Lire la fiche ↗
    </a>
  </div>
</article>
