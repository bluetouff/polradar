---
import type { ParliamentaryBallot } from '../lib/parliamentary-register';
import { register, registerIndex } from '../lib/parliamentary-register';
import { choiceLabel, termLabel } from '../lib/parliamentary-labels';
import { formatDate } from '../lib/data';
interface Props {
  ballot: ParliamentaryBallot;
}
const { ballot: b } = Astro.props;
---

<article class="parl-card">
  <div class="parl-meta">
    <time datetime={b.date}>{formatDate(b.date)}</time> ·{' '}
    {termLabel(b.legislature)} législature · n° {b.numero}
  </div>
  <h2>{b.objet}</h2>
  <p class="parl-result">
    <strong>Texte {b.decision}</strong>
    {' · '}
    {b.totaux.pour} pour
    {b.totaux.contre !== null &&
      ` · ${b.totaux.contre} contre · ${b.totaux.abstention} abstentions`}
  </p>
  <ul class="parl-positions" aria-label="Positions nominatives">
    {b.positions.map((p) => (
      <li>
        <strong>{registerIndex.personnes[p.candidat].nom}</strong> ·{' '}
        {choiceLabel(p.vote)}
        {p.delegation && ' (par délégation)'}
        {p.groupe && <small>{register.groupes[p.groupe].nom}</small>}
        {p.misesAuPoint.map((m) => (
          <small>Mise au point · {choiceLabel(m.vote)}</small>
        ))}
      </li>
    ))}
  </ul>
  <a class="parl-source" href={b.source} rel="noreferrer">
    Scrutin officiel n° {b.numero} ↗
  </a>
</article>
