---
import { shareLinks } from '../lib/sharing.mjs';
import '../styles/sharing.css';
interface Props {
  title: string;
  canonical: URL;
}
const { title, canonical } = Astro.props;
const links = shareLinks(title, canonical);
---

<nav class="page-share" aria-label="Partager cette page">
  <span class="page-share-label">Partager</span>
  <span id="partage-onglet" hidden>
    Ouvre un nouvel onglet.
  </span>
  <ul>
    {links.map((link) => (
      <li>
        <a
          href={link.href}
          data-share-platform={link.id}
          target={link.id === 'mail' ? undefined : '_blank'}
          rel="noopener noreferrer"
          referrerpolicy="no-referrer"
          aria-describedby={link.id === 'mail' ? undefined : 'partage-onglet'}
        >
          {link.label}
        </a>
      </li>
    ))}
  </ul>
</nav>
