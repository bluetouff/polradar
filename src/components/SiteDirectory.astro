---
import Icon from './Icon.astro';
import {
  directoryProfessionals,
  directorySections,
} from '../lib/directory-navigation';
import { mobilePrimaryIcons, primaryNavigation } from '../lib/navigation';

const path = Astro.url.pathname;
const mobileSections = primaryNavigation.filter(
  ({ url }) => !mobilePrimaryIcons.has(url),
);
const categories = [
  { id: 'pro', shortLabel: 'Outils pro' },
  ...directorySections,
];
---

<details class="site-directory">
  <summary>
    <span class="directory-trigger-icon" aria-hidden="true">
      <Icon name="layers" />
    </span>
    <span>Explorer</span>
    <span class="directory-trigger-chevron" aria-hidden="true">
      <Icon name="chevron" />
    </span>
  </summary>
  <nav aria-label="Rubriques et outils">
    <ul class="directory-mobile" role="list" aria-label="Rubriques principales">
      {mobileSections.map(({ url, label }) => (
        <li>
          <a href={url} aria-current={path === url ? 'page' : undefined}>
            {label}
          </a>
        </li>
      ))}
    </ul>
    <fieldset class="directory-picker" aria-label="Familles de rubriques">
      {categories.map(({ id, shortLabel }) => (
        <label>
          <input
            type="radio"
            id={'explorer-' + id}
            name="explorer-section"
            value={id}
            checked={id === 'pro'}
            aria-controls={'explorer-panel-' + id}
          />
          <span>{shortLabel}</span>
        </label>
      ))}
    </fieldset>
    <div
      class="directory-tools"
      data-directory-group="pro"
      id="explorer-panel-pro"
    >
      <a class="directory-professional" href="/rubriques/#professionnels">
        Données et outils professionnels <Icon name="arrow" />
      </a>
      <ul role="list" aria-label="Accès professionnels">
        {directoryProfessionals.map(({ url, label }) => (
          <li>
            <a href={url} aria-current={path === url ? 'page' : undefined}>
              {label}
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div class="directory-destinations">
      {directorySections.map(({ id, label, icon, links }) => (
        <div data-directory-group={id} id={'explorer-panel-' + id}>
          <p id={'navigation-directory-' + id}>
            <span aria-hidden="true">
              <Icon name={icon} />
            </span>{' '}
            {label}
          </p>
          <ul role="list" aria-labelledby={'navigation-directory-' + id}>
            {links.map(({ url, label }) => (
              <li>
                <a href={url} aria-current={path === url ? 'page' : undefined}>
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <a class="directory-index" href="/rubriques/">
      Toutes les rubriques <Icon name="arrow" />
    </a>
  </nav>
</details>
