---
import Icon from './Icon.astro';
import { proposalTracks, financingMaps } from '../lib/proposal-data';
import { voteCases } from '../lib/votes-data';
import law from '../data/digital-law.json';
import { statements } from '../lib/economy-data';

const tools = [
  {
    title: 'Numérique et droit en vigueur',
    href: '/numerique/ce-qui-changerait/',
    icon: 'chiffrement',
    count: law.sections.reduce((sum, section) => sum + section.cases.length, 0),
    unit: 'situations',
  },
  {
    title: 'Déclarations et chiffres publics',
    href: '/economie/declarations/',
    icon: 'source',
    count: statements.length,
    unit: 'déclarations vérifiées',
  },
  {
    title: 'Évolution des propositions',
    href: '/evolution/',
    icon: 'historique',
    count: proposalTracks.length,
    unit: 'frises',
  },
  {
    title: 'Propositions et votes passés',
    href: '/votes/',
    icon: 'vote',
    count: voteCases.length,
    unit: 'dossiers',
  },
  {
    title: 'Carte des financements',
    href: '/financements/',
    icon: 'exchange',
    count: financingMaps.length,
    unit: 'cartes',
  },
];
---

<section class="home-comparison-index" aria-labelledby="home-comparison-title">
  <h2 id="home-comparison-title">Comparer et vérifier</h2>
  <div>
    {tools.map((tool) => (
      <a href={tool.href}>
        <Icon name={tool.icon} />
        <span>
          <strong>{tool.title}</strong>
          <small>
            {tool.count} {tool.unit}
          </small>
        </span>
        <Icon name="arrow" />
      </a>
    ))}
  </div>
</section>

<style>
  .home-comparison-index h2 {
    margin: 0 0 0.65rem;
    font-size: 1.2rem;
  }
  .home-comparison-index > div {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: 0.58rem;
  }
  .home-comparison-index a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-content: start;
    row-gap: 0.6rem;
    padding: 0.9rem;
    background: #e0d3f2;
    border: 1px solid #81718d;
    border-top: 3px solid var(--press);
    color: var(--press);
    text-decoration: none;
    line-height: 1.27;
  }
  .home-comparison-index a:nth-child(2n) {
    background: #f1d6bd;
  }
  .home-comparison-index a:hover strong {
    text-decoration: underline;
  }
  .home-comparison-index .icon {
    width: 1.5rem;
    height: 1.5rem;
  }
  .home-comparison-index .icon:last-child {
    grid-area: 1/2;
    width: 1rem;
    height: 1rem;
  }
  .home-comparison-index a > span {
    grid-column: 1/-1;
  }
  .home-comparison-index small {
    display: block;
    margin-top: 0.35rem;
    color: var(--muted);
    font: 0.77rem var(--mono);
  }
  @media (max-width: 620px) {
    .home-comparison-index > div {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .home-comparison-index a:last-child {
      grid-column: 1/-1;
    }
  }
</style>
