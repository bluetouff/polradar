---
import reviews from '../data/editorial-reviews.json';
import HostedEditorial from './HostedEditorial.astro';
import {
  collectionClock,
  formatCollectionTime,
} from '../lib/collection-clock.mjs';
import {
  candidates,
  sources,
  formatTimestamp,
  candidateById,
  sourceById,
  meta,
} from '../lib/data';
import {
  editorialSections,
  editorialReviewSchema,
} from '../lib/editorial-reviews.mjs';
const reports = editorialReviewSchema(candidates, sources)
  .parse(reviews)
  .sort((a, b) => Date.parse(b.checkedAt) - Date.parse(a.checkedAt));
const sections = Object.entries(editorialSections);
const labels = {
  consulte: 'Sources consultées',
  partiel: 'Recherche partielle',
  indisponible: 'Source indisponible',
};
const controls = [
  { label: 'Revue éditoriale complète', cadence: 'editorial' },
  { label: 'Annonces prioritaires du matin', cadence: 'annonces' },
].map((control) => {
  const scope = control.cadence === 'annonces' ? 'annonces' : undefined;
  const matching = reports.filter(
    (item) => item.hosted && item.scope === scope,
  );
  const attempt = matching[0]?.checkedAt ?? null;
  const success =
    matching.find(
      ({ hosted }) =>
        !!hosted?.checks.length &&
        hosted.checks.every((check) => check.ok && !check.issues?.length) &&
        hosted.queries.every((query) => query.count !== null),
    )?.checkedAt ?? null;
  return {
    ...control,
    attempt,
    success,
    timing: collectionClock(control.cadence, attempt, success),
  };
});
---

<section class="editorial-reviews" aria-labelledby="revue-editoriale">
  <h2 id="revue-editoriale">Recherche éditoriale</h2>
  <p>
    GitHub Actions recherche chaque jour les publications des candidats, des
    partis et des institutions. Les annonces officielles sont relevées à 8 h et
    à 18 h, heure de Paris. La recherche par candidat et par rubrique a lieu à
    18 h.
  </p>
  {reports.length === 0 && <p>Aucune revue publiée.</p>}
  <div class="editorial-freshness">
    {controls.map(({ label, cadence, attempt, success, timing }) => (
      <div
        class="editorial-clock"
        data-cadence={cadence}
        data-attempted={attempt}
        data-succeeded={success}
      >
        <h3>{label}</h3>
        <p
          class="editorial-alert"
          data-missed-attempt
          hidden={!timing.missedAttempt}
        >
          Collecte en retard
        </p>
        <p
          class="editorial-alert"
          data-missed-success
          hidden={timing.missedAttempt || !timing.missedSuccess}
        >
          Aucun succès depuis l’échéance
        </p>
        <dl>
          <div>
            <dt>Dernière tentative</dt>
            <dd>
              {attempt ? (
                <time datetime={attempt}>{formatCollectionTime(attempt)}</time>
              ) : (
                'Aucune consignée'
              )}
            </dd>
          </div>
          <div>
            <dt>Dernier succès</dt>
            <dd>
              {success ? (
                <time datetime={success}>{formatCollectionTime(success)}</time>
              ) : (
                'Aucun consigné'
              )}
            </dd>
          </div>
          <div>
            <dt>Prochain passage prévu</dt>
            <dd>
              <time data-next-passage datetime={timing.next}>
                {formatCollectionTime(timing.next)}
              </time>
            </dd>
          </div>
        </dl>
      </div>
    ))}
  </div>
  {reports.slice(0, 7).map((report, index) => (
    <details class="edition-review" open={index === 0}>
      <summary>
        <time
          id={index === 0 ? 'last-editorial-review' : undefined}
          datetime={report.checkedAt}
        >
          {formatTimestamp(report.checkedAt)} · Paris
        </time>
      </summary>
      {report.hosted && (
        <HostedEditorial
          hosted={report.hosted}
          priority={report.scope === 'annonces'}
        />
      )}
      {report.manualCheckedAt && (
        <p>
          Revue rédigée le {formatTimestamp(report.manualCheckedAt)} · heure de
          Paris
        </p>
      )}
      {report.collection && (
        <a
          href={
            meta.repository +
            '/actions/runs/' +
            report.collection.run +
            '/attempts/' +
            report.collection.attempt
          }
        >
          Collecte automatique consultée ↗
        </a>
      )}
      {report.scope !== 'annonces' && (
        <details class="review-candidates">
          <summary>
            {report.candidates.length} candidatures recherchées par nom
          </summary>
          <p>
            {report.candidates
              .map((id) => candidateById(id).name)
              .sort((a, b) => a.localeCompare(b, 'fr'))
              .join(', ') || 'Aucune recherche nominative consignée.'}
          </p>
        </details>
      )}
      <div class="review-grid">
        {sections
          .filter(
            ([id]) =>
              report.scope !== 'annonces' ||
              report.sections.some((s) => s.id === id),
          )
          .map(([id, label]) => {
            const row = report.sections.find((s) => s.id === id);
            return (
              <article>
                <h3>{label}</h3>
                {row ? (
                  <>
                    <small>
                      {labels[row.status]}
                      {row.changes.length
                        ? ' · Mise à jour publiée'
                        : row.status === 'consulte'
                          ? ' · Aucun ajout éditorial'
                          : ''}
                    </small>
                    <p>{row.note}</p>
                    {row.changes.length > 0 && (
                      <ul>
                        {row.changes.map((change) => (
                          <li>
                            <a href={change.path}>{change.title}</a>
                          </li>
                        ))}
                      </ul>
                    )}
                    <details>
                      <summary>Références ({row.sources.length})</summary>
                      <ul>
                        {row.sources.map((id) => {
                          const s = sourceById(id);
                          return (
                            <li>
                              <a href={s.url}>{s.title}</a>
                            </li>
                          );
                        })}
                      </ul>
                    </details>
                  </>
                ) : (
                  <small>Recherche non documentée pour ce passage</small>
                )}
              </article>
            );
          })}
      </div>
    </details>
  ))}
  {reports.length > 7 && (
    <a href={meta.repository + '/commits/main/src/data/editorial-reviews.json'}>
      Historique des revues sur GitHub ↗
    </a>
  )}
</section>
<style>
  .editorial-reviews {
    margin-block: 1.5rem;
  }
  .editorial-reviews > h2,
  .review-grid h3 {
    margin: 0;
  }
  .editorial-reviews > p {
    margin: 0.35rem 0 0.85rem;
  }
  .edition-review {
    background: var(--panel-gradient);
    border: 1px solid var(--line);
    border-radius: 0.65rem;
    padding: 0.75rem 1rem;
    margin-block: 0.6rem;
  }
  .edition-review summary {
    cursor: pointer;
    padding-block: 0.45rem;
  }
  .edition-review > summary {
    font-weight: 650;
  }
  .review-candidates p {
    max-width: 88ch;
    font-size: 0.87rem;
  }
  .review-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: 0.85rem;
    margin-top: 0.75rem;
  }
  .review-grid article {
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: 0.55rem;
    background: var(--paper);
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .review-grid h3 {
    font-size: 1rem;
  }
  .review-grid p,
  .review-grid li,
  .review-grid summary {
    font-size: 0.88rem;
    line-height: 1.5;
  }
  .review-grid small {
    color: var(--muted);
  }
  .review-grid p,
  .review-grid ul,
  .review-candidates p {
    margin-block: 0.45rem;
  }
  .review-grid ul {
    padding-inline-start: 1.15rem;
  }
  .editorial-freshness {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: 0.65rem;
  }
  .editorial-clock {
    padding: 0.75rem 1rem;
    border: 1px solid var(--line);
    border-radius: 0.55rem;
    background: var(--paper);
  }
  .editorial-clock h3 {
    margin: 0;
    font-size: 1rem;
  }
  .editorial-clock dl {
    font-size: 0.85rem;
    margin: 0.45rem 0 0;
  }
  .editorial-clock dl > div {
    display: grid;
    grid-template-columns: 1fr 1.06fr;
    gap: 0.5rem;
    padding: 0.22rem 0;
  }
  .editorial-clock dd {
    margin: 0;
  }
  .editorial-alert {
    color: #703c1e;
    margin: 0.42rem 0 0;
    font-size: 0.85rem;
  }
</style>
