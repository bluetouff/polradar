---
import type { CampaignBrief } from '../lib/briefs';
import { formatDate } from '../lib/data';
import Icon from './Icon.astro';
interface Props {
  items: CampaignBrief[];
  lead?: boolean;
}
const { items, lead = false } = Astro.props;
const labels: Record<string, string> = {
  candidature: 'Candidatures',
  programme: 'Programmes',
  meeting: 'Réunions publiques',
  calendrier: 'Calendrier',
  justice: 'Justice',
  sondage: 'Sondages',
};
const icons: Record<string, string> = {
  candidature: 'people',
  programme: 'mesures',
  meeting: 'map-pin',
  calendrier: 'clock',
  justice: 'securite',
  sondage: 'sondages',
};
---

<ul
  class:list={['brief-cards', { 'brief-led': lead && items.length === 3 }]}
  role="list"
>
  {items.map(({ article, event, href }) => (
    <li>
      <a href={href}>
        <span class="brief-meta">
          <span class="brief-kind">
            <Icon name={icons[event.category]} />
            {labels[event.category]}
          </span>
          <time
            datetime={article.data.published}
            aria-label={'Publié le ' + formatDate(article.data.published)}
          >
            {formatDate(article.data.published)}
          </time>
        </span>
        <strong>{article.data.title}</strong>
        <span class="brief-summary">{article.data.description}</span>
        <Icon name="arrow" class="brief-arrow" />
      </a>
    </li>
  ))}
</ul>
<style>
  .brief-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 0.85rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .brief-cards li {
    min-width: 0;
  }
  .brief-led li:not(:first-child) a {
    padding-inline: 0;
    border: 0;
    border-block-end: 1px solid var(--line);
    border-radius: 0;
    background: transparent;
  }
  .brief-led li:first-child a {
    border: 0;
    border-inline-start: 3px solid var(--accent);
    border-radius: 0;
    align-content: center;
    background: linear-gradient(120deg, #e5ede7, #f1efe4);
  }
  @media (min-width: 760px) {
    .brief-led {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: 0 1.5rem;
    }
    .brief-led li:first-child {
      grid-row: span 2;
    }
    .brief-led li:first-child strong {
      font-size: 1.3rem;
    }
  }
  @media (max-width: 759px) {
    .brief-led {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.25rem;
    }
  }
  .brief-cards a {
    display: grid;
    height: 100%;
    box-sizing: border-box;
    align-content: start;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.65rem;
    padding: clamp(1rem, 2vw, 1.35rem);
    border: 1px solid var(--line);
    border-radius: 0.7rem;
    background: var(--panel-gradient);
    color: var(--ink);
    text-decoration: none;
  }
  .brief-meta,
  .brief-summary {
    grid-column: 1 / -1;
    color: var(--muted);
  }
  .brief-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.35rem 0.7rem;
    font: 0.81rem/1.5 var(--sans);
    font-variant-numeric: tabular-nums;
  }
  .brief-kind {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 620;
    color: #235765;
  }
  .brief-kind :global(.icon) {
    width: 1.05rem;
    height: 1.05rem;
  }
  .brief-cards strong {
    font-size: 1.12rem;
    line-height: 1.28;
    letter-spacing: -0.015em;
  }
  .brief-summary {
    font-size: 0.93rem;
    line-height: 1.5;
  }
  .brief-cards :global(.brief-arrow) {
    grid-column: 2;
    grid-row: 2;
    width: 1rem;
    color: var(--accent);
  }
  .brief-cards a:hover strong,
  .brief-cards a:focus-visible strong {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
</style>
