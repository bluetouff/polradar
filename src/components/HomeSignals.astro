---
import Icon from './Icon.astro';
import EconomyCurve from './EconomyCurve.astro';
import { economy } from '../lib/economy-data';
import { labelPeriod, printedNumber } from '../lib/economy.mjs';
import '../styles/economy.css';

const indicators = ['inflation', 'chomage', 'croissance', 'dette-publique'].map(
  (id) => economy.find((series) => series.id === id)!,
);
const unitLabels: Record<string, string> = {
  RCH_A: '% sur un an',
  PC_ACT: '% des actifs',
  CLV_PCH_PRE: '% sur un trimestre',
};
const flags: Record<string, string> = { p: 'provisoire', e: 'estimation' };
---

<section
  class="economy home-economic-signals"
  aria-labelledby="home-economy-title"
>
  <div class="economy-group">
    <header class="home-signals-header">
      <h2 id="home-economy-title">
        <Icon name="markets" /> Indicateurs économiques
      </h2>
      <a href="/economie/">France · Eurostat ↗</a>
    </header>
    <div class="economy-grid-cards">
      {indicators.map((series) => (
        <article class="economy-card">
          <h3>
            <a href={`/economie/${series.id}/`}>
              {series.title}
              <Icon name="arrow" />
            </a>
          </h3>
          <div class="economy-reading">
            <strong>{printedNumber(series.latest[1]!)}</strong>{' '}
            <span>{unitLabels[series.filters.unit] ?? series.unit}</span>
          </div>
          <p>
            {labelPeriod(series.latest[0])}
            {series.latest[2] &&
              ` · ${flags[series.latest[2]] ?? 'statut Eurostat ' + series.latest[2]}`}
          </p>
          <EconomyCurve
            title={series.title}
            frequency={series.frequency}
            points={series.observations.slice(
              -(series.frequency === 'M' ? 24 : 16),
            )}
            compact
            showScale
          />
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .home-economic-signals .economy-group {
    --economy-board: #133240;
    --economy-grid: #49616d;
    padding: clamp(0.85rem, 1.45vw, 1.3rem);
    border: 1px solid #375a67;
    border-radius: 0.8rem;
    background: linear-gradient(115deg, #0e2734, #163947 64%, #204954);
    color: #edf6f7;
  }
  .home-signals-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.4rem 0.7rem;
    padding-bottom: 0.65rem;
    border-bottom: 1px solid #577480;
  }
  .home-signals-header h2 {
    margin: 0;
    color: #f1f7f8;
    font-size: 1.15rem;
  }
  .home-signals-header a {
    color: #c3e6e4;
    font-size: 0.85rem;
  }
  .home-economic-signals .economy-grid-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
  }
  .home-economic-signals .economy-card {
    --economy-line: #9be2df;
    background: transparent;
    border: 0;
    border-radius: 0;
    padding: 0.8rem 0.8rem 0.55rem 0;
  }
  .home-economic-signals .economy-card:nth-child(even) {
    border-inline-start: 1px solid #466570;
    padding-inline: 0.8rem 0;
  }
  .home-economic-signals .economy-card:nth-child(n + 3) {
    border-top: 1px solid #466570;
  }
  .home-economic-signals .economy-card:nth-child(2) {
    --economy-line: #bdd4f0;
  }
  .home-economic-signals .economy-card:nth-child(3) {
    --economy-line: #efb48b;
  }
  .home-economic-signals .economy-card:nth-child(4) {
    --economy-line: #d7cb9b;
  }
  .home-economic-signals h3 a {
    color: #edf6f7;
    font-size: 0.96rem;
    text-decoration: none;
  }
  .home-economic-signals h3 a:is(:hover, :focus-visible) {
    text-decoration: underline;
  }
  .home-economic-signals a:focus-visible {
    outline-color: #b9ebe4;
  }
  .home-economic-signals .economy-reading strong {
    font: 600 clamp(1.55rem, 2.2vw, 2.05rem)/1.15 var(--sans);
    font-variant-numeric: tabular-nums;
  }
  .home-economic-signals .economy-reading span {
    font: 550 0.85rem/1.25 var(--sans);
  }
  .home-economic-signals .economy-card p,
  .home-economic-signals :global(figcaption) {
    color: #d1e1e4;
  }
  .home-economic-signals :global(.economy-curve-detail) {
    margin: 0.3rem 0;
    column-gap: 0.3rem;
  }
  .home-economic-signals :global(.economy-scale) {
    color: #c3d8df;
    font: 500 0.73rem/1 var(--sans);
    padding: 0.1rem 0;
  }
  .home-economic-signals :global(.economy-curve svg) {
    width: 100%;
    height: auto;
  }
  .home-economic-signals :global(figcaption) {
    font: 500 0.72rem/1.3 var(--sans);
    flex-wrap: wrap;
  }
  @media (max-width: 400px) {
    .home-economic-signals h3 a {
      font-size: 0.87rem;
    }
    .home-signals-header h2 {
      font-size: 1.04rem;
    }
  }
  @media print {
    .home-economic-signals .economy-group {
      background: white;
      color: black;
    }
    .home-economic-signals
      :is(h2, h3 a, p, .economy-reading, .home-signals-header a) {
      color: black;
    }
  }
</style>
