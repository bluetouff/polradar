---
import Icon from './Icon.astro';
import EconomyCurve from './EconomyCurve.astro';
import { economy } from '../lib/economy-data';
import { labelPeriod, printedNumber } from '../lib/economy.mjs';
import '../styles/economy.css';

const indicators = ['inflation', 'chomage', 'croissance', 'dette-publique'].map(
  (id) => economy.find((series) => series.id === id)!,
);
---

<section
  class="economy home-economic-signals"
  aria-labelledby="home-economy-title"
>
  <div class="economy-group">
    <header class="home-signals-header">
      <h2 id="home-economy-title">
        <Icon name="markets" /> Indicateurs économiques
      </h2>
      <a href="/economie/">Les {economy.length} séries Eurostat ↗</a>
    </header>
    <div class="economy-grid-cards">
      {indicators.map((series) => (
        <article class="economy-card">
          <h3>
            <a href={`/economie/${series.id}/`}>
              {series.title}
              <Icon name="arrow" />
            </a>
          </h3>
          <div class="economy-reading">
            <strong>{printedNumber(series.latest[1]!)}</strong>{' '}
            <span>{series.unit}</span>
          </div>
          <p>
            {labelPeriod(series.latest[0])}
            {series.latest[2] &&
              ` · ${series.latest[2] === 'p' ? 'provisoire' : series.latest[2]}`}
          </p>
          <EconomyCurve
            title={series.title}
            frequency={series.frequency}
            points={series.observations.slice(
              -(series.frequency === 'M' ? 24 : 16),
            )}
            compact
          />
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .home-economic-signals .economy-group {
    --economy-board: #eef4f5;
    --economy-grid: #b7c8ce;
    background: var(--panel-gradient, #eef4f5);
    color: var(--ink);
    border: 1px solid #b0c4cc;
    border-radius: 0.75rem;
    padding: clamp(0.9rem, 1.7vw, 1.5rem);
  }
  .home-signals-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.4rem 1rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid #b0c4cc;
  }
  .home-signals-header h2 {
    margin: 0;
    color: var(--ink);
    font-size: 1.2rem;
  }
  .home-signals-header a {
    color: var(--accent);
    font-size: 0.88rem;
  }
  .economy-grid-cards {
    gap: 0;
    margin-top: 0.8rem;
  }
  .home-economic-signals .economy-card {
    --economy-line: #226477;
    padding: 0.3rem 0.85rem;
    border: 0;
    border-left: 1px solid #c2d1d7;
    border-radius: 0;
    background: transparent;
  }
  .home-economic-signals .economy-card:first-child {
    border-left: 0;
  }
  .home-economic-signals .economy-card:nth-child(2) {
    --economy-line: #405f82;
  }
  .home-economic-signals .economy-card:nth-child(3) {
    --economy-line: #865a49;
  }
  .home-economic-signals .economy-card:nth-child(4) {
    --economy-line: #38675c;
  }
  .home-economic-signals .economy-card h3 {
    color: var(--ink);
  }
  .home-economic-signals .economy-card p,
  .home-economic-signals :global(.economy-curve figcaption) {
    color: var(--muted);
  }
  .home-economic-signals :global(.economy-zero) {
    stroke: #718995;
  }
  .economy-card h3 a {
    text-decoration: none;
  }
  .economy-card h3 a:hover {
    text-decoration: underline;
  }
  .economy-reading strong {
    font: 640 clamp(1.45rem, 2.65vw, 2.1rem)/1.18 var(--sans);
    font-variant-numeric: tabular-nums;
  }
  .home-economic-signals :global(.economy-curve figcaption) {
    font-size: 0.7rem;
  }
  @media (max-width: 950px) {
    .home-economic-signals .economy-grid-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 0.8rem;
    }
    .home-economic-signals .economy-card:nth-child(odd) {
      border-left: 0;
    }
  }
  @media (max-width: 420px) {
    .home-economic-signals .economy-card {
      padding-inline: 0.45rem;
    }
    .home-economic-signals :global(.economy-curve figcaption) {
      flex-wrap: wrap;
    }
  }
</style>
