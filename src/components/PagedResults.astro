---
import Pager from './Pager.astro';
import { pageRange } from '../lib/pagination';
import '../styles/pagination.css';
interface Props {
  total: number;
  page?: number;
  base?: string;
  hidden?: boolean;
}
const { total, page = 1, base, hidden = false } = Astro.props;
const range = pageRange(total, page);
---

<div
  hidden={hidden}
  id="resultats"
  tabindex="-1"
  data-paged-results
  data-base={base}
  data-initial-page={range.page}
  data-total={total}
>
  <Pager range={range} base={base} />
  <slot />
  <Pager range={range} base={base} />
</div>
