---
import { chartGeometry } from '../lib/features.mjs';
import type { Poll } from '../lib/data';
interface Props {
  rows: Poll[];
  selected: string[];
}
const { rows, selected } = Astro.props;
const geometries = [
  chartGeometry(rows, selected, 760),
  chartGeometry(rows, selected, 320),
];
const shortDate = (value: string) =>
  new Intl.DateTimeFormat('fr-FR', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
    timeZone: 'Europe/Paris',
  }).format(new Date(value + 'T12:00:00Z'));
---

{geometries.map((geometry, index) => (
  <svg
    class:list={['poll-chart', index === 0 ? 'chart-wide' : 'chart-narrow']}
    viewBox={`0 0 ${geometry.width} 320`}
    role="img"
    aria-label="Évolution des intentions de vote, en pourcentage des intentions exprimées, selon le scénario sélectionné"
  >
    <text x={geometry.left} y="24" class="chart-unit">
      % des intentions exprimées
    </text>
    {geometry.ticks.map((tick) => (
      <g>
        <line
          class="chart-grid"
          x1={geometry.left}
          x2={geometry.right}
          y1={tick.y}
          y2={tick.y}
        />
        <text
          class="chart-tick"
          x={geometry.left - 12}
          y={tick.y + 4}
          text-anchor="end"
        >
          {tick.value.toLocaleString('fr-FR')}
        </text>
      </g>
    ))}
    {geometry.dates.map((tick) => (
      <g>
        <line class="chart-guide" x1={tick.x} x2={tick.x} y1="48" y2="258" />
        <text
          class="chart-tick chart-date"
          x={tick.x}
          y="292"
          text-anchor={
            tick.index === 0
              ? 'start'
              : tick.index === rows.length - 1
                ? 'end'
                : 'middle'
          }
        >
          {shortDate(tick.date)}
        </text>
      </g>
    ))}
    {geometry.lines.map((line) => (
      <g class={`plot-series series-${line.color}`}>
        <path class="plot-line" d={line.path} />
      </g>
    ))}
  </svg>
))}
