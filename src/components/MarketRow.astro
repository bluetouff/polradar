---
import { marketMidpoint, marketPercent } from '../lib/markets.mjs';
import type { MarketContract } from '../lib/market-data';
import { formatTimestamp } from '../lib/data';
interface Props {
  row: MarketContract;
  volumeUnit: string;
}
const { row, volumeUnit } = Astro.props;
const value = marketMidpoint(row);
const x = (number: number) => 6 + number * 588;
---

<li class="market-row" data-market-name={row.label}>
  <div class="market-row-quote">
    <strong>{row.label}</strong>
    <span
      class:list={['market-price', { 'market-price-missing': value === null }]}
    >
      {marketPercent(value)}
    </span>
  </div>
  <details class="market-contract">
    <summary>
      <span>Détail du contrat</span>
      {value !== null && (
        <span class="market-book">
          Achat {marketPercent(row.bid)} · Vente {marketPercent(row.ask)}
        </span>
      )}
    </summary>
    <p class="market-question" lang="en">
      {row.question}
    </p>
    {value !== null && row.bid !== null && row.ask !== null && (
      <div class="market-contract-graph">
        <svg
          class="market-range"
          viewBox="0 0 600 24"
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          <line class="market-track" x1="6" x2="594" y1="12" y2="12" />
          {[0.25, 0.5, 0.75].map((tick) => (
            <line
              class="market-tick"
              x1={x(tick)}
              x2={x(tick)}
              y1="5"
              y2="19"
            />
          ))}
          <line
            class="market-range-fill"
            x1="6"
            x2={x(value)}
            y1="12"
            y2="12"
          />
          <line
            class="market-spread"
            x1={x(row.bid)}
            x2={x(row.ask)}
            y1="12"
            y2="12"
          />
          <line
            class="market-point"
            x1={x(value)}
            x2={x(value)}
            y1="4"
            y2="20"
          />
        </svg>
        <div class="market-range-labels" aria-hidden="true">
          <span>0 %</span>
          <span>50 %</span>
          <span>100 %</span>
        </div>
      </div>
    )}
    <dl>
      <div>
        <dt>Écart achat / vente</dt>
        <dd>
          {row.bid !== null && row.ask !== null
            ? `${((row.ask - row.bid) * 100).toLocaleString('fr-FR', { maximumFractionDigits: 3 })} point(s)`
            : 'Indisponible'}
        </dd>
      </div>
      <div>
        <dt>Volume cumulé du contrat</dt>
        <dd>
          {row.volume === null
            ? 'Non fourni'
            : `${row.volume.toLocaleString('fr-FR', { maximumFractionDigits: 2 })} ${volumeUnit === 'dollars' ? '$' : 'contrats'}`}
        </dd>
      </div>
      <div>
        <dt>Dernier prix communiqué</dt>
        <dd>
          {marketPercent(row.lastPrice)} · horodatage de transaction non fourni
          par ce flux
        </dd>
      </div>
      <div>
        <dt>Fiche du contrat</dt>
        <dd>
          {row.updatedAt ? (
            <time datetime={row.updatedAt}>
              {formatTimestamp(row.updatedAt)} (Paris)
            </time>
          ) : (
            'Date inconnue'
          )}
        </dd>
      </div>
    </dl>
    {row.rules && (
      <p class="market-rules" lang="en">
        {row.rules}
      </p>
    )}
    <p class="small muted">
      Identifiant : <code>{row.id}</code>
    </p>
  </details>
</li>
