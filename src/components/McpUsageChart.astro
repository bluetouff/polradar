    grid-template-columns: minmax(0, 1fr) auto auto;
    gap: 0.4rem 0.6rem;
    margin: 0;
    padding: 0.7rem 0;
    font-size: 0.91rem;
  }
  .mcp-tools summary {
    cursor: pointer;
    list-style: none;
  }
  .mcp-tools summary::-webkit-details-marker {
    display: none;
  }
  .mcp-tools summary::after {
    content: '';
    width: 0.42rem;
    height: 0.42rem;
    border: solid var(--muted);
    border-width: 0 1.5px 1.5px 0;
    transform: translateY(-0.18em) rotate(45deg);
    grid-column: 3;
    grid-row: 1;
  }
  .mcp-tools details[open] summary::after {
    transform: rotate(225deg);
  }
  .mcp-tools strong {
    font-variant-numeric: tabular-nums;
  }
  .mcp-tools summary svg {
    width: 100%;
    height: 0.28rem;
    grid-column: 1 / -1;
    border-radius: 0.3rem;
    background: #d4e1e3;
    fill: #287580;
    display: block;
  }
  .mcp-tools dl {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1rem;
    margin: 0 0 0.8rem;
  }
  .mcp-tools dt,
  .mcp-tools small {
    color: var(--muted);
    font-size: 0.74rem;
  }
  .mcp-tools dd {
    margin: 0;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .mcp-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
  @media (max-width: 52rem) {
    .mcp-usage-panels {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (forced-colors: active) {
    .mcp-plot line {
      stroke: GrayText;
    }
    .mcp-plot rect,
    .mcp-tools rect {
      fill: CanvasText;
    }
  }
</style>
