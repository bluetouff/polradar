---
import { iconPaths } from '../lib/icons.mjs';
interface Props {
  name: string;
  class?: string;
  title?: string;
}
const { name, class: className = '', title } = Astro.props;
const path = iconPaths[name as keyof typeof iconPaths] || iconPaths.source;
---

<svg
  class:list={['icon', className]}
  viewBox="0 0 24 24"
  aria-hidden={title ? undefined : 'true'}
  role={title ? 'img' : undefined}
  aria-label={title}
>
  <path d={path} />
</svg>
