---
import { iconPaths } from '../lib/icons.mjs';
interface Props {
  name: string;
  class?: string;
  title?: string;
}
const { name, class: className = '', title } = Astro.props;
const id = Object.hasOwn(iconPaths, name) ? name : 'source';
---

{title ? (
  <svg
    class:list={['icon', className]}
    viewBox="0 0 24 24"
    role="img"
    aria-label={title}
  >
    <use href={`/icones.svg#${id}`} />
  </svg>
) : (
  <i class:list={['icon', 'i-' + id, className]}></i>
)}
