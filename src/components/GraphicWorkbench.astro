---
import Icon from './Icon.astro';
interface Mode {
  id: string;
  title: string;
  description: string;
  preview: string;
  width: number;
  height: number;
  alt: string;
  code: string;
  download?: { href: string; filename: string };
}
interface Props {
  modes: Mode[];
  intro: string;
  expanded?: boolean;
  selected?: number;
}
const { modes, intro, expanded = false, selected = 0 } = Astro.props;
---

<details class="retirement-embed" id="integrer" open={expanded}>
  <summary>
    <Icon name="source" />
    <strong>Intégrer ce graphique</strong>
    <span>HTML</span>
  </summary>
  <div class="embed-workbench">
    <div class="embed-preview">
      {modes.map((mode, index) => (
        <div class={index === 0 ? 'preview-live' : 'preview-fixed'}>
          <img
            src={mode.preview}
            width={mode.width}
            height={mode.height}
            loading="lazy"
            decoding="async"
            alt={mode.alt}
          />
          {mode.preview.startsWith('/') && (
            <a class="preview-enlarge" href={mode.preview}>
              Agrandir le graphique
            </a>
          )}
        </div>
      ))}
    </div>
    <div>
      <h2>Publier le graphique sur votre site</h2>
      <p>{intro}</p>
      {modes.map((mode, index) => (
        <details
          class="embed-mode"
          name="graphic-mode"
          data-mode={mode.id}
          open={index === selected}
        >
          <summary>{mode.title}</summary>
          <p>{mode.description}</p>
          <label for={'code-' + mode.id}>
            Code HTML · {mode.title.toLowerCase()}
          </label>
          <textarea
            id={'code-' + mode.id}
            rows="4"
            readonly
            spellcheck="false"
          >{mode.code}</textarea>
          <div class="embed-tools">
            <button
              type="button"
              class="button small"
              data-copy-chart={'code-' + mode.id}
              hidden
            >
              Copier le code
            </button>
            {mode.download && (
              <a href={mode.download.href} download={mode.download.filename}>
                Télécharger cette édition
              </a>
            )}
          </div>
        </details>
      ))}
      <p class="embed-feedback" role="status"></p>
    </div>
  </div>
</details>
<script>
  const integration = document.querySelector<HTMLDetailsElement>('#integrer');
  function openIntegration() {
    if (integration && location.hash === '#integrer') integration.open = true;
  }
  openIntegration();
  window.addEventListener('hashchange', openIntegration);
  document
    .querySelectorAll<HTMLButtonElement>('[data-copy-chart]')
    .forEach((button) => {
      button.hidden = false;
      button.addEventListener('click', async () => {
        const code = document.getElementById(
          button.dataset.copyChart!,
        ) as HTMLTextAreaElement;
        const feedback = button
          .closest('.retirement-embed')!
          .querySelector('[role=status]')!;
        try {
          await navigator.clipboard.writeText(code.value);
          feedback.textContent = 'Code HTML copié.';
        } catch {
          code.focus();
          code.select();
          feedback.textContent =
            'Code sélectionné. Utilisez la commande Copier de votre navigateur.';
        }
      });
    });
</script>
<style>
  .retirement-embed {
    margin-block: 1rem 1.6rem;
    border: 1px solid var(--line);
    border-radius: 0.7rem;
    background: var(--panel-gradient);
    padding: 0.22rem clamp(0.9rem, 2.5vw, 1.65rem);
  }
  .retirement-embed > summary {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    cursor: pointer;
    min-height: 3.2rem;
  }
  .retirement-embed > summary:after {
    content: '+' / '';
    margin-left: auto;
    font-size: 1.3rem;
  }
  .retirement-embed[open] > summary:after {
    content: '−' / '';
  }
  .retirement-embed > summary span {
    font: 0.8rem var(--mono);
    color: var(--muted);
  }
  .embed-workbench {
    display: grid;
    grid-template-columns: minmax(0, min(43%, 25rem)) minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 2.5rem);
    padding-block: 1rem 1.4rem;
    border-top: 1px solid var(--line);
    align-items: start;
  }
  .embed-preview img {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid var(--line);
    border-radius: 0.6rem;
  }
  .preview-enlarge {
    display: inline-block;
    padding-block: 0.55rem;
    font-size: 0.85rem;
  }
  .embed-preview .preview-fixed,
  .embed-workbench:has([data-mode='figee'][open]) .preview-live {
    display: none;
  }
  .embed-workbench:has([data-mode='figee'][open]) .preview-fixed {
    display: block;
  }
  h2 {
    font-size: 1.14rem;
    margin: 0;
  }
  p {
    line-height: 1.5;
    margin: 0.4rem 0 0.8rem;
  }
  .embed-mode {
    border-top: 1px solid var(--line);
    padding: 0.2rem 0 0.4rem;
  }
  .embed-mode summary {
    font-weight: 650;
    padding: 0.6rem 0;
    cursor: pointer;
  }
  label {
    display: block;
    color: var(--muted);
    font-size: 0.87rem;
    margin-bottom: 0.35rem;
  }
  textarea {
    width: 100%;
    min-width: 0;
    resize: vertical;
    padding: 0.65rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 0.4rem;
    background: #f5f9fa;
    color: var(--ink);
    font: 0.82rem/1.45 var(--mono);
  }
  .embed-tools {
    display: flex;
    align-items: center;
    gap: 0.55rem 1rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }
  .embed-feedback:empty {
    display: none;
  }
  @media (max-width: 650px) {
    .embed-workbench {
      grid-template-columns: minmax(0, 1fr);
    }
    .embed-preview {
      width: min(100%, 25rem);
      margin-inline: auto;
    }
  }
</style>
