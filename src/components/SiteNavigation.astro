---
import { groups } from '../lib/navigation';
import '../styles/site-navigation.css';

interface Props {
  current: string;
}
const { current } = Astro.props;
const path = Astro.url.pathname;
---

<nav
  class="site-navigation"
  aria-label="Navigation principale"
  data-site-navigation
>
  {groups.map((group) => (
    <details
      class="site-nav-group"
      name="rubriques"
      data-desk={group.id}
      data-current={
        group.links.some(([url]) => current === url) ? 'true' : undefined
      }
    >
      <summary class={`menu-${group.icon}`}>{group.name}</summary>
      <div class="desk-links">
        {group.links.map(([url, label]) => (
          <a
            href={url}
            aria-current={
              current === url ? (path === url ? 'page' : 'location') : undefined
            }
          >
            {label}
          </a>
        ))}
      </div>
    </details>
  ))}
</nav>

<script src="../scripts/site-navigation.ts"></script>
