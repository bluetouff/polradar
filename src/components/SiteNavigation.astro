---
import { groups } from '../lib/navigation';
import '../styles/site-navigation.css';

interface Props {
  current: string;
}
const { current } = Astro.props;
const path = Astro.url.pathname;
// Leaf dossiers and catalogue pages repeat the same off-topic menus thousands of times.
const detail =
  /^\/(?:mesures|engagements)\/[^/]+\/$/.test(path) || path.includes('/page/');
---

<nav
  class="site-navigation"
  aria-label="Navigation principale"
  data-site-navigation
>
  {groups.map((group) => (
    <details
      class="site-nav-group"
      name="rubriques"
      data-desk={group.id}
      data-current={
        group.links.some(([url]) => current === url) ? 'true' : undefined
      }
    >
      <summary class={`menu-${group.icon}`}>{group.name}</summary>
      <div
        class="desk-links"
        id={path === '/' ? 'menu-' + group.id : undefined}
      >
        {detail && !group.links.some(([url]) => url === current) ? (
          <a href={'/#menu-' + group.id} data-menu-links={group.id}>
            Toutes les rubriques · {group.name}
          </a>
        ) : (
          group.links.map(([url, label]) => (
            <a
              href={url}
              aria-current={
                current === url
                  ? path === url
                    ? 'page'
                    : 'location'
                  : undefined
              }
            >
              {label}
            </a>
          ))
        )}
      </div>
    </details>
  ))}
</nav>
