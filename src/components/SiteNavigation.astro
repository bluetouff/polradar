---
import { mobilePrimaryIcons, primaryNavigation } from '../lib/navigation';
import Icon from './Icon.astro';
import '../styles/site-navigation.css';

interface Props {
  current: string;
}
const { current } = Astro.props;
const path = Astro.url.pathname;
const active = primaryNavigation.find(({ sections }) =>
  sections.some((section) => current === section || path.startsWith(section)),
);
const entries = [
  { url: '/', label: 'Accueil', icon: 'institutions', mobileOnly: true },
  {
    url: '/recherche/',
    label: 'Recherche',
    icon: 'search',
    mobileOnly: true,
  },
  ...primaryNavigation.map((item) => ({
    url: item.url,
    label: item.label,
    icon: mobilePrimaryIcons.get(item.url),
    mobileOnly: false,
  })),
];
---

<nav class="site-navigation" aria-label="Navigation principale">
  {entries.map((item) => (
    <a
      href={item.url}
      class:list={[
        item.mobileOnly ? 'mobile-only' : !item.icon && 'desktop-only',
      ]}
      aria-current={
        path === item.url
          ? 'page'
          : active?.url === item.url ||
              (path === '/demander/' && item.url === '/recherche/')
            ? 'location'
            : undefined
      }
    >
      {item.icon && (
        <span class="navigation-icon" aria-hidden="true">
          <Icon name={item.icon} />
        </span>
      )}
      <span>{item.label}</span>
    </a>
  ))}
</nav>
