---
import { groups } from '../lib/navigation';
import '../styles/site-navigation.css';

interface Props {
  current: string;
}
const { current } = Astro.props;
const path = Astro.url.pathname;
// On detail pages every section has a static path to its complete menu on the homepage.
const detail = path.split('/').filter(Boolean).length > 1;
---

<nav class="site-navigation" aria-label="Navigation principale">
  {groups.map((group) => (
    <details
      name="rubriques"
      data-desk={group.id}
      data-current={
        group.links.some(([url]) => current === url) ? 'true' : undefined
      }
    >
      <summary class={`menu-${group.icon}`}>{group.name}</summary>
      <div id={path === '/' ? 'menu-' + group.id : undefined}>
        {detail ? (
          <>
            {group.links
              .filter(([url]) => url === current)
              .map(([url, label]) => (
                <a href={url} aria-current={path === url ? 'page' : 'location'}>
                  {label}
                </a>
              ))}
            <a href={'/#menu-' + group.id}>
              Toutes les rubriques · {group.name}
            </a>
          </>
        ) : (
          group.links.map(([url, label]) => (
            <a
              href={url}
              aria-current={
                current === url
                  ? path === url
                    ? 'page'
                    : 'location'
                  : undefined
              }
            >
              {label}
            </a>
          ))
        )}
      </div>
    </details>
  ))}
</nav>
