---
import { primaryNavigation } from '../lib/navigation';
import '../styles/site-navigation.css';

interface Props {
  current: string;
}
const { current } = Astro.props;
const path = Astro.url.pathname;
const active = primaryNavigation.find(({ sections }) =>
  sections.some((section) => current === section || path.startsWith(section)),
);
---

<nav class="site-navigation" aria-label="Navigation principale">
  {primaryNavigation.map((item) => (
    <a
      href={item.url}
      aria-current={
        item === active ? (path === item.url ? 'page' : 'location') : undefined
      }
    >
      {item.label}
    </a>
  ))}
</nav>
