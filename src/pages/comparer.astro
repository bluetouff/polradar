---
import Base from '../layouts/Base.astro';
import SourceLinks from '../components/SourceLinks.astro';
import {
  candidates,
  themes,
  engagements,
  scopes,
  candidateById,
} from '../lib/data';
const defaults = ['melenchon', 'philippe', 'retailleau'];
---

<Base title="Comparer les propositions" section="/comparer/">
  <header class="page-title compact">
    <p class="eyebrow">LE COMPARATEUR</p>
    <h1>
      Un sujet.
      <br />
      <em>Les différences.</em>
    </h1>
    <p>
      Choisissez un thème, puis deux ou trois candidatures. Les propositions
      restent attachées à leur contexte et à leurs sources.
    </p>
  </header>
  <form id="compare-form" class="compare-form" action="/comparer/" method="get">
    <label>
      Votre sujet
      <select id="compare-theme" name="theme">
        {themes.map((t) => (
          <option value={t.id}>{t.label}</option>
        ))}
      </select>
    </label>
    <fieldset class="comparison-count">
      <legend>Candidatures</legend>
      <label>
        <input type="radio" name="count" value="2" />2
      </label>
      <label>
        <input type="radio" name="count" value="3" checked />3
      </label>
    </fieldset>
    <label class="check-label">
      <input id="compare-archives" type="checkbox" name="archives" value="1" />
      Inclure les archives 2022
    </label>
    <button class="button primary" type="submit">
      Comparer ↗
    </button>
  </form>
  <div id="candidate-selectors" class="candidate-selectors">
    {defaults.map((id, index) => (
      <label>
        {' '}
        Candidature {index + 1}
        <select
          id={`compare-candidate-${index}`}
          aria-label={`Candidature ${index + 1}`}
        >
          {candidates.map((c) => (
            <option value={c.id} selected={c.id === id}>
              {c.name}
            </option>
          ))}
        </select>
      </label>
    ))}
  </div>
  <div class="comparison-title">
    <div>
      <p class="eyebrow">FACE À FACE</p>
      <h2 id="comparison-theme-title">Retraites</h2>
      <p id="comparison-note">{themes[0].note}</p>
    </div>
    <div class="comparison-actions">
      <button class="button small" type="button" id="comparison-share">
        Copier le lien
      </button>
      <button class="button small" type="button" id="comparison-print">
        Imprimer
      </button>
    </div>
  </div>
  <p
    id="comparison-feedback"
    class="small muted"
    role="status"
    aria-live="polite"
  ></p>
  <div id="comparison-cards" class="comparison-grid" data-count="3">
    {defaults.map((id) => {
      const c = candidateById(id);
      const e = engagements.find(
        (e) => e.candidate === id && e.theme === 'retraites',
      )!;
      return (
        <article class="comparison-card">
          <header>
            <p>{c.party}</p>
            <h3>{c.name}</h3>
          </header>
          <div class="comparison-body">
            <span class="tag">{scopes[e.scope]}</span>
            <h4>{e.title}</h4>
            <ul>
              {e.bullets.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
            {e.note && (
              <details>
                <summary>Contexte & précisions</summary>
                <p>{e.note}</p>
              </details>
            )}
          </div>
          <footer>
            <a href={`/engagements/${e.id}/`}>Lire la fiche complète ↗</a>
            <SourceLinks ids={e.sources} compact />
          </footer>
        </article>
      );
    })}
  </div>
  <noscript>
    <p class="notice">
      La comparaison initiale est lisible sans JavaScript. Pour explorer les
      autres sujets, consultez <a href="/themes/">les pages thématiques</a> et{' '}
      <a href="/candidats/">les dossiers candidats</a>.
    </p>
  </noscript>
  <aside class="notice section-space">
    <strong>Une absence de fiche reste une information limitée.</strong>
    <p>
      Elle signifie que notre corpus ne documente pas encore ce thème pour cette
      candidature. Les orientations générales sont distinguées des mesures
      détaillées. Les montants bruts et nets conservent leurs unités.
    </p>
    <a href="/methode/">Lire notre méthode ↗</a>
  </aside>
  <script src="../scripts/compare.ts"></script>
</Base>
