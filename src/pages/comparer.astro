---
import Base from '../layouts/Base.astro';
import MeasureCard from '../components/MeasureCard.astro';
import MetricPlot from '../components/MetricPlot.astro';
import Icon from '../components/Icon.astro';
import { candidates, themes, measures, candidateById } from '../lib/data';
import { digitalLawRoot } from '../lib/digital-law.mjs';
const defaults = ['melenchon', 'philippe', 'retailleau'];
---

<Base title="Comparateur de programmes" section="/comparer/">
  <header class="page-title">
    <h1>Comparateur de programmes</h1>
    <p>Sélectionnez un thème et deux ou trois candidats.</p>
  </header>
  <a class="retirement-entry" href="/comparer/retraites/">
    <Icon name="retraites" />
    <span>
      <strong>Ce qui changerait · Retraites</strong>
      <small>Trois programmes face au droit en vigueur</small>
    </span>
    <Icon name="arrow" />
  </a>
  <a class="retirement-entry" href={digitalLawRoot}>
    <Icon name="chiffrement" />
    <span>
      <strong>Ce qui changerait · Numérique</strong>
      <small>
        Chiffrement et données personnelles face au droit en vigueur
      </small>
    </span>
    <Icon name="arrow" />
  </a>
  <form id="compare-form" class="compare-form" action="/comparer/" method="get">
    <label>
      Votre sujet
      <select id="compare-theme" name="theme">
        {themes.map((t) => (
          <option value={t.id}>{t.label}</option>
        ))}
      </select>
    </label>
    <fieldset class="comparison-count">
      <legend>Candidatures</legend>
      <label>
        <input type="radio" name="count" value="2" />2
      </label>
      <label>
        <input type="radio" name="count" value="3" checked />3
      </label>
    </fieldset>
    <label class="check-label">
      <input id="compare-archives" type="checkbox" name="archives" value="1" />
      Inclure les archives 2022
    </label>
    <button class="button primary" type="submit">
      Comparer ↗
    </button>
  </form>
  <div id="candidate-selectors" class="candidate-selectors">
    {defaults.map((id, index) => (
      <label>
        {' '}
        Candidature {index + 1}
        <select
          id={`compare-candidate-${index}`}
          aria-label={`Candidature ${index + 1}`}
        >
          {candidates.map((c) => (
            <option value={c.id} selected={c.id === id}>
              {c.name}
            </option>
          ))}
        </select>
      </label>
    ))}
  </div>
  <div class="comparison-title">
    <div>
      <h2 id="comparison-theme-title">Retraites</h2>
      <p id="comparison-note">{themes[0].note}</p>
    </div>
    <div class="comparison-actions">
      <button class="button small" type="button" id="comparison-share">
        Copier le lien
      </button>
      <button class="button small" type="button" id="comparison-print">
        Imprimer
      </button>
    </div>
  </div>
  <p
    id="comparison-feedback"
    class="small muted"
    role="status"
    aria-live="polite"
  ></p>
  <div id="comparison-metrics">
    <MetricPlot
      measures={measures.filter(
        (measure) =>
          defaults.includes(measure.candidate) && measure.theme === 'retraites',
      )}
    />
  </div>
  <div id="comparison-cards" class="comparison-grid" data-count="3">
    {defaults.map((id) => {
      const candidate = candidateById(id);
      const items = measures.filter(
        (measure) =>
          measure.candidate === id &&
          measure.theme === 'retraites' &&
          measure.scope !== 'archive',
      );
      return (
        <article class="comparison-card">
          <header>
            <p>{candidate.party}</p>
            <h3>{candidate.name}</h3>
          </header>
          <div class="comparison-body">
            {items.map((measure) => (
              <MeasureCard measure={measure} compact level="h4" />
            ))}
          </div>
          <footer>
            <a href={`/candidats/${candidate.id}/`}>Dossier du candidat ↗</a>
          </footer>
        </article>
      );
    })}
  </div>
  <noscript>
    <p class="notice">
      La comparaison initiale est lisible sans JavaScript. Pour explorer les
      autres sujets, consultez <a href="/themes/">les pages thématiques</a> et{' '}
      <a href="/candidats/">les dossiers candidats</a>.
    </p>
  </noscript>
  <aside class="notice section-space">
    <strong>Thèmes non renseignés</strong>
    <p>
      Une fiche absente signifie que le thème reste à renseigner dans le corpus
      Polradar pour ce candidat.
    </p>
    <a href="/methode/">Lire notre méthode ↗</a>
  </aside>
  <script src="../scripts/compare.ts"></script>
</Base>

<style>
  .retirement-entry {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.65rem;
    border: 1px solid #b7c7be;
    border-left: 4px solid #205d79;
    border-radius: 4px;
    padding: 0.65rem 0.85rem;
    margin: 0.75rem 0 1rem;
    background: #e8eee7;
    text-decoration: none;
  }
  .retirement-entry span {
    flex: 1;
    min-width: 0;
  }
  .retirement-entry small {
    display: block;
    color: var(--muted);
  }
</style>
