---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { activeCandidates as candidates, themes } from '../lib/data';
import { questions, questionThemes } from '../lib/questions';
import { positionDivergences } from '../lib/divergence-data';
import { digitalLawRoot } from '../lib/digital-law.mjs';
import '../styles/questions.css';

const positionsByQuestion = new Map(
  positionDivergences.map(({ id, context, positions }) => [
    id,
    {
      context,
      positions: positions.map(({ label, entries }) => ({
        label,
        versions: entries.map(({ version }) => version.id),
      })),
    },
  ]),
);
---

<Base
  title="Comparateur des programmes de la présidentielle 2027"
  description="Comparez les propositions de deux ou trois candidats à la présidentielle 2027 par question ou par thème. Retrouvez les documents cités."
  section="/comparer/"
>
  <header class="page-title">
    <h1>Comparer les programmes</h1>
    <p>Partez d’une question ou choisissez deux candidats et un thème.</p>
  </header>
  <form id="compare-form" class="compare-builder" action="/comparer/" hidden>
    <div class="compare-question">
      <label for="compare-question">Que souhaitez-vous comprendre ?</label>
      <select id="compare-question" name="question">
        <option value="">Choisir une question</option>
        {questionThemes.map((theme) => {
          const rows = questions.filter((row) => row.theme === theme.id);
          return rows.length ? (
            <optgroup label={theme.label}>
              {rows.map((question) => (
                <option
                  value={question.id}
                  data-theme={question.theme}
                  data-versions={question.entries
                    .map(({ version }) => version.id)
                    .join(' ')}
                  data-reading={JSON.stringify({
                    candidates: question.candidateIds.length,
                    coverage: question.coverage,
                    reviews: question.reviews.map(
                      ({ candidate, sourceId, locator, checked }) => ({
                        candidate,
                        sourceId,
                        locator,
                        checked,
                      }),
                    ),
                    related: question.related,
                    ...positionsByQuestion.get(question.id),
                  })}
                >
                  {question.title}
                </option>
              ))}
            </optgroup>
          ) : null;
        })}
      </select>
      <a id="compare-question-detail" href="/questions/">
        Parcourir les questions
      </a>
      <p id="compare-question-coverage" class="muted" hidden></p>
    </div>
    <fieldset class="compare-candidates">
      <legend>Candidats à comparer</legend>
      <div class="compare-pick">
        <label>
          Thème
          <select id="compare-theme" name="theme">
            {themes.map((t) => (
              <option value={t.id} data-note={t.note}>
                {t.label}
              </option>
            ))}
          </select>
        </label>
        {[0, 1, 2].map((index) => (
          <label hidden={index === 2}>
            Candidature {index + 1}
            <select id={`compare-candidate-${index}`}>
              <option value="">Choisir un candidat</option>
              {candidates.map((c) => (
                <option value={c.id}>{c.name}</option>
              ))}
            </select>
          </label>
        ))}
      </div>
      <div class="compare-controls">
        <label>
          <input type="checkbox" id="compare-third" />
          Ajouter un troisième candidat
        </label>
        <label>
          <input
            id="compare-archives"
            type="checkbox"
            name="archives"
            value="1"
          />
          Inclure les archives 2022
        </label>
        <button class="button primary" type="submit">
          Comparer
        </button>
      </div>
    </fieldset>
  </form>
  <p
    id="comparison-feedback"
    class="muted"
    role="status"
    aria-live="polite"
  ></p>
  <section id="comparaison" aria-labelledby="comparison-theme-title" hidden>
    <div class="comparison-title">
      <div>
        <h2 id="comparison-theme-title" tabindex="-1">
          Retraites
        </h2>
        <p id="comparison-note">{themes[0].note}</p>
      </div>
      <div class="comparison-actions">
        <button class="button small" type="button" id="comparison-share">
          Copier le lien
        </button>
        <button
          class="button small"
          type="button"
          id="comparison-export"
          disabled
        >
          Exporter en JSON
        </button>
        <button class="button small" type="button" id="comparison-print">
          Imprimer
        </button>
      </div>
    </div>
    <div id="comparison-positions" hidden></div>
    <div id="comparison-metrics"></div>
    <nav class="comparison-jumps" aria-label="Candidats comparés" hidden></nav>
    <div id="comparison-cards" class="comparison-grid"></div>
    <p class="comparison-scope">
      Les chiffres sont regroupés lorsque leur unité et leur périmètre le
      permettent.
      <a href="/methode/">Méthode</a>
    </p>
  </section>
  <noscript>
    <p class="notice">
      Lisez <a href="/questions/">les réponses par question</a> ou retrouvez les
      propositions dans
      <a href="/themes/">les dossiers thématiques</a> ou
      <a href="/candidats/">les fiches des candidats</a>.
    </p>
  </noscript>
  <script src="../scripts/compare.ts"></script>
  <nav class="comparison-related" aria-label="Autres comparaisons">
    <a class="retirement-entry" href="/questions/">
      <Icon name="exchange" />
      <span>
        <strong>Qui propose quoi ?</strong>
        <small>Comparer les réponses à une question précise</small>
      </span>
      <Icon name="arrow" />
    </a>
    <a class="retirement-entry" href="/comparer/retraites/">
      <Icon name="retraites" />
      <span>
        <strong>Ce qui changerait · Retraites</strong>
        <small>Trois programmes face au droit en vigueur</small>
      </span>
      <Icon name="arrow" />
    </a>
    <a class="retirement-entry" href={digitalLawRoot}>
      <Icon name="chiffrement" />
      <span>
        <strong>Ce qui changerait · Numérique</strong>
        <small>
          Chiffrement et données personnelles face au droit en vigueur
        </small>
      </span>
      <Icon name="arrow" />
    </a>
  </nav>
</Base>

<style>
  .compare-builder {
    border-bottom: 1px solid var(--line);
    padding-block: 0.15rem 0.55rem;
  }
  .compare-question {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    align-items: center;
    gap: 0.34rem 1rem;
    max-width: 59rem;
    border-block-end: 1px solid var(--line);
    padding-bottom: 0.85rem;
  }
  .compare-question label {
    grid-column: 1 / -1;
    font-weight: 650;
  }
  .compare-question select {
    width: 100%;
    min-width: 0;
    min-height: 2.9rem;
    font-size: 1rem;
  }
  .compare-question a {
    display: flex;
    align-items: center;
    min-height: var(--target-size);
    color: var(--accent);
    font-size: 0.88rem;
  }
  #compare-question-coverage {
    grid-column: 1 / -1;
    margin: 0;
    font-size: 0.88rem;
  }
  .compare-candidates {
    border: 0;
    min-width: 0;
    margin: 0.8rem 0 0;
    padding: 0;
  }
  .compare-candidates legend {
    padding: 0;
    margin-bottom: 0.5rem;
    font-weight: 650;
  }
  .compare-pick {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: 0.65rem 0.9rem;
  }
  .compare-pick label {
    display: grid;
    gap: 0.35rem;
    font-size: 0.9rem;
    font-weight: 620;
  }
  .compare-pick select {
    min-height: 2.9rem;
    font-size: 1rem;
  }
  .compare-controls {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    column-gap: 1rem;
    margin-top: 0.45rem;
  }
  .compare-controls label {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.86rem;
    min-height: var(--target-size);
  }
  .compare-controls .button {
    margin-inline-start: auto;
    min-height: var(--target-size);
  }
  #comparison-feedback {
    margin: 0.65rem 0 1.15rem;
    font: 500 0.9rem/1.5 var(--sans);
  }
  #comparison-feedback:empty {
    display: none;
  }
  .comparison-actions {
    flex-wrap: wrap;
  }
  .comparison-actions button {
    min-height: var(--target-size);
  }
  #comparison-positions {
    margin-block: 0.8rem 1.25rem;
    border-inline-start: 3px solid var(--accent);
    padding-inline-start: 1rem;
  }
  #comparison-positions :global(ul) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 0.7rem 1.25rem;
    margin-block: 0.65rem;
    padding: 0;
    list-style: none;
  }
  #comparison-positions :global(span) {
    display: block;
    font-size: 0.88rem;
    color: var(--muted);
  }
  .comparison-grid :global(.comparison-card .compare-coverage) {
    margin: 0.4rem 0 0;
    font: 620 0.88rem/1.5 var(--sans);
  }
  .comparison-scope {
    color: var(--muted);
    font-size: 0.85rem;
    margin-block: 1rem 1.45rem;
  }
  .comparison-related {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 0.65rem 1.4rem;
    margin-block: 1.1rem;
  }
  .comparison-jumps {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1rem;
    padding-block: 0.3rem;
    font-size: 0.9rem;
  }
  .comparison-jumps :global(a) {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-size);
  }
  @media (max-width: 560px) {
    .compare-question {
      grid-template-columns: minmax(0, 1fr);
    }
    .compare-question a {
      min-height: 2rem;
    }
    .compare-controls .button {
      margin-block: 0.4rem 0;
      margin-inline-start: 0;
      width: 100%;
      justify-content: center;
    }
  }
  @media print {
    .comparison-jumps,
    .compare-builder {
      display: none;
    }
  }
  .retirement-entry {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.65rem;
    min-width: 0;
    border-block-start: 2px solid var(--accent);
    padding: 0.65rem 0;
    background: transparent;
    text-decoration: none;
  }
  .retirement-entry:hover strong {
    text-decoration: underline;
  }
  .retirement-entry span {
    flex: 1;
    min-width: 0;
  }
  .retirement-entry small {
    display: block;
    color: var(--muted);
  }
</style>
