---
import Base from '../layouts/Base.astro';
import EngagementCard from '../components/EngagementCard.astro';
import SourceLinks from '../components/SourceLinks.astro';
import { budget, engagements, formatDate } from '../lib/data';
const number = (value: number) => value.toLocaleString('fr-FR');
const budgetStatus: Record<string, string> = {
  provisional: 'Données provisoires',
  'semi-definitive': 'Données semi-définitives',
  definitive: 'Données définitives',
};
const values = [
  ['Déficit public', budget.values.deficit, `Flux annuel · ${budget.year}`],
  ['Dette publique', budget.values.debt, `Stock à fin ${budget.year}`],
  ['Dépenses', budget.values.spending, `Flux annuel · ${budget.year}`],
  ['Recettes', budget.values.revenue, `Flux annuel · ${budget.year}`],
];
const records = engagements.filter(
  (e) => e.theme === 'fiscalite' && e.scope !== 'archive',
);
---

<Base title="Économie : les programmes et les comptes" section="/economie/">
  <header class="page-title">
    <p class="eyebrow">L’OBSERVATOIRE ÉCONOMIQUE</p>
    <h1>
      Les promesses.
      <br />
      <em>Et les comptes.</em>
    </h1>
    <p>
      Lire les bénéficiaires, le calendrier et les financements annoncés.
      Distinguer les estimations des campagnes des données publiques qui
      décrivent le point de départ.
    </p>
  </header>
  <div class="section-heading">
    <div>
      <p class="eyebrow">LE CADRE COMMUN</p>
      <h2>Les finances publiques en {budget.year}.</h2>
    </div>
    <span class="tag">{budgetStatus[budget.status]}</span>
  </div>
  <p class="section-description">
    {budget.scope} Publication du {formatDate(budget.published)}. Ces données
    annuelles décrivent l’exercice {budget.year}.
  </p>
  <div class="budget-kpis">
    {values.map(([label, value, note]) => (
      <article>
        <p>{label}</p>
        <strong>
          {Number(value).toLocaleString('fr-FR')}
          <span> %</span>
        </strong>
        <p>du PIB</p>
        <small>{note}</small>
      </article>
    ))}
  </div>
  <SourceLinks ids={[budget.sourceId]} compact />
  <div class="two-col section-space">
    <article class="panel">
      <h2>Lire les périmètres.</h2>
      <ul class="reading-list">
        <li>
          Un montant annuel et un investissement sur cinq ans conservent des
          calendriers distincts.
        </li>
        <li>
          Une baisse d’impôt doit être lue avec son assiette et le financement
          annoncé.
        </li>
        <li>
          Un chiffrage de campagne atteste une estimation attribuée à son
          auteur.
        </li>
        <li>
          Dette et déficit décrivent un stock et un flux. Leurs ratios ne
          s’additionnent pas.
        </li>
      </ul>
    </article>
    <article class="panel dark-panel">
      <p class="eyebrow">LE POINT DE DÉPART</p>
      <h2>{number(budget.values.deficit)} points de PIB</h2>
      <p>
        En {budget.year}, {number(budget.values.spending)} % de dépenses
        publiques et
        {number(budget.values.revenue)} % de recettes : l’écart annuel
        représente
        {number(budget.values.deficit)} points de PIB.
      </p>
      <a href="/dossiers/lire-un-programme/" class="text-link">
        Comment lire un engagement économique ↗
      </a>
    </article>
  </div>
  <div class="section-heading">
    <div>
      <p class="eyebrow">FISCALITÉ & FINANCEMENT</p>
      <h2>Les orientations documentées.</h2>
    </div>
    <a href="/comparer/?theme=fiscalite" class="text-link">
      Comparer sur ce sujet ↗
    </a>
  </div>
  <div class="engagement-grid three">
    {records.map((item) => (
      <EngagementCard item={item} />
    ))}
  </div>
</Base>
