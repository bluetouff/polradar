---
import Base from '../layouts/Base.astro';
import SourceLinks from '../components/SourceLinks.astro';
import { events, formatDate } from '../lib/data';
---

<Base title="Chronologie de la campagne" section="/campagne/">
  <header class="page-title">
    <h1>Chronologie de la campagne</h1>
    <p>Annonces et publications présentes dans le corpus, classées par date.</p>
  </header>
  <div class="timeline">
    {events
      .filter((e) => e.kind === 'past')
      .sort((a, b) => b.date.localeCompare(a.date))
      .map((event) => (
        <article>
          <time datetime={event.date}>{formatDate(event.date)}</time>
          <div>
            <h2>{event.title}</h2>
            <p>{event.description}</p>
            <SourceLinks ids={event.sources} compact />
          </div>
        </article>
      ))}
  </div>
  <aside class="notice section-space">
    <strong>Historique des engagements</strong>
    <p>
      L’historique de chaque fiche commence avec sa première version intégrée au
      site.
    </p>
    <a href="/engagements/">Ouvrir le registre des engagements ↗</a>
  </aside>
</Base>
