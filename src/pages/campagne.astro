---
import PagedResults from '../components/PagedResults.astro';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SourceLinks from '../components/SourceLinks.astro';
import { campaignBriefs } from '../lib/briefs';
import CandidatePortrait from '../components/CandidatePortrait.astro';
import { events, candidates, candidateById, formatDate } from '../lib/data';
import '../styles/campaign.css';

const categories: Record<string, { label: string; icon: string }> = {
  candidature: { label: 'Candidature', icon: 'people' },
  programme: { label: 'Programme', icon: 'source' },
  sondage: { label: 'Sondage', icon: 'sondages' },
  meeting: { label: 'Discours et meeting', icon: 'layers' },
  calendrier: { label: 'Calendrier', icon: 'clock' },
};
const dateKinds: Record<string, string> = {
  evenement: 'Événement',
  publication: 'Publication',
  'mise-a-jour': 'Document mis à jour',
};
const briefs = await campaignBriefs();
const briefByEvent = new Map(briefs.map((b) => [b.event.id, b.href]));
const past = events
  .filter((event) => event.kind === 'past')
  .sort(
    (a, b) =>
      b.date.localeCompare(a.date) || a.title.localeCompare(b.title, 'fr'),
  );
const upcoming = events
  .filter((event) => event.kind === 'announced')
  .sort((a, b) => a.date.localeCompare(b.date));
const months = [...new Set(past.map((event) => event.date.slice(0, 7)))].map(
  (id) => ({
    id,
    rows: past.filter((event) => event.date.startsWith(id)),
    label: new Intl.DateTimeFormat('fr-FR', {
      month: 'long',
      year: 'numeric',
      timeZone: 'Europe/Paris',
    }).format(new Date(`${id}-01T12:00:00Z`)),
  }),
);
const maxCount = Math.max(1, ...months.map((month) => month.rows.length));
const related = candidates.filter((candidate) =>
  past.some((event) => event.candidates.includes(candidate.id)),
);
const categoryCounts = Object.entries(categories).map(([id, category]) => ({
  id,
  ...category,
  count: past.filter((event) => event.category === id).length,
}));
let categoryOffset = 0;
---

<Base
  title="Chronologie de la campagne"
  section="/campagne/"
  description="Annonces de candidature, publications de programmes, meetings et enquêtes d’opinion, avec leurs dates et leurs sources."
>
  <header class="page-title feature-title">
    <span class="feature-emblem">
      <Icon name="historique" />
    </span>
    <div>
      <h1>Chronologie de la campagne</h1>
      <p>Candidatures, programmes, meetings et sondages.</p>
      <a href="/agenda/" class="inline-action">
        Carte et agenda des rendez-vous ↗
      </a>
    </div>
  </header>
  <p class="campaign-brief-link">
    <a class="inline-action" href="/breves/">
      Lire les brèves de campagne ↗
    </a>
  </p>
  <div class="campaign-overview">
    <section
      class="campaign-activity"
      aria-labelledby="campaign-activity-title"
    >
      <div class="campaign-activity-heading">
        <span class="campaign-overline">Événements du corpus</span>
        <Icon name="layers" />
      </div>
      <h2 id="campaign-activity-title">
        <strong>{past.length}</strong>
        <span>événements documentés</span>
      </h2>
      {past.length > 0 && (
        <p>
          Du {formatDate(past.at(-1)!.date)} au {formatDate(past[0].date)}
        </p>
      )}
      <svg
        class="campaign-distribution"
        viewBox="0 0 100 8"
        preserveAspectRatio="none"
        role="img"
        aria-label={categoryCounts
          .map((category) => `${category.label} : ${category.count}`)
          .join(' ; ')}
      >
        {categoryCounts.map((category) => {
          const start = categoryOffset;
          const width = past.length ? (category.count / past.length) * 100 : 0;
          categoryOffset += width;
          return (
            <rect
              class={`event-${category.id}`}
              x={start}
              width={width}
              height="8"
            />
          );
        })}
      </svg>
      <ul class="campaign-category-key">
        {categoryCounts.map((category) => (
          <li class={`event-${category.id}`}>
            <span class="campaign-key-icon">
              <Icon name={category.icon} />
            </span>
            <span>{category.label}</span>
            <b>{category.count}</b>
          </li>
        ))}
      </ul>
    </section>
    <aside class="campaign-agenda" aria-labelledby="campaign-agenda-title">
      <h2 id="campaign-agenda-title">
        <Icon name="institutions" /> Le scrutin de 2027
      </h2>
      <div class="campaign-election-pair">
        {upcoming.map((event) => (
          <div class="campaign-election">
            <span>
              {event.id === 'premier-tour' ? 'Premier tour' : 'Second tour'}
            </span>
            <time datetime={event.date}>
              <b>{event.date.slice(-2)}</b>
              <span>
                {new Intl.DateTimeFormat('fr-FR', {
                  month: 'long',
                  year: 'numeric',
                  timeZone: 'Europe/Paris',
                }).format(new Date(`${event.date}T12:00:00Z`))}
              </span>
            </time>
          </div>
        ))}
      </div>
      <details class="campaign-calendar-source">
        <summary>Dates annoncées par le gouvernement</summary>
        <SourceLinks ids={['calendar']} compact />
      </details>
      <a class="campaign-agenda-link" href="/agenda/">
        <Icon name="map-pin" /> Carte et agenda des rendez-vous{' '}
        <Icon name="arrow" />
      </a>
    </aside>
  </div>
  <nav class="campaign-month-nav" aria-label="Aller à un mois">
    <ol>
      {months.map((month) => (
        <li data-month-link={month.id}>
          <a href={`#mois-${month.id}`}>
            <span>{month.label}</span>
            <b>{month.rows.length}</b>
            <svg
              viewBox="0 0 100 4"
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              <rect class="month-track" width="100" height="4" />
              <rect
                class="month-volume"
                width={(month.rows.length / maxCount) * 100}
                height="4"
              />
            </svg>
          </a>
        </li>
      ))}
    </ol>
  </nav>
  <form id="campaign-filters" class="facet-filters" hidden>
    <label class="wide-field">
      Rechercher
      <input
        id="campaign-search"
        type="search"
        placeholder="Un nom, un sujet"
        autocomplete="off"
      />
    </label>
    <label>
      Type d’annonce
      <select id="campaign-category">
        <option value="">Tous les événements</option>
        {Object.entries(categories).map(([id, category]) => (
          <option value={id}>{category.label}</option>
        ))}
      </select>
    </label>
    <label>
      Personnalité
      <select id="campaign-candidate">
        <option value="">Toutes les personnalités</option>
        {related.map((candidate) => (
          <option value={candidate.id}>{candidate.name}</option>
        ))}
      </select>
    </label>
    <button class="button light" type="reset">
      Réinitialiser
    </button>
  </form>
  <p id="campaign-status" role="status" aria-live="polite" class="results-meta">
    {past.length} événements
  </p>
  <PagedResults total={past.length}>
    <div class="campaign-layout">
      <div class="campaign-journal">
        {months.map((month) => (
          <section
            class="campaign-month"
            id={`mois-${month.id}`}
            data-month={month.id}
            aria-labelledby={`titre-${month.id}`}
          >
            <h2 id={`titre-${month.id}`}>
              {month.label}
              <span data-month-count>{month.rows.length}</span>
            </h2>
            <ol class="campaign-event-grid">
              {month.rows.map((event) => (
                <li
                  class={`campaign-entry event-${event.category}`}
                  id={event.id}
                  data-category={event.category}
                  data-candidates={event.candidates.join(' ')}
                  data-search={`${event.title} ${event.description} ${event.candidates.map((id) => candidates.find((row) => row.id === id)?.name || '').join(' ')}`}
                >
                  <div class="campaign-card-heading">
                    <time
                      class="campaign-day"
                      datetime={event.date}
                      aria-label={formatDate(event.date)}
                    >
                      <b>{event.date.slice(-2)}</b>
                      <span>
                        {new Intl.DateTimeFormat('fr-FR', {
                          weekday: 'short',
                          timeZone: 'Europe/Paris',
                        }).format(new Date(`${event.date}T12:00:00Z`))}
                      </span>
                    </time>
                    <div class="campaign-entry-meta">
                      <span class="campaign-category-label">
                        <Icon name={categories[event.category].icon} />
                        {categories[event.category].label}
                      </span>
                      <span>{dateKinds[event.dateKind]}</span>
                    </div>
                  </div>
                  <article>
                    <h3>
                      {briefByEvent.has(event.id) ? (
                        <a href={briefByEvent.get(event.id)}>{event.title}</a>
                      ) : (
                        event.title
                      )}
                    </h3>
                    <p>{event.description}</p>
                  </article>
                  <div class="campaign-card-footer">
                    {event.candidates.length === 1 ? (
                      <a
                        class="campaign-person"
                        href={`/candidats/${event.candidates[0]}/`}
                      >
                        <span class="campaign-person-portrait">
                          <CandidatePortrait
                            candidate={candidateById(event.candidates[0])}
                            compact
                          />
                        </span>
                        <span>{candidateById(event.candidates[0]).name}</span>
                      </a>
                    ) : event.category === 'candidature' &&
                      event.candidates.length > 1 ? (
                      <span class="campaign-section-link">
                        {event.candidates.map((id) => (
                          <a href={'/candidats/' + id + '/'}>
                            {candidateById(id).name}
                          </a>
                        ))}
                      </span>
                    ) : (
                      <a
                        class="campaign-section-link"
                        href={
                          event.category === 'sondage'
                            ? '/sondages/'
                            : '/reperes/'
                        }
                      >
                        <Icon name={categories[event.category].icon} />
                        {event.category === 'sondage'
                          ? 'Consulter les sondages'
                          : 'Calendrier électoral'}
                        <Icon name="arrow" />
                      </a>
                    )}
                    <details class="campaign-entry-sources">
                      <summary>
                        <Icon name="source" /> Sources · {event.sources.length}
                      </summary>
                      <SourceLinks ids={event.sources} compact />
                    </details>
                  </div>
                </li>
              ))}
            </ol>
          </section>
        ))}
        <p id="campaign-empty" class="notice" hidden>
          Aucun événement pour cette sélection.
        </p>
      </div>
    </div>
  </PagedResults>
  <details class="campaign-reading">
    <summary>
      <Icon name="clock" /> Lire les dates
    </summary>
    <p>
      Les publications et les mises à jour de documents sont identifiées dans
      chaque entrée. La date d’un sondage est celle de sa publication ; son
      terrain figure dans le descriptif.
    </p>
  </details>
  <script>
    import '../scripts/campaign';
  </script>
</Base>
