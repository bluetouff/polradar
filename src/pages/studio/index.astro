---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { studioRights } from '../../lib/studio-rights';
import {
  studioItems,
  studioFamilies,
  studioPollArchives,
} from '../../lib/studio';
import { formatDate, meta } from '../../lib/data';
import '../../styles/studio.css';
const first = studioItems.find((i) => i.id === 'economie-inflation')!;
type Option = {
  id: string;
  label: string;
  generated?: boolean;
  poll?: string;
  institute?: string;
};
const families = Object.entries(studioFamilies)
  .map(([id, name]): { id: string; name: string; items: Option[] } => ({
    id,
    name,
    items: studioItems
      .filter((i) => i.family === id)
      .sort((a, b) => a.label.localeCompare(b.label, 'fr')),
  }))
  .filter((f) => f.items.length);
if (studioPollArchives.length)
  families.splice(families.findIndex((f) => f.id === 'sondages') + 1, 0, {
    id: 'sondages-archives',
    name: 'Sondages · archives (' + studioPollArchives.length + ')',
    items: studioPollArchives.map((poll) => ({
      id: 'sondages-archives-' + poll.id,
      label:
        poll.institute +
        ' · ' +
        formatDate(poll.published) +
        ' · ' +
        poll.scenario +
        ' · p. ' +
        poll.noticePage,
      poll: poll.id,
      institute: poll.institute,
    })),
  });
const institutes = [
  ...new Set(studioPollArchives.map((poll) => poll.institute)),
].sort((a, b) => a.localeCompare(b, 'fr'));
---

<Base
  title="Studio graphique"
  section="/studio/"
  description="Préparer un graphique de la présidentielle, télécharger ses données et publier une édition datée ou actualisée."
>
  <header class="studio-title">
    <span class="studio-mark">
      <Icon name="sondages" />
    </span>
    <div>
      <h1>Studio graphique</h1>
      <p>
        Un graphique pour votre article, votre cours ou votre dossier.
        Choisissez les données et le format.
      </p>
    </div>
    <a href="/presse/">
      Espace presse <Icon name="arrow" />
    </a>
  </header>
  <div class="studio-desk" id="studio" data-site={meta.site}>
    <div class="studio-controls" id="studio-controls" hidden>
      <section>
        <h2>Données</h2>
        <label for="studio-family">Sujet</label>
        <select id="studio-family">
          {families.map((f) => (
            <option value={f.id}>{f.name}</option>
          ))}
        </select>
        <div id="studio-archive-filters" hidden>
          <label for="studio-archive-institute">Institut</label>
          <select id="studio-archive-institute">
            <option value="">Tous les instituts</option>
            {institutes.map((institute) => (
              <option value={institute}>{institute}</option>
            ))}
          </select>
        </div>
        <label for="studio-item">Série, dossier ou période</label>
        <select id="studio-item">
          {families.map((f) => (
            <optgroup label={f.name} data-family={f.id}>
              {f.items.map((i) => (
                <option
                  value={i.id}
                  data-drawing={i.generated || undefined}
                  data-poll={i.poll}
                  data-institute={i.institute}
                  selected={i.id === first.id}
                >
                  {i.label}
                </option>
              ))}
            </optgroup>
          ))}
        </select>
      </section>
      <details class="studio-options" open>
        <summary>Mise en page</summary>
        <div class="studio-pair">
          <label>
            Format
            <select id="studio-shape">
              <option value="source">Original</option>
              <option value="horizontal">Horizontal · 16∶9</option>
              <option value="carre">Carré · 1∶1</option>
              <option value="vertical">Vertical · 4∶5</option>
            </select>
          </label>
          <label>
            Largeur
            <select id="studio-width">
              <option value="640">640 px</option>
              <option value="960" selected>
                960 px
              </option>
              <option value="1200">1 200 px</option>
            </select>
          </label>
        </div>
        <label class="studio-check">
          <input id="studio-caption" type="checkbox" checked /> Légende et liens
          dans le HTML
        </label>
      </details>
      <details class="studio-options" open>
        <summary>Publier le graphique</summary>
        <label for="studio-mode">Édition à intégrer</label>
        <select id="studio-mode">
          <option value="figee">Figée · données de cette édition</option>
          <option value="actualisee">Actualisée · lien permanent</option>
        </select>
        <p id="studio-mode-note">
          L’édition figée conserve l’image de cette publication.
        </p>
        <label for="studio-code">Code à intégrer</label>
        <textarea
          id="studio-code"
          rows="2"
          readonly
          spellcheck="false"
        ></textarea>
        <button type="button" id="studio-copy">
          <Icon name="source" />
          Copier le code
        </button>
      </details>
    </div>
    <p class="studio-prompt" id="studio-prompt" hidden>
      Choisissez une série, un dossier ou une période pour afficher son
      graphique.
    </p>
    <article class="studio-proof" id="studio-proof">
      <div class="studio-proof-head">
        <div>
          <p>Aperçu de l’édition</p>
          <h2 id="studio-title">{first.graphic.title}</h2>
        </div>
        <span id="studio-date">{first.graphic.dateLabel}</span>
      </div>
      <figure>
        <img
          id="studio-img"
          src={first.live}
          width={first.graphic.width}
          height={first.graphic.height}
          alt={first.graphic.alt}
        />
      </figure>
      <div class="studio-save">
        <h3>Télécharger l’édition</h3>
        <div id="studio-formats" hidden>
          {['SVG', 'PNG', 'CSV', 'HTML autonome'].map((f, i) => (
            <button
              type="button"
              data-format={['svg', 'png', 'csv', 'html'][i]}
            >
              <Icon name="download" />
              {f}
            </button>
          ))}
        </div>
        <noscript>
          <a href={first.live} download="polradar-inflation.svg">
            Télécharger le SVG de l’inflation
          </a>
        </noscript>
      </div>
      <details class="studio-refs" open>
        <summary>Sources et méthode</summary>
        <ul id="studio-sources">
          {first.graphic.sources.map((s) => (
            <li>
              <a href={s.url} rel="noreferrer">
                {s.label}
              </a>
            </li>
          ))}
        </ul>
        <a id="studio-page" href={first.graphic.page}>
          Lire le dossier Polradar <Icon name="arrow" />
        </a>
      </details>
      <div id="studio-table" class="studio-table"></div>
      <details class="studio-refs">
        <summary>Crédit et réutilisation</summary>
        <p>
          Pour le SVG, le PNG ou le HTML, créditez Polradar (bluetouff) et{' '}
          <a href={studioRights.workUrl} rel="noreferrer">
            CC BY 4.0
          </a>
          . Indiquez vos adaptations. Pour le CSV, conservez les références et
          vérifiez les droits de chaque producteur. La base originale de
          Polradar est sous ODbL 1.0. Le nom, le logo et l’identité visuelle
          sont réservés.
        </p>
        <a href="/licences/">Lire les licences</a>
      </details>
    </article>
    <p id="studio-status" role="status" aria-live="polite"></p>
  </div>
  <p class="studio-catalog-link">
    <a href="/studio/catalogue/">
      Catalogue des graphiques et des sources <Icon name="arrow" />
    </a>
  </p>
</Base>
<script>
  import '../../scripts/studio';
</script>
