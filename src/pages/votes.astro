---
import Base from '../layouts/Base.astro';
import { archivesByEditorialBallot } from '../lib/parliamentary-archives';
import Icon from '../components/Icon.astro';
import DossierPicker from '../components/DossierPicker.astro';
import Distribution from '../components/Distribution.astro';
import { formatDate, themeById } from '../lib/data';
import {
  legislativeVotes,
  voteCases,
  independentVotes,
} from '../lib/votes-data';
import { chambers, positionLabel } from '../lib/legislative-votes.mjs';
import '../styles/votes.css';
---

<Base
  title="Propositions et votes passés"
  section="/votes/"
  description="Les propositions de campagne et les scrutins nominatifs de l’Assemblée nationale, du Sénat et du Parlement européen, avec les résultats et les sources."
>
  <header class="page-title votes-title">
    <div>
      <h1>Propositions et votes passés</h1>
      <p>
        {voteCases.length} dossiers relient des propositions aux votes
        nominatifs de{' '}
        {new Set(voteCases.map((record) => record.candidate)).size} candidats.
      </p>
    </div>
    <a href="#registres" class="button">
      <Icon name="institutions" />
      Consulter les registres
    </a>
  </header>
  <div class="votes-workspace" data-votes-workspace>
    <DossierPicker
      type="votes"
      choices={voteCases.map((record) => ({
        id: record.id,
        title: record.title,
        candidate: record.candidateRecord,
        icon: record.measure.theme,
        topic: themeById(record.measure.theme).short,
        subject: record.ballots.at(-1)!.shortTitle,
        ballot: record.ballots.at(-1)!,
        ballotIds: record.ballots.map((ballot) => ballot.id),
        detail: `${record.ballots.length > 1 ? 'Dernier scrutin · ' : ''}${chambers[record.ballots.at(-1)!.chamber]} · ${formatDate(record.ballots.at(-1)!.date)}`,
      }))}
    />
  </div>
  <nav
    id="registres"
    class="vote-archives-links"
    aria-label="Archives des scrutins nominatifs"
  >
    <div>
      <Icon name="vote" />
      <p>
        <a href="/votes/registre/">Registre des scrutins de l’Assemblée</a>
        <small>XVe et XVIe législatures · juillet 2017 à juin 2024</small>
      </p>
    </div>
    <div>
      <Icon name="institutions" />
      <p>
        <a href="/votes/archives/">
          Scrutins du Sénat et du Parlement européen
        </a>
        <small>Sessions du Sénat et votes européens en séance plénière</small>
      </p>
    </div>
  </nav>
  <Distribution
    title={`${legislativeVotes.ballots.length} scrutins par assemblée`}
    note={`Votes recensés au ${formatDate(legislativeVotes.checked)}`}
    parts={Object.entries(chambers).map(([id, label]) => ({
      label,
      count: legislativeVotes.ballots.filter((vote) => vote.chamber === id)
        .length,
    }))}
  />
  <aside class="vote-method">
    <Icon name="source" />
    <div>
      <h2>Lire un vote dans son contexte</h2>
      <p>
        La couleur indique le choix au scrutin cité. Une motion de rejet, une
        censure et un vote sur l’ensemble d’une loi ont leur propre objet. Leur
        portée figure à côté de chaque résultat.
      </p>
      <p>
        Les positions viennent des listes nominatives officielles. Cette
        sélection ne constitue pas un bilan de carrière ni un score de
        cohérence. La date de séance suit celle de l’institution ; la date de
        consultation d’un programme reste distincte.
      </p>
      <nav
        class="vote-method-links"
        aria-label="Approfondir les sources et les propositions"
      >
        <a href="/sources/">
          Catalogue des sources <Icon name="arrow" />
        </a>
        <a href="/evolution/">
          Évolution des propositions <Icon name="arrow" />
        </a>
      </nav>
    </div>
  </aside>
  {independentVotes.length > 0 && (
    <section class="section-space">
      <h2>Autres votes nominatifs documentés</h2>
      <p>
        Ces scrutins ont une source nominative. Le rapprochement avec une mesure
        reste à établir.
      </p>
      <div class="roll-cards">
        {independentVotes.map(({ id, ballot, position, candidate, source }) => (
          <article class="panel" id={id}>
            <small>
              {chambers[ballot.chamber]} ·{' '}
              <time datetime={ballot.date}>{formatDate(ballot.date)}</time>
            </small>
            <h3>{ballot.shortTitle}</h3>
            <p>
              {candidate.name} ·{' '}
              <strong>{positionLabel(position, ballot)}</strong>
            </p>
            <a href={source.url} rel="noreferrer">
              Liste nominative officielle ↗
            </a>
            {archivesByEditorialBallot.get(ballot.id) && (
              <p>
                <a href={archivesByEditorialBallot.get(ballot.id)!.url}>
                  Relevé du scrutin dans le registre →
                </a>
              </p>
            )}
          </article>
        ))}
      </div>
    </section>
  )}
</Base>
<script src="../scripts/votes.ts"></script>

<style>
  .vote-method-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1.2rem;
  }
  .roll-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 1rem;
  }
  .roll-cards article {
    padding: 1.15rem;
  }
  .roll-cards h3 {
    margin-block: 0.6rem;
  }
</style>
