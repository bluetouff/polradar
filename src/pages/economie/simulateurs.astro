---
import Base from '../../layouts/Base.astro';
import SalaryCalculator from '../../components/SalaryCalculator.astro';
import Icon from '../../components/Icon.astro';
import comparison from '../../data/retirement-comparison.json';
import { retirementUrl } from '../../lib/retirement-comparison.mjs';
import { householdSimulators } from '../../lib/household-simulators.mjs';

const directory = [
  ...householdSimulators.map((entry) => ({
    ...entry,
    href: '/economie/simulateurs/' + entry.id + '/',
  })),
  {
    id: 'electricite',
    title: 'Taxes sur l’électricité',
    summary: 'Mesurer l’effet de la TVA et de l’accise sur vos kilowattheures.',
    icon: 'climat',
    href: '/economie/simulateurs/electricite/',
  },
  {
    id: 'csg',
    title: 'CSG sur le salaire',
    summary: 'Calculer la contribution à partir d’un salaire brut mensuel.',
    icon: 'fiscalite',
    href: '#calculer-csg',
  },
  {
    id: 'retraite',
    title: 'Retraite par génération',
    summary: 'Comparer l’âge de départ, les trimestres et le taux plein.',
    icon: 'retraites',
    href: '#sim-retraite',
  },
];
const panels = [
  {
    id: 'revenus',
    label: 'Salaire et travail',
    topics: ['smic', 'csg', 'temps-de-travail', 'impot-sur-le-revenu'],
  },
  {
    id: 'depenses',
    label: 'Factures et logement',
    topics: [
      'electricite',
      'carburants',
      'loyers',
      'premier-achat-immobilier',
      'abonnement-transports',
    ],
  },
  {
    id: 'famille',
    label: 'Famille, santé et retraite',
    topics: [
      'creche',
      'allocations-familiales',
      'successions',
      'retraite',
      'consultation-medicale',
    ],
  },
].map((panel) => ({
  ...panel,
  tools: panel.topics.map((id) => directory.find((entry) => entry.id === id)!),
}));
---

<Base
  title="Mon quotidien · Simulateurs de Polradar"
  section="/economie/simulateurs/"
  description={
    directory.length +
    ' outils pour calculer vos revenus, votre impôt, vos dépenses et vos remboursements, et consulter les propositions sourcées.'
  }
>
  <header class="daily-hero">
    <span class="daily-hero-icon">
      <Icon name="fiscalite" />
    </span>
    <div>
      <h1>Mon quotidien</h1>
      <p>
        {directory.length} outils pour calculer vos revenus, vos dépenses et vos
        droits, et retrouver les propositions qui les concernent.
      </p>
      <nav aria-label="Catégories des simulateurs">
        {panels.map((panel) => (
          <a href={'#daily-' + panel.id}>{panel.label}</a>
        ))}
      </nav>
    </div>
  </header>

  <div class="daily-directory">
    {panels.map((panel) => (
      <section
        class="daily-group"
        data-group={panel.id}
        aria-labelledby={'daily-' + panel.id}
      >
        <h2 id={'daily-' + panel.id}>{panel.label}</h2>
        <div class="daily-tools">
          {panel.tools.map((entry) => (
            <a
              class="daily-tool"
              data-simulator-card={entry.id}
              href={entry.href}
            >
              <span class="daily-icon">
                <Icon name={entry.icon} />
              </span>
              <span class="daily-tool-text">
                <strong>{entry.title}</strong>
                <span>{entry.summary}</span>
              </span>
              <Icon name="arrow" />
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
  <p class="daily-note">
    <Icon name="chiffrement" /> Les valeurs saisies restent dans votre
    navigateur.
  </p>

  <SalaryCalculator />
  <section class="panel daily-retirement" aria-labelledby="sim-retraite">
    <h2 id="sim-retraite">Retraite par génération</h2>
    <p>
      Choisissez votre période de naissance pour comparer l’âge légal, les
      trimestres nécessaires et l’âge du taux plein dans le régime général.
    </p>
    <nav class="cohort-options" aria-label="Période de naissance">
      {comparison.cohorts.map((c) => (
        <a href={retirementUrl(c.id)}>{c.label}</a>
      ))}
    </nav>
  </section>
</Base>

<style>
  .daily-hero {
    display: flex;
    align-items: flex-start;
    gap: clamp(0.75rem, 2vw, 1.4rem);
    padding: clamp(1rem, 3vw, 2.2rem);
    margin-block-end: 1.75rem;
    border: 1px solid #315b66;
    border-radius: 1.05rem;
    background:
      radial-gradient(ellipse at 100% 110%, #3975759e, transparent 65%),
      linear-gradient(112deg, #122936, #16434b);
    color: #f0fafb;
  }
  .daily-hero h1 {
    font-size: clamp(1.75rem, 3vw, 2.45rem);
    margin: 0;
  }
  .daily-hero p {
    max-width: 58ch;
    margin: 0.45rem 0 0;
    color: #d7eaee;
  }
  .daily-hero nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-block-start: 0.85rem;
  }
  .daily-hero nav a {
    padding: 0.4rem 0.65rem;
    border: 1px solid #839fa7;
    border-radius: 0.48rem;
    background: #cce7e419;
    color: #f3fbfc;
    font-size: 0.86rem;
    text-underline-offset: 0.19em;
  }
  .daily-hero nav a:hover {
    background: #cce7e43b;
  }
  .daily-hero nav a:focus-visible {
    outline-color: #f0fafb;
  }
  .daily-hero-icon {
    display: grid;
    place-items: center;
    flex: none;
    height: clamp(2.15rem, 4vw, 3rem);
    width: clamp(2.15rem, 4vw, 3rem);
    border: 1px solid #83a9af;
    border-radius: 0.75rem;
    background: #cce7e419;
    color: #c4f1e9;
  }
  .daily-hero-icon :global(svg) {
    width: 60%;
    height: 60%;
  }
  .daily-directory {
    display: grid;
    gap: 1.6rem;
  }
  .daily-group {
    --daily-tint: #dceee9;
    --daily-accent: #245f61;
    min-width: 0;
    border-top: 1px solid var(--line);
  }
  .daily-group[data-group='depenses'] {
    --daily-tint: #f1e9da;
    --daily-accent: #72502d;
  }
  .daily-group[data-group='famille'] {
    --daily-tint: #e1ecf2;
    --daily-accent: #284e68;
  }
  .daily-group h2 {
    margin: 0.75rem 0 0.6rem;
    font-size: clamp(1.13rem, 3vw, 1.35rem);
  }
  .daily-tools {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .daily-group h2 {
    scroll-margin-top: 1rem;
  }
  .daily-tool {
    min-width: 0;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: start;
    gap: 0.65rem;
    padding: clamp(0.85rem, 2.5vw, 1.2rem);
    border: 1px solid var(--line);
    border-radius: 0.85rem;
    background: linear-gradient(135deg, var(--sheet) 45%, var(--daily-tint));
    box-shadow: 0 2px 6px #142e3610;
    color: var(--ink);
    text-decoration: none;
  }
  .daily-tool:hover,
  .daily-tool:focus-visible {
    border-color: var(--daily-accent);
    box-shadow: 0 3px 8px #142e361b;
  }
  .daily-tool:hover strong,
  .daily-tool:focus-visible strong {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
  .daily-tool > :global(svg) {
    margin-block-start: 0.7rem;
    color: var(--daily-accent);
    width: 1rem;
    height: 1rem;
  }
  .daily-icon {
    display: grid;
    place-items: center;
    inline-size: 2.25rem;
    block-size: 2.25rem;
    background: var(--daily-tint);
    color: var(--daily-accent);
    border-radius: 0.65rem;
  }
  .daily-icon :global(svg) {
    inline-size: 1.25rem;
    block-size: 1.25rem;
  }
  .daily-tool-text {
    display: grid;
    gap: 0.2rem;
    line-height: 1.4;
  }
  .daily-tool-text span {
    font-size: 0.88rem;
    color: var(--muted);
  }
  .daily-note {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-block: 1.15rem 1.75rem;
    font-size: 0.89rem;
    color: var(--muted);
  }
  .daily-note :global(svg) {
    width: 1rem;
    height: 1rem;
    flex: none;
  }
  .daily-retirement {
    margin-top: 1.4rem;
  }
  .cohort-options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.8rem 0;
  }
  .cohort-options a {
    padding: 0.65rem 0.8rem;
    border: 1px solid #91aab3;
    border-radius: 0.35rem;
    background: #f4f8f8;
  }
  @media (max-width: 900px) {
    .daily-tools {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 570px) {
    .daily-tools {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
