---
import Base from '../../layouts/Base.astro';
import SalaryCalculator from '../../components/SalaryCalculator.astro';
import Icon from '../../components/Icon.astro';
import comparison from '../../data/retirement-comparison.json';
import { retirementUrl } from '../../lib/retirement-comparison.mjs';
---

<Base
  title="Simuler l’électricité, la CSG et la retraite"
  section="/economie/simulateurs/"
  description="Simulez les taxes sur votre consommation d’électricité, la CSG sur votre salaire ou les règles de retraite de votre génération."
>
  <header class="page-title feature-title">
    <span class="feature-emblem">
      <Icon name="fiscalite" />
    </span>
    <div>
      <h1>Mon quotidien</h1>
      <p>
        Calculez les taxes sur l’électricité ou la CSG sur votre salaire.
        Consultez les règles de retraite par génération.
      </p>
    </div>
  </header>
  <nav class="daily-tools" aria-label="Les trois outils">
    <a href="/economie/simulateurs/electricite/">
      <Icon name="climat" /> Électricité
    </a>
    <a href="#calculer-csg">
      <Icon name="fiscalite" /> CSG sur le salaire
    </a>
    <a href="#sim-retraite">
      <Icon name="retraites" /> Retraite
    </a>
  </nav>
  <section class="power-link" aria-labelledby="sim-power">
    <h2 id="sim-power">Taxes sur votre électricité</h2>
    <p>
      Combien coûterait la même consommation avec une TVA ou une accise
      différente ? Trois propositions chiffrables sur vos kWh, au tarif Bleu du
      1er août 2026.
    </p>
  </section>
  <SalaryCalculator />
  <section class="panel" aria-labelledby="sim-retraite">
    <h2 id="sim-retraite">Retraite par génération</h2>
    <p>
      Choisissez votre période de naissance pour voir l’âge légal, les
      trimestres nécessaires et l’âge du taux plein dans le régime général, puis
      les propositions documentées.
    </p>
    <nav class="cohort-options" aria-label="Période de naissance">
      {comparison.cohorts.map((c) => (
        <a href={retirementUrl(c.id)}>{c.label}</a>
      ))}
    </nav>
  </section>
</Base>
<style>
  .daily-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.1rem;
    border-bottom: 1px solid var(--line);
  }
  .daily-tools a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: var(--target-size);
    color: var(--accent);
    font-weight: 625;
  }
  .power-link {
    padding-block: 1rem 1.2rem;
  }
  .power-link h2 {
    margin-top: 0;
  }
  .power-link p {
    max-width: 70ch;
  }
  .cohort-options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.8rem 0;
  }
  .cohort-options a {
    padding: 0.65rem 0.8rem;
    border: 1px solid #91aab3;
    border-radius: 0.35rem;
    background: #f4f8f8;
  }
</style>
