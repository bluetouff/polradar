---
import Base from '../layouts/Base.astro';
import Filter from '../components/Filter.astro';
import Icon from '../components/Icon.astro';
import { sourceIcons } from '../lib/labels';
import { sources, sourceKinds, formatDate } from '../lib/data';
import PagedResults from '../components/PagedResults.astro';
import { pageRange } from '../lib/pagination';
interface Props {
  page?: number;
}
const { page = 1 } = Astro.props;
const range = pageRange(sources.length, page);
---

<Base title={page === 1 ? 'Sources' : `Sources · page ${page}`}>
  <header class="page-title">
    <h1>Sources</h1>
    <p>
      Documents de campagne, publications des partis, données publiques et
      presse.
    </p>
    <a class="inline-action" href="/documents/">
      Explorer les documents par candidature, thème ou auteur ↗
    </a>
  </header>
  <Filter
    target="sources-list"
    total={sources.length}
    label="Rechercher un document, un auteur ou un domaine"
  />
  <PagedResults total={sources.length} page={page} base="/sources/">
    <div class="sources-grid" id="sources-list">
      {sources.slice(range.start, range.end).map((source) => (
        <article class="source-card">
          <span class:list={['tag', { archive: source.kind === 'archive' }]}>
            <Icon name={sourceIcons[source.kind]} />
            {sourceKinds[source.kind]}
          </span>
          <h2>
            <a href={source.url} target="_blank" rel="noopener noreferrer">
              {source.title} ↗
            </a>
          </h2>
          <p>{new URL(source.url).hostname}</p>
          <dl>
            <div>
              <dt>Publication</dt>
              <dd>
                {source.published
                  ? formatDate(source.published)
                  : (source.publishedYear ?? formatDate(null))}
                {source.publicationReference && (
                  <a class="date-citation" href={source.publicationReference}>
                    {' '}
                    Notice de l’éditeur ↗
                  </a>
                )}
              </dd>
            </div>
            <div>
              <dt>Consultation</dt>
              <dd>{formatDate(source.checked)}</dd>
            </div>
            {source.updated && (
              <div>
                <dt>Mise à jour du document</dt>
                <dd>{formatDate(source.updated)}</dd>
              </div>
            )}
          </dl>
          {source.previousUrl && (
            <details>
              <summary>Référence précédente</summary>
              <a
                href={source.previousUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                {new URL(source.previousUrl).hostname} ↗
              </a>
            </details>
          )}
        </article>
      ))}
    </div>
  </PagedResults>
  <script src="../scripts/directories.ts"></script>
</Base>
