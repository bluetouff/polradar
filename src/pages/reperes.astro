---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import '../styles/questions.css';
import SourceLinks from '../components/SourceLinks.astro';
import { events, formatDate } from '../lib/data';
---

<Base
  title="Présidentielle 2027 : calendrier électoral et démarches"
  description="Suivez les étapes du scrutin et de validation des candidatures. Retrouvez les démarches pour vérifier votre inscription, trouver votre bureau et voter par procuration."
>
  <header class="page-title">
    <h1>Calendrier électoral</h1>
    <p>Dates du scrutin et étapes de validation des candidatures.</p>
  </header>
  <section class="q-coverage" id="voter">
    <h2>Préparer mon vote</h2>
    <div class="q-answers">
      <article class="q-answer">
        <header>
          <Icon name="map-pin" />
          <h3>Trouver mon bureau</h3>
        </header>
        <p>
          Service Public permet de vérifier son inscription, l’adresse de son
          bureau de vote et son numéro national d’électeur.
        </p>
        <a href="https://www.service-public.gouv.fr/particuliers/vosdroits/R51788">
          Vérifier mon inscription ↗
        </a>
      </article>
      <article class="q-answer">
        <header>
          <Icon name="vote" />
          <h3>Faire une procuration</h3>
        </header>
        <p>
          Munissez-vous des informations de la personne qui votera pour vous. Le
          service du ministère de l’Intérieur indique comment faire vérifier
          votre identité.
        </p>
        <a href="https://www.maprocuration.gouv.fr/">
          Accéder à MaProcuration ↗
        </a>
      </article>
      <article class="q-answer">
        <header>
          <Icon name="source" />
          <h3>Quels papiers présenter ?</h3>
        </header>
        <p>
          La liste des justificatifs dépend du lieu où vous votez. Service
          Public détaille les documents acceptés en France et à l’étranger.
        </p>
        <a href="https://www.service-public.gouv.fr/particuliers/vosdroits/F1361">
          Consulter les justificatifs acceptés ↗
        </a>
      </article>
    </div>
  </section>
  <div class="three-col section-space">
    <article class="panel">
      <p class="eyebrow">01</p>
      <h2>Se déclarer</h2>
      <p>
        Une personne annonce son intention de concourir. La déclaration lance
        une campagne ; elle ne constitue pas une admission au scrutin.
      </p>
    </article>
    <article class="panel">
      <p class="eyebrow">02</p>
      <h2>Être investi</h2>
      <p>
        Un parti ou une primaire désigne la personne qui portera ses couleurs.
        Cette étape doit être distinguée de la validation de la candidature.
      </p>
    </article>
    <article class="panel">
      <p class="eyebrow">03</p>
      <h2>Être admis</h2>
      <p>
        Le Conseil constitutionnel établit la liste officielle des candidatures.
        Les conditions de présentation relèvent du cadre électoral.
      </p>
      <SourceLinks ids={['cc']} compact />
    </article>
  </div>
  <section class="section-space">
    <div class="section-heading">
      <div>
        <h2>Dates du scrutin</h2>
      </div>
    </div>
    <div class="two-col">
      {events
        .filter((e) => e.kind === 'announced')
        .map((event) => (
          <article class="panel">
            <time class="eyebrow" datetime={event.date}>
              {formatDate(event.date)}
            </time>
            <h3>{event.title}</h3>
            <p>{event.description}</p>
            <SourceLinks ids={event.sources} compact />
          </article>
        ))}
    </div>
  </section>
</Base>
