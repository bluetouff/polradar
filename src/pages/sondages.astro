---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PollChart from '../components/PollChart.astro';
import PollPublicationDocuments from '../components/PollPublicationDocuments.astro';
import { pollEmbeds, legacyPollGraphics } from '../lib/poll-graphic.mjs';
import {
  documentedPolls as polls,
  sourceById,
  formatDate,
  type DocumentedPoll,
} from '../lib/data';
import {
  pollSeries,
  pollCoverage,
  pollColor,
  pollScoreLabel,
  rankedPollResults,
} from '../lib/features.mjs';
const catalog = pollEmbeds(polls);
const legacy = legacyPollGraphics(polls, catalog);
const currentSeries = new Map(catalog.map(({ id, latest }) => [latest.id, id]));
const groups = pollSeries(polls) as DocumentedPoll[][];
const initial = groups.find((rows) => rows[0].round === 'premier')!;
const latest = initial.at(-1)!;
const selected = rankedPollResults(latest)
  .filter((result) => result.percentage !== null)
  .map((row) => row.id);
const coverage = pollCoverage(polls, groups);
const { institutes } = coverage;
const surveyed = [
  ...new Map(
    polls.filter((p) => p.surveyId).map((p) => [p.surveyId, p]),
  ).values(),
].sort(
  (a, b) =>
    b.fieldworkEnd.localeCompare(a.fieldworkEnd) ||
    a.institute.localeCompare(b.institute, 'fr'),
);
---

<Base
  title="Sondages de la présidentielle 2027 par institut"
  description="Consultez les intentions de vote aux deux tours de la présidentielle 2027, par institut et scénario, avec les dates de terrain et les notices."
  section="/sondages/"
>
  <header class="page-title feature-title">
    <span class="feature-emblem">
      <Icon name="sondages" />
    </span>
    <div>
      <h1>Sondages</h1>
      <p>
        {coverage.documentedSurveys} enquêtes · {institutes.length} instituts.
        Résultats par tour et par scénario.
      </p>
    </div>
    <a class="button" href="/dossiers/sondages-les-scenarios-comptent/">
      <Icon name="source" />
      Méthode de lecture
    </a>
  </header>
  <nav class="section-switch" aria-label="Sondages et marchés">
    <a href="/sondages/" aria-current="page">
      Intentions de vote
    </a>
    <a href="/sondages/notices/">Notices de la Commission</a>
    <a href="/marches-predictifs/">
      Marchés prédictifs <span aria-hidden="true">↗</span>
    </a>
  </nav>
  <details id="poll-options" class="reader-options">
    <summary>Changer de tour, d’institut ou de scénario</summary>
    <form id="poll-filters" class="facet-filters">
      <label>
        Tour
        <select id="poll-round">
          <option value="premier">Premier tour</option>
          <option value="second">Second tour</option>
        </select>
      </label>
      <label>
        Institut
        <select id="poll-institute">
          <option value="">Tous les instituts</option>
          {institutes.map((name) => (
            <option value={name}>{name}</option>
          ))}
        </select>
      </label>
      <label class="wide-field">
        Scénario
        <select id="poll-scenario">
          {groups
            .filter((rows) => rows[0].round === 'premier')
            .map((rows) => (
              <option value={rows[0].id}>
                {rows[0].institute} · {rows[0].scenario}
              </option>
            ))}
        </select>
      </label>
    </form>
  </details>
  <section class="poll-workspace">
    <section class="poll-breakdown" aria-labelledby="poll-results-heading">
      <div class="register-heading">
        <h2 id="poll-results-heading" tabindex="-1">
          Intentions de vote
        </h2>
        <button type="button" class="button small" id="poll-export">
          <Icon name="download" />
          CSV
        </button>
        <button type="button" class="button small" id="poll-export-json">
          JSON
        </button>
      </div>
      <p id="poll-bar-date" class="poll-context">
        {latest.institute} · {latest.scenario}
        <br />
        Du {formatDate(latest.fieldworkStart)} au{' '}
        {formatDate(latest.fieldworkEnd)}
      </p>
      <div class="poll-reading-key">
        <span>% des intentions exprimées</span>
        <a
          id="poll-quick-source"
          href={
            sourceById(latest.noticeSource).url + '#page=' + latest.noticePage
          }
        >
          Notice de l’enquête ↗
        </a>
      </div>
      <div id="poll-bars">
        {rankedPollResults(latest).map((result) => (
          <div class="poll-bar-row">
            <span>{result.name}</span>
            <strong>{pollScoreLabel(result)}</strong>
            {result.percentage !== null && (
              <svg
                viewBox="0 0 300 8"
                preserveAspectRatio="none"
                aria-hidden="true"
              >
                <rect
                  class="poll-bar-track"
                  width="300"
                  height="6"
                  y="1"
                  rx="3"
                />
                <rect
                  class={`poll-bar-fill series-${pollColor(result.id)}`}
                  width={(result.percentage / 100) * 300}
                  height="6"
                  y="1"
                  rx="3"
                />
              </svg>
            )}
          </div>
        ))}
      </div>
      <p id="poll-no-intention" class="small muted">
        {latest.noIntention === null
          ? 'Part sans intention exprimée : non renseignée.'
          : `Sans intention exprimée : ${latest.noIntention.toLocaleString('fr-FR')} % ${latest.noIntentionNote || '(donnée distincte des pourcentages de candidats).'}`}
      </p>
      <a
        class="button small"
        id="poll-embed-link"
        hidden={latest.historicalImport}
        href={
          latest.historicalImport
            ? undefined
            : '/sondages/integrer/' + latest.id + '/'
        }
      >
        <Icon name="source" /> Intégrer ce graphique
      </a>
    </section>
    <div class="poll-trend">
      <div class="register-heading">
        <h2 id="poll-trend-heading">
          {initial.length > 1
            ? 'Évolution à scénario identique'
            : 'Une seule enquête pour ce scénario'}
        </h2>
        <span id="poll-wave-total" class="small muted">
          {initial.length} observation{initial.length > 1 ? 's' : ''}
        </span>
      </div>
      <div id="poll-plot">
        <PollChart rows={initial} selected={selected} />
      </div>
      <p class="small muted">Cochez un nom pour isoler ses résultats.</p>
      <div id="poll-legend" class="poll-legend">
        {latest.results.map((result) => (
          <label>
            <input type="checkbox" value={result.id} />
            <span class={`legend-color series-${pollColor(result.id)}`}></span>
            <span>{result.name}</span>
          </label>
        ))}
      </div>
      <div class="poll-wave-picker">
        <label for="poll-wave">
          <Icon name="clock" />
          Enquête du{' '}
          <strong id="poll-selected-date">
            {formatDate(latest.fieldworkEnd)}
          </strong>
        </label>
        <input
          id="poll-wave"
          type="range"
          min="0"
          max={initial.length - 1}
          value={initial.length - 1}
          step="1"
          aria-label="Choisir une vague de sondage"
        />
        <div>
          <span id="poll-first-date">
            {formatDate(initial[0].fieldworkEnd)}
          </span>
          <span id="poll-last-date">{formatDate(latest.fieldworkEnd)}</span>
        </div>
      </div>
      <p class="chart-caption">
        Les courbes relient uniquement des observations dont la question, la
        base de répondants et le scénario sont comparables au sein du même
        institut. L’axe horizontal correspond à la fin du terrain. Les marges
        publiées figurent dans la méthode ci-dessous.
      </p>
    </div>
  </section>
  <p id="poll-status" class="results-meta" role="status" aria-live="polite"></p>
  <details class="reader-options">
    <summary>Combien d’enquêtes et de scénarios ?</summary>
    <p>
      <a href="/sondages/notices/">
        Parcourir les notices de la Commission et leur état de traitement
      </a>
    </p>
    <p>
      {coverage.observations} observations datées ({coverage.firstRound} au
      premier tour, {coverage.secondRound} au second) · {coverage.series} séries
      · {institutes.length} instituts.
    </p>
    <p>
      {coverage.documentedSurveys} enquêtes identifiées · {coverage.notices}{' '}
      notices. Une même enquête peut tester plusieurs scénarios et les deux
      tours.
      {coverage.observationsWithoutSurvey > 0 && (
        <span>
          {' '}
          {coverage.observationsWithoutSurvey} observations restent à rattacher
          à une enquête.
        </span>
      )}
    </p>
  </details>
  <section id="poll-method" class="poll-method section-space">
    <div class="register-heading">
      <h2>Enquête et méthode</h2>
      <a
        href={`${sourceById(latest.noticeSource).url}#page=${latest.noticePage}`}
        target="_blank"
        rel="noopener noreferrer"
      >
        Notice officielle, page {latest.noticePage} ↗
      </a>
    </div>
    {latest.resultSource && (
      <p>
        <a
          href={`${sourceById(latest.resultSource).url}#page=${latest.resultPage}`}
          target="_blank"
          rel="noopener noreferrer"
        >
          Résultats de l’institut, page {latest.resultPage} ↗
        </a>
      </p>
    )}
    {latest.question?.status === 'verifiee' ? (
      <p class="poll-question">
        <strong>Question posée</strong> · « {latest.question.wording} »<br />
        {latest.question.base}{' '}
        <a
          href={
            sourceById(latest.question.sourceId).url +
            '#page=' +
            latest.question.page
          }
        >
          Questionnaire, p. {latest.question.page}
        </a>{' '}
        · Vérifié le {formatDate(latest.question.checked)}.
      </p>
    ) : (
      <p>
        Libellé original à vérifier. Cette observation reste affichée seule.
      </p>
    )}
    <dl class="poll-method-grid">
      <div>
        <dt>Institut / commanditaire</dt>
        <dd>
          {latest.institute} / {latest.commissioner}
        </dd>
      </div>
      <div>
        <dt>Terrain</dt>
        <dd>
          Du {formatDate(latest.fieldworkStart)} au{' '}
          {formatDate(latest.fieldworkEnd)}
        </dd>
      </div>
      <div>
        <dt>Date de référence de l’enquête</dt>
        <dd>{formatDate(latest.published)}</dd>
      </div>
      <div>
        <dt>Première diffusion</dt>
        <dd>
          {latest.firstPublication.status === 'verifiee' ? (
            <>
              {latest.firstPublication.media} ·{' '}
              {formatDate(latest.firstPublication.date)}
              {latest.firstPublication.localTime
                ? ' à ' + latest.firstPublication.localTime
                : ''}{' '}
              <a href={latest.firstPublication.sourceUrl} rel="noreferrer">
                Notice, p. {latest.firstPublication.page}
              </a>
            </>
          ) : (
            'Média et date non établis.'
          )}
        </dd>
      </div>
      {latest.publicationDocuments.length > 0 && (
        <div>
          <dt>Publications retrouvées</dt>
          <dd>
            <PollPublicationDocuments documents={latest.publicationDocuments} />
          </dd>
        </div>
      )}
      <div>
        <dt>Échantillon global</dt>
        <dd>
          {latest.sampleSize.toLocaleString('fr-FR')} personnes, dont{' '}
          {latest.registeredSample.toLocaleString('fr-FR')} inscrits
        </dd>
      </div>
      <div>
        <dt>Effectif utile exprimé</dt>
        <dd>
          {latest.usefulSample?.toLocaleString('fr-FR') ||
            'Non précisé pour cette question'}
        </dd>
      </div>
      <div>
        <dt>Collecte et population</dt>
        <dd>
          {latest.method} {latest.population}
        </dd>
      </div>
    </dl>
    <p>
      {latest.uncertainty}{' '}
      {latest.margin.confidence === null
        ? 'Niveau de confiance non précisé.'
        : `Niveau de confiance indiqué : ${latest.margin.confidence} %.`}
    </p>
  </section>
  <details class="reader-options" id="publications-enquetes">
    <summary>Publications par enquête ({surveyed.length})</summary>
    <ul class="poll-publication-register">
      {surveyed.map((p) => (
        <li data-survey={p.surveyId}>
          <h3>
            {p.institute} · {p.commissioner}
          </h3>
          <p>
            Terrain du {formatDate(p.fieldworkStart)} au{' '}
            {formatDate(p.fieldworkEnd)}.
          </p>
          {p.firstPublication.status === 'verifiee' ? (
            <p>
              Première diffusion ·{' '}
              <a href={p.firstPublication.sourceUrl}>
                {p.firstPublication.media}
              </a>{' '}
              · {formatDate(p.firstPublication.date)}
              {p.firstPublication.localTime &&
                ' à ' + p.firstPublication.localTime}
              .
            </p>
          ) : (
            <p>Première diffusion non établie.</p>
          )}
          {p.publicationDocuments.length > 0 && (
            <PollPublicationDocuments documents={p.publicationDocuments} />
          )}
        </li>
      ))}
    </ul>
  </details>
  <details class="poll-notices section-space">
    <summary>Notices et scénarios intégrés</summary>
    <ul>
      {legacy.map(({ id, latest }) => (
        <li id={id} data-vague={latest.id}>
          <a href={'/sondages/#enquete=' + latest.id}>
            Ancienne série · {latest.institute} · {latest.scenario} ·{' '}
            {formatDate(latest.fieldworkEnd)}
          </a>
        </li>
      ))}
      {polls.map((poll) => (
        <li id={`enquete-${poll.id}`}>
          <span
            id={currentSeries.get(poll.id)}
            data-vague={currentSeries.has(poll.id) ? poll.id : undefined}
          >
            {poll.institute} · {formatDate(poll.published)} · {poll.scenario}
          </span>
          <a
            href={`${sourceById(poll.noticeSource).url}#page=${poll.noticePage}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            Notice, page {poll.noticePage} ↗
          </a>
          {poll.historicalImport ? (
            <a href={'#enquete=' + poll.id}>Afficher ce scénario</a>
          ) : (
            <a href={'/sondages/integrer/' + poll.id + '/'}>
              Intégrer la vague
            </a>
          )}
        </li>
      ))}
    </ul>
  </details>
  <noscript>
    <p class="notice">
      Le graphique initial, les résultats et les notices restent lisibles. Les
      filtres nécessitent JavaScript.
    </p>
  </noscript>
  <script src="../scripts/polls.ts"></script>
</Base>

<style is:global>
  .poll-document-links,
  .poll-publication-register {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .poll-document-links {
    display: grid;
    gap: 0.55rem;
  }
  .poll-document-links a,
  .poll-document-links span {
    display: block;
  }
  .poll-document-links span,
  .poll-publication-register p {
    color: var(--muted);
  }
  .poll-publication-register {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: 0.8rem;
    margin-top: 1rem;
  }
  .poll-publication-register > li {
    border: 1px solid var(--line);
    border-radius: 0.55rem;
    padding: 1rem;
    background: var(--paper);
  }
  .poll-publication-register h3 {
    margin: 0;
    font-size: 1rem;
  }
  .poll-publication-register p {
    margin: 0.5rem 0;
  }
</style>
