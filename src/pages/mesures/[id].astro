---
import { readFileSync } from 'node:fs';
import {
  collectiveLabel,
  unspecifiedCollective,
  documentCredit,
} from '../../lib/attribution.mjs';
import Base from '../../layouts/Base.astro';
import ArticleAside from '../../components/ArticleAside.astro';
import Icon from '../../components/Icon.astro';
import FollowButton from '../../components/FollowButton.astro';
import MeasureVotes from '../../components/MeasureVotes.astro';
import EvidenceLinks from '../../components/EvidenceLinks.astro';
import { relationsFor } from '../../lib/documentary-relations';
import { budgetById, budgetIdsByMeasure } from '../../lib/visual-data';
import { formatBudgetAmount } from '../../lib/campaign-visuals-view.mjs';
import { questionsForMeasure } from '../../lib/questions';
import { proposalTracks } from '../../lib/proposal-data';
import { voteCases } from '../../lib/votes-data';
import '../../styles/measure-page.css';
import {
  measures,
  measureVersions,
  candidateById,
  themeById,
  sourceById,
  formatDate,
  scopes,
} from '../../lib/data';
export function getStaticPaths() {
  const ids: Set<string> | null =
    import.meta.env.PROD && process.env.POLRADAR_FILTER_MEASURES === '1'
      ? new Set(
          JSON.parse(readFileSync('.cache/polradar-pages/render.json', 'utf8')),
        )
      : null;
  return measures
    .filter((m) => !ids || ids.has(m.id))
    .map((measure) => ({
      params: { id: measure.id },
      props: { measure },
    }));
}
const { measure } = Astro.props;
const linkedBudgets = (budgetIdsByMeasure.get(measure.id) ?? []).map((id) =>
  budgetById.get(id)!,
);
const fields = [
  { label: 'Bénéficiaires', icon: 'people', value: measure.beneficiaries },
  { label: 'Calendrier annoncé', icon: 'clock', value: measure.timing },
  { label: 'Financement annoncé', icon: 'euro', value: measure.financing },
];
const unspecified = fields
  .filter((f) => !f.value)
  .map((f) => f.label.toLocaleLowerCase('fr'));
const collective = collectiveLabel(measure);
const voteRecords = voteCases.filter(
  (record) => record.measureId === measure.id,
);
const candidate = candidateById(measure.candidate),
  theme = themeById(measure.theme),
  versions = measureVersions(measure.id);
const versionIds = versions.map(({ id }) => id);
const proofRelations = relationsFor(versionIds);
const related = [
  ...questionsForMeasure(measure.id).map((question) => ({
    href: question.href,
    label: question.title,
    icon: 'exchange',
  })),
  {
    href: `/comparer/?theme=${theme.id}&c=${candidate.id}`,
    label: 'Comparer sur ce thème',
    icon: 'layers',
  },
  {
    href: `/engagements/${measure.parentId}/`,
    label: 'Fiche thématique d’origine',
    icon: 'source',
  },
  {
    href: `/rss/candidats/${candidate.id}.xml`,
    label: 'Flux du candidat',
    icon: 'rss',
  },
];
---

<Base
  title={`${measure.title} : ${collective ?? candidate.name}`}
  description={measure.description}
  lastModified={versions.at(-1)?.recordedAt ?? undefined}
  section="/mesures/"
>
  <div class="breadcrumbs">
    <a href="/mesures/">Mesures</a>
    <span>/</span>
    {collective ? (
      <span>{collective}</span>
    ) : (
      <a href={`/candidats/${candidate.id}/`}>{candidate.name}</a>
    )}
    <span>/</span>
    <a href={`/themes/${theme.id}/`}>{theme.label}</a>
  </div>
  <header class="page-title measure-hero editorial-corner">
    <span class="measure-emblem" aria-hidden="true">
      <Icon name={theme.id} />
    </span>
    <div class="measure-hero-text">
      <p class="measure-meta">
        {collective ?? candidate.name}{' '}
        <span class:list={['tag', { archive: measure.scope === 'archive' }]}>
          {scopes[measure.scope]}
          {!collective &&
            candidate.withdrawnOn &&
            measure.scope !== 'archive' &&
            ' · candidature retirée le ' + formatDate(candidate.withdrawnOn)}
        </span>
      </p>
      <h1>{measure.title}</h1>
      {collective && (
        <p>
          {collective === unspecifiedCollective &&
            'L’auteur de la proposition reste à préciser. '}
          <a href={`/candidats/${candidate.id}/`}>
            Dossier de {candidate.name}
          </a>
        </p>
      )}
      <p>
        {measure.edition} · fiche vérifiée le {formatDate(measure.checked)}
      </p>
    </div>
  </header>
  <div class="measure-detail-layout">
    <article class="measure-record">
      <div class="measure-intro">
        <p class="measure-lead">{measure.description}</p>
        <nav class="measure-jumps" aria-label="Accès dans cette fiche">
          <a href="#sources">
            <Icon name="source" /> Références
          </a>
          {proofRelations.length > 0 && (
            <a href="#preuves">
              <Icon name="layers" /> Explorer le dossier de preuves
            </a>
          )}
          <a href="#actions-fiche" class="measure-jump-actions">
            <Icon name="suivi" /> Suivi et hors ligne
          </a>
        </nav>
        {unspecified.length > 0 && (
          <p class="measure-missing">
            Informations non renseignées dans cette fiche ·{' '}
            {unspecified.join(', ')}.
          </p>
        )}
        {measure.scope === 'archive' && (
          <p class="archive-warning">Archive du programme de 2022.</p>
        )}
      </div>
      {(measure.metrics.length > 0 || measure.amounts.length > 0) && (
        <div class="measure-number-grid">
          {measure.metrics.map((metric) => (
            <div class:list={{ 'large-quantity': metric.value >= 100000 }}>
              <Icon name="sondages" />
              <span>{metric.label}</span>
              <strong>
                {metric.value.toLocaleString('fr-FR')}{' '}
                <small>{metric.unit}</small>
              </strong>
            </div>
          ))}
          {measure.amounts.map((amount) => (
            <div class:list={{ 'large-quantity': amount.value >= 100000 }}>
              <Icon name="euro" />
              <span>{amount.label}</span>
              <strong>
                {amount.value.toLocaleString('fr-FR')}{' '}
                <small>
                  {amount.unit} / {amount.period}
                </small>
              </strong>
              <p>{amount.basis === 'non-applicable' ? '' : amount.basis}</p>
            </div>
          ))}
        </div>
      )}
      {voteRecords.length > 0 && (
        <MeasureVotes records={voteRecords} revision={measure.revision} />
      )}
      {proposalTracks
        .filter((t) => t.measureIds.includes(measure.id))
        .map((t) => (
          <p class="notice">
            <a href={`/evolution/#dossier=${t.id}`}>
              Évolution de cette proposition dans les documents officiels ↗
            </a>
          </p>
        ))}
      {linkedBudgets.length > 0 && (
        <section class="measure-panel measure-budget">
          <div class="register-heading">
            <h2>Chiffrage documenté</h2>
            <Icon name="euro" />
          </div>
          <ul class="precise-sources">
            {linkedBudgets.map((b) => (
              <li>
                <a href={`/budget-programmes/#${b.id}`}>
                  {b.label} · {formatBudgetAmount(b)}
                </a>
                <p>
                  {b.estimator} · {b.horizon}
                </p>
                {b.targets
                  .filter((t) => t.measureId === measure.id)
                  .map((t) => (
                    <p>
                      Version {t.number} ·{' '}
                      {t.allocationPart && (
                        <>Poste « {t.allocationPart} » dans l’enveloppe. </>
                      )}
                      {t.locator}
                    </p>
                  ))}
                <p>{b.assumptions}</p>
              </li>
            ))}
          </ul>
        </section>
      )}
      {fields.some((f) => f.value) && (
        <dl class="measure-fields">
          {fields
            .filter((f) => f.value)
            .map((f) => (
              <div>
                <dt>
                  <Icon name={f.icon} />
                  {f.label}
                </dt>
                <dd>{f.value}</dd>
              </div>
            ))}
        </dl>
      )}
      <section
        class="measure-panel measure-references"
        aria-labelledby="sources"
      >
        <div class="register-heading">
          <h2 id="sources">Références</h2>
          <Icon name="source" />
        </div>
        <ul class="precise-sources">
          {measure.sourceRefs.map((ref) => {
            const source = sourceById(ref.sourceId);
            const credit = collective ? documentCredit(ref.sourceId) : null;
            return (
              <li>
                <a
                  href={
                    ref.fragment
                      ? source.url.split('#')[0] + '#' + ref.fragment
                      : source.url
                  }
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {source.title}
                  <Icon name="external" />
                </a>
                <p>{ref.locator}</p>
                {credit && (
                  <p>
                    Auteur du document · {credit.author}. {credit.locator}
                  </p>
                )}
                <div class="measure-source-meta">
                  {(source.published || source.publishedYear) && (
                    <span>
                      Publication du document ·{' '}
                      {source.published ? (
                        <time datetime={source.published}>
                          {formatDate(source.published)}
                        </time>
                      ) : (
                        source.publishedYear
                      )}
                      {source.publicationReference && (
                        <>
                          {' '}
                          ·{' '}
                          <a href={source.publicationReference}>
                            Notice de l’éditeur
                          </a>
                        </>
                      )}
                    </span>
                  )}
                  {source.updated && (
                    <span>
                      Mise à jour du document :{' '}
                      <time datetime={source.updated}>
                        {formatDate(source.updated)}
                      </time>
                    </span>
                  )}
                  <span>
                    Source consultée le{' '}
                    <time datetime={source.checked}>
                      {formatDate(source.checked)}
                    </time>
                  </span>
                </div>
              </li>
            );
          })}
        </ul>
      </section>
      <EvidenceLinks relations={proofRelations} perspectives={versionIds} />
      <section class="measure-panel measure-versions">
        <div class="register-heading">
          <h2>Versions de la fiche</h2>
          <a
            href={`/historique/?mesure=${measure.id}&mode=dates#comparaison-historique`}
            class="inline-action"
          >
            Comparer à deux dates ↗
          </a>
        </div>
        <ol class="version-timeline">
          {versions.map((version) => (
            <li id={`version-${version.number}`}>
              <span class="version-node" aria-hidden="true"></span>
              <div>
                <time datetime={version.observedOn}>
                  Relevé le {formatDate(version.observedOn)}
                </time>
                <h3>
                  Version {version.number} ·{' '}
                  {version.kind === 'import'
                    ? 'Reprise du corpus'
                    : version.kind === 'enrichissement'
                      ? 'Précisions éditoriales'
                      : version.kind === 'correction'
                        ? 'Correction'
                        : 'Évolution du programme'}
                </h3>
                <p>{version.summary}</p>
              </div>
              <a
                href={`/historique/?mesure=${measure.id}&apres=${version.number}`}
                aria-label={`Voir la version ${version.number}`}
              >
                <Icon name="arrow" />
              </a>
            </li>
          ))}
        </ol>
      </section>
    </article>
    <ArticleAside class="measure-side" links={related}>
      <section
        slot="actions"
        id="actions-fiche"
        class="measure-tools"
        aria-labelledby="measure-tools-title"
      >
        <h2 id="measure-tools-title">Suivre et conserver</h2>
        <FollowButton
          kind="candidate"
          id={candidate.id}
          name={candidate.name}
        />
        <FollowButton kind="theme" id={theme.id} name={theme.label} />
        <div
          class="measure-offline"
          data-offline-measure={measure.id}
          data-fiche-version={measure.revision}
          hidden
        >
          <button class="button" type="button">
            <Icon name="download" /> Garder hors ligne
          </button>
          <p class="small">Une seule fiche, sur cet appareil.</p>
          <p class="small" role="status"></p>
          <a href="/hors-ligne/v1/" hidden>
            Ouvrir la copie enregistrée ↗
          </a>
        </div>
      </section>
    </ArticleAside>
    <script is:inline type="module" src="/hors-ligne/lecteur-v1.js"></script>
  </div>
</Base>
