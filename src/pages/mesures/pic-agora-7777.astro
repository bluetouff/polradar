---
import Base from '../../layouts/Base.astro';
import { measureById } from '../../lib/data';
import { measureAliases } from '../../lib/measure-aliases.mjs';

const id = measureAliases.get('pic-agora-7777')!;
const measure = measureById(id);
const destination = `/mesures/${id}/`;
---

<Base
  title={measure.title}
  description="Retrouvez la proposition du PIC sur l’Agora et ses sources."
  canonicalPath={destination}
  section="/mesures/"
  noindex
>
  <meta slot="head" http-equiv="refresh" content={`0;url=${destination}`} />
  <h1>Agora tirée au sort</h1>
  <p>
    <a href={destination}>Consulter la proposition et ses sources</a>
  </p>
</Base>
