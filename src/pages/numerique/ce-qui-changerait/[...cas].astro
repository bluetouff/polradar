---
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import {
  digitalLawAsOf,
  digitalLawSections,
} from '../../../lib/digital-law-data';
import { formatDate, scopes } from '../../../lib/data';
import { digitalComparePath } from '../../../lib/digital-comparison.mjs';
import '../../../styles/digital-law.css';

export function getStaticPaths() {
  return digitalLawSections.flatMap((section) =>
    section.cases.map((item) => ({
      params: { cas: item.slug || undefined },
      props: { section, item },
    })),
  );
}

const { section, item } = Astro.props;
const changeNoun = item.positionOnly ? 'position' : 'proposition';
const changeHeading = item.changes.length
  ? item.positionOnly
    ? 'Positions sur le texte débattu'
    : 'Changements proposés'
  : item.parliament
    ? 'Parcours parlementaire'
    : 'Propositions recherchées';
---

<Base
  title={
    item.slug
      ? `${item.label} · Ce qui changerait`
      : 'Ce qui changerait dans le numérique'
  }
  description={item.context}
  section="/numerique/"
>
  <div class="breadcrumbs">
    <a href="/numerique/">Numérique</a>
    <span>/</span>
    <span>Ce qui changerait</span>
  </div>

  <header class="page-title feature-title digital-law-title">
    <span class="feature-emblem">
      <Icon name="exchange" />
    </span>
    <div>
      <h1 id="law-question">{item.question}</h1>
      <p>{item.context}</p>
      <a href="#autres-situations">Choisir une autre situation</a>
    </div>
  </header>

  <div class="digital-law">
    <section class="law-board" aria-labelledby="law-question">
      <nav class="law-jump" aria-label="Accès aux deux volets">
        <a href="#law-current">
          Droit en vigueur <Icon name="chevron" />
        </a>
        <a href="#law-next">
          {changeHeading} <Icon name="chevron" />
        </a>
      </nav>
      <div class="law-flow" data-branches={item.changes.length}>
        <section
          class="law-lane law-lane-current"
          aria-labelledby="law-current"
        >
          <header class="law-lane-heading">
            <h2 id="law-current">Droit en vigueur</h2>
            <time datetime={digitalLawAsOf}>
              Au {formatDate(digitalLawAsOf)}
            </time>
          </header>
          <div class="law-cards">
            {item.rules.map((rule) => (
              <article class="law-card">
                <h3>{rule.title}</h3>
                <p>{rule.body}</p>
                <footer>
                  {rule.refs.map((ref) => (
                    <a href={ref.url}>
                      <Icon name="source" />
                      {ref.label}
                    </a>
                  ))}
                </footer>
              </article>
            ))}
          </div>
        </section>

        <section class="law-lane law-lane-changes" aria-labelledby="law-next">
          <header class="law-lane-heading">
            <h2 id="law-next">{changeHeading}</h2>
            {item.changes.length > 0 && (
              <span>{`${item.changes.length} ${changeNoun}${item.changes.length > 1 ? 's' : ''}`}</span>
            )}
          </header>
          <div class="law-cards">
            {item.changes.map((change) => (
              <article class="law-card law-change">
                <div class="law-byline">
                  <span>{change.author}</span>
                  <span title={change.edition}>{scopes[change.scope]}</span>
                </div>
                <h3>{change.title}</h3>
                <p>{change.body}</p>
                {change.scope !== 'campagne' && <small>{change.edition}</small>}
                <footer>
                  {change.sources.map(({ source, locator }, index) => (
                    <a href={source.url} title={locator}>
                      <Icon name="source" />
                      {change.sources.length === 1
                        ? 'Texte officiel'
                        : `Texte officiel ${index + 1}`}
                    </a>
                  ))}
                  <a href={change.detailHref}>
                    <Icon name="historique" />
                    Fiche datée
                  </a>
                </footer>
              </article>
            ))}
            {item.contextMeasures.map((measure) => (
              <article class="law-card">
                <h3>
                  {item.id === 'signalement-cyber'
                    ? 'Signalement par les victimes'
                    : 'Protection des communications'}
                </h3>
                <p>
                  {measure.author} · <a href={measure.href}>{measure.title}</a>.
                </p>
                {item.id === 'signalement-cyber' && (
                  <p>
                    Ce projet de guichet concerne les victimes. Les délais de
                    notification des organismes relèvent des textes cités
                    ci-contre.
                  </p>
                )}
              </article>
            ))}
            {item.parliament && (
              <article class="law-card law-change law-parliament">
                {item.changes.length > 0 && <h3>Parcours parlementaire</h3>}
                <div class="law-byline">
                  <span>Projet de loi</span>
                  <span>Première lecture</span>
                </div>
                <h3>{item.parliament.title}</h3>
                <p>{item.parliament.body}</p>
                <footer>
                  {item.parliament.refs.map((ref) => (
                    <a href={ref.url}>
                      <Icon name="source" />
                      {ref.label}
                    </a>
                  ))}
                </footer>
                {item.parliament.stages && (
                  <ol class="law-stages" aria-label="Étapes parlementaires">
                    {item.parliament.stages.map((stage) => (
                      <li>
                        <time datetime={stage.date}>
                          {formatDate(stage.date)}
                        </time>
                        <span>{stage.label}</span>
                      </li>
                    ))}
                  </ol>
                )}
                {item.id === 'acces-communications' && (
                  <a
                    class="law-vote-link"
                    href="/numerique/comparer/chiffrement/#encryption-vote-title"
                  >
                    Voir le graphique du scrutin <Icon name="arrow" />
                  </a>
                )}
              </article>
            )}
          </div>
        </section>
      </div>
    </section>
    <section id="autres-situations" class="law-other">
      <h2>Explorer les autres situations</h2>
      <nav class="law-sections" aria-label="Thèmes du comparatif juridique">
        {digitalLawSections.map((entry) => (
          <a
            href={entry.cases[0].href}
            aria-current={entry.id === section.id ? 'true' : undefined}
          >
            <Icon name={entry.icon} />
            <span>{entry.title}</span>
            <Icon name="arrow" class="law-nav-arrow" />
          </a>
        ))}
      </nav>

      <nav class="law-cases" aria-label={`Situations · ${section.title}`}>
        {section.cases.map((entry) => (
          <a
            href={entry.href}
            aria-current={entry.id === item.id ? 'page' : undefined}
          >
            <Icon name={entry.icon} />
            {entry.label}
          </a>
        ))}
      </nav>
    </section>
    <nav class="law-related" aria-label="Autres comparatifs">
      <a href="/numerique/candidats/">
        <Icon name="people" /> Le numérique par candidat <Icon name="arrow" />
      </a>
      <a href="/numerique/protection/">
        <Icon name="securite" />
        Dossier données et protection <Icon name="arrow" />
      </a>
      <a
        href={digitalComparePath(
          ['donnees-personnelles', 'services-publics'].includes(section.id)
            ? 'souverainete'
            : section.id,
        )}
      >
        <Icon name="exchange" />
        Comparatif des programmes <Icon name="arrow" />
      </a>
      <a href="/comparer/retraites/">
        <Icon name="historique" />
        Ce qui changerait pour les retraites <Icon name="arrow" />
      </a>
    </nav>
  </div>
</Base>
