---
import Base from '../../layouts/Base.astro';
import MeasureCard from '../../components/MeasureCard.astro';
import MetricPlot from '../../components/MetricPlot.astro';
import FollowButton from '../../components/FollowButton.astro';
import Icon from '../../components/Icon.astro';
import { themes, measures } from '../../lib/data';
export function getStaticPaths() {
  return themes.map((theme) => ({
    params: { id: theme.id },
    props: { theme },
  }));
}
const { theme } = Astro.props;
const records = measures.filter(
  (e) => e.theme === theme.id && e.scope !== 'archive',
);
---

<Base title={`${theme.label} : les propositions`} description={theme.note}>
  <div class="breadcrumbs">
    <a href="/themes/">Enjeux</a>
    <span>/</span>
    <span>{theme.label}</span>
  </div>
  <header class="page-title feature-title">
    <span class="feature-emblem">
      <Icon name={theme.id} />
    </span>
    <div>
      <h1>{theme.label}</h1>
      <p>{theme.note}</p>
      <div class="feature-actions">
        <a class="button primary" href={`/comparer/?theme=${theme.id}`}>
          Comparer les candidatures sur ce sujet ↗
        </a>
        <FollowButton kind="theme" id={theme.id} name={theme.label} />
      </div>
    </div>
  </header>
  <MetricPlot measures={records} />
  <div class="measure-list">
    {records.map((item) => (
      <MeasureCard measure={item} showAuthor />
    ))}
  </div>
  <aside class="notice section-space">
    <p>
      Ces fiches reflètent les documents intégrés au corpus. L’absence d’une
      candidature sur cette page ne signifie pas qu’elle n’a pas de proposition
      sur ce sujet.
    </p>
    <a href="/candidats/">Consulter tous les dossiers ↗</a>
  </aside>
</Base>
