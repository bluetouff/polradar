---
import Base from '../../layouts/Base.astro';
import MeasureCard from '../../components/MeasureCard.astro';
import MetricPlot from '../../components/MetricPlot.astro';
import FollowButton from '../../components/FollowButton.astro';
import Icon from '../../components/Icon.astro';
import { themes, measures } from '../../lib/data';
import PagedResults from '../../components/PagedResults.astro';
import { pageRange } from '../../lib/pagination';
import { retirementPath } from '../../lib/retirement-comparison.mjs';
import { questions } from '../../lib/questions';
interface Props {
  theme: (typeof themes)[number];
  page?: number;
}
export function getStaticPaths() {
  return themes.map((theme) => ({
    params: { id: theme.id },
    props: { theme },
  }));
}
const { theme, page = 1 } = Astro.props;
const records = measures.filter(
  (e) => e.theme === theme.id && e.scope !== 'archive',
);
const range = pageRange(records.length, page);
const retirementOverview = theme.id === 'retraites' && page === 1;
const selectedQuestions: Record<string, string[]> = {
  europe: ['aide-ukraine', 'france-otan', 'europe-participation-union'],
  climat: ['climat-production-nucleaire', 'climat-prix-energie'],
  travail: ['travail-salaire-minimum', 'travail-duree-travail'],
  sante: ['sante-installation-medecins', 'sante-remboursement-soins'],
  immigration: [
    'immigration-travail',
    'regroupement-familial',
    'regularisation-sejour',
  ],
  logement: [
    'logement-offre-bati',
    'logement-regulation-loyers',
    'logement-obligations-parc-social',
  ],
  fiscalite: ['fiscalite-csg-salaires', 'fiscalite-transmission-patrimoine'],
  education: ['salaires-enseignants', 'education-acces-etudes'],
  institutions: [
    'institutions-declenchement-referendum',
    'institutions-ecrire-constitution',
  ],
  securite: ['places-prison'],
  social: ['social-garde-jeunes-enfants', 'parents-isoles'],
};
const themeQuestions = (selectedQuestions[theme.id] ?? [])
  .map((id) => questions.find((question) => question.id === id))
  .filter((question) => question !== undefined);
const everydayTools: Record<string, { id: string; label: string }> = {
  fiscalite: { id: 'impot-sur-le-revenu', label: 'Calculer l’impôt au barème' },
  sante: {
    id: 'consultation-medicale',
    label: 'Calculer le reste à charge d’une consultation',
  },
  travail: { id: 'temps-de-travail', label: 'Simuler le temps de travail' },
};
const everydayTool = everydayTools[theme.id];
---

<Base
  title={
    retirementOverview
      ? 'Retraites : les propositions pour la présidentielle 2027'
      : `${theme.label} : les propositions${page > 1 ? ' · page ' + page : ''}`
  }
  description={
    retirementOverview
      ? 'Âge de départ, pensions et financement des retraites : retrouvez les propositions pour la présidentielle 2027 et les documents qui les étayent.'
      : theme.note
  }
>
  <div class="breadcrumbs">
    <a href="/themes/">Enjeux</a>
    <span>/</span>
    <span>{theme.label}</span>
  </div>
  <header class="page-title feature-title">
    <span class="feature-emblem">
      <Icon name={theme.id} />
    </span>
    <div>
      <h1>{theme.label}</h1>
      <p>{theme.note}</p>
      <div class="feature-actions">
        <a class="button primary" href={`/comparer/?theme=${theme.id}`}>
          Comparer les candidatures sur ce sujet ↗
        </a>
        <FollowButton kind="theme" id={theme.id} name={theme.label} />
      </div>
      {retirementOverview && (
        <nav class="feature-actions" aria-label="Approfondir les retraites">
          <a class="button" href="/dossiers/retraites-ages-et-conditions/">
            Dossier interactif sur les retraites ↗
          </a>
          <a class="button" href="/questions/retraites-conditions-depart/">
            Âge de départ et durée de cotisation ↗
          </a>
          <a class="button" href={retirementPath}>
            Programmes et droit en vigueur par génération ↗
          </a>
        </nav>
      )}
      {page === 1 && (themeQuestions.length > 0 || everydayTool) && (
        <nav
          class="feature-actions"
          aria-label={`Questions et outils · ${theme.label}`}
        >
          {themeQuestions.map((question) => (
            <a class="button" href={question.href}>
              {question.title}
            </a>
          ))}
          {everydayTool && (
            <a
              class="button"
              href={`/economie/simulateurs/${everydayTool.id}/`}
            >
              {everydayTool.label}
            </a>
          )}
        </nav>
      )}
    </div>
  </header>
  {page === 1 && <MetricPlot measures={records} />}
  <PagedResults
    base={`/themes/${theme.id}/`}
    total={records.length}
    page={page}
  >
    <div class="measure-list">
      {records.slice(range.start, range.end).map((item) => (
        <MeasureCard measure={item} showAuthor />
      ))}
    </div>
  </PagedResults>
  <aside class="notice section-space">
    <p>
      Ces fiches reflètent les documents intégrés au corpus. L’absence d’une
      candidature sur cette page ne signifie pas qu’elle n’a pas de proposition
      sur ce sujet.
    </p>
    <a href="/candidats/">Consulter tous les dossiers ↗</a>
  </aside>
</Base>
