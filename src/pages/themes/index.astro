---
import Base from '../../layouts/Base.astro';
import { themes, engagements } from '../../lib/data';
---

<Base title="Programmes par thème">
  <header class="page-title">
    <h1>Programmes par thème</h1>
    <p>Retraites, travail, fiscalité, climat et autres thèmes du corpus.</p>
  </header>
  <div class="topic-grid">
    {themes.map((theme, index) => (
      <a class="topic-card" href={`/themes/${theme.id}/`}>
        <span class="topic-number">{String(index + 1).padStart(2, '0')}</span>
        <div>
          <h2>{theme.label}</h2>
          <p>
            {theme.short} ·{' '}
            {
              engagements.filter(
                (e) => e.theme === theme.id && e.scope !== 'archive',
              ).length
            }{' '}
            fiches hors archives
          </p>
        </div>
        <span aria-hidden="true">↗</span>
      </a>
    ))}
  </div>
</Base>
