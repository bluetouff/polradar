---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { themes, measures } from '../../lib/data';

const counts = new Map<string, number>();
for (const measure of measures) {
  if (measure.scope !== 'archive')
    counts.set(measure.theme, (counts.get(measure.theme) ?? 0) + 1);
}
const maximum = Math.max(1, ...counts.values());
---

<Base
  title="Programmes de la présidentielle 2027 par thème"
  description="Explorez les propositions pour la présidentielle 2027 par thème : retraites, salaires, fiscalité, climat, santé et autres sujets documentés."
>
  <header class="page-title">
    <h1>Programmes par thème</h1>
    <p>Nombre de fiches hors archives par thème, à la même échelle.</p>
    <nav class="topic-strands" aria-label="Thèmes transversaux">
      <a class="inline-action" href="/numerique/">
        Propositions sur le numérique ↗
      </a>
      <a class="inline-action" href="/numerique/liberte-expression/">
        Liberté d’expression ↗
      </a>
    </nav>
  </header>
  <div class="topic-grid topic-atlas">
    {themes.map((theme) => (
      <a class="topic-card" href={`/themes/${theme.id}/`}>
        <div class="atlas-heading">
          <Icon name={theme.id} />
          <h2>{theme.label}</h2>
        </div>
        <p>{theme.short}</p>
        <span class="atlas-count">
          <b>{counts.get(theme.id) ?? 0}</b> fiches
        </span>
        <svg
          viewBox={`0 0 ${maximum} 4`}
          preserveAspectRatio="none"
          aria-hidden="true"
          focusable="false"
        >
          <rect class="atlas-track" width={maximum} height="4" />
          <rect
            class="atlas-value"
            width={counts.get(theme.id) ?? 0}
            height="4"
          />
        </svg>
      </a>
    ))}
  </div>
</Base>

<style>
  .topic-strands {
    display: flex;
    flex-wrap: wrap;
    column-gap: 1.2rem;
    row-gap: 0.35rem;
    margin-block-start: 0.55rem;
  }
</style>
