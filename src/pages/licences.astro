---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { sourceCommit } from '../../scripts/release-revision.mjs';
import { meta } from '../lib/data';
import { rights } from '../lib/licences.mjs';
const revision = sourceCommit ?? 'main';
---

<Base
  title="Licences et réutilisation"
  description="Les droits de reprise du code, de la base documentaire, des graphiques, des articles et du logo Polradar."
>
  <header class="page-title">
    <h1>Licences et réutilisation</h1>
    <p>
      Choisissez ce que vous voulez publier. Un graphique, ses données et le
      code qui le dessine ont chacun leur licence.
    </p>
  </header>
  <div class="uses">
    <section id="reprendre">
      <Icon name="sondages" />
      <h2>Reprendre un graphique ou un article</h2>
      <p>
        Créditez l’auteur indiqué ou Polradar, liez l’original et la licence CC
        BY 4.0, puis signalez vos modifications. La reprise commerciale est
        permise.
      </p>
      <p class="credit">
        Exemple de crédit · Graphique de Polradar, CC BY 4.0. Données et date
        selon la légende.
      </p>
      <a href="/licenses/CC-BY-4.0.txt">
        Licence intégrale <Icon name="arrow" />
      </a>
    </section>
    <section>
      <Icon name="layers" />
      <h2>Exploiter la base documentaire</h2>
      <p>
        Créditez la base originale et l’édition utilisée. Une base dérivée
        utilisée publiquement est soumise au partage à l’identique prévu par
        l’ODbL 1.0.
      </p>
      <p class="credit">
        Exemple de crédit · Base Polradar, ODbL 1.0, édition du [date]. Ajoutez
        le lien et vos éventuelles transformations.
      </p>
      <a href="/donnees/">
        Télécharger l’édition <Icon name="arrow" />
      </a>
    </section>
  </div>
  <section class="matrix">
    <h2>Licences par composant</h2>
    <dl>
      {rights.map((r) => (
        <div id={r.id}>
          <dt>
            <Icon name={r.icon} />
            {r.objet}
          </dt>
          <dd>
            {r.texte ? (
              <a rel="license" href={r.texte}>
                {r.licence}
              </a>
            ) : (
              r.licence
            )}
          </dd>
        </div>
      ))}
    </dl>
  </section>
  <section class="sources">
    <h2>Code, crédits et versions</h2>
    <p>
      Le code original du site, des services et des collecteurs est sous AGPL
      version 3 uniquement. Les utilisateurs d’une version modifiée accessible
      en réseau doivent pouvoir obtenir le code source correspondant. Le SDK et
      les exemples externes se trouvent dans le répertoire{' '}
      <code>integrations/</code>, avec leur notice MIT.
    </p>
    <p>
      Le nom, le logo et l’identité visuelle de Polradar sont réservés. Les
      programmes, photos de tiers, polices, notices de sondage et séries
      importées conservent les conditions de leurs producteurs. Les éditions
      déjà distribuées sous MIT conservent les droits accordés pour ces
      éditions.
    </p>
    <nav aria-label="Sources et textes des licences">
      <a href={meta.repository + '/tree/' + revision}>Code de cette édition</a>
      <a href={meta.repository + '/tree/' + revision + '/integrations'}>
        SDK et exemples
      </a>
      <a href="/credits-photos/">Crédits photos</a>
      <a href="/sources/">Producteurs</a>
      <a href="/licenses/ODbL-1.0.txt">ODbL intégrale</a>
      <a href="/licenses/polradar-legacy-MIT.txt">
        MIT des éditions antérieures
      </a>
      <a href="/licenses/REUTILISATION.txt">Télécharger la notice</a>
      <a href="/api/licences.json">Matrice JSON</a>
    </nav>
  </section>
</Base>
<style>
  .uses {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
    gap: 1rem;
  }
  .uses section {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: linear-gradient(120deg, #142c3a, #1f4854);
    color: #f3fbfc;
    padding: clamp(1.15rem, 2.3vw, 2rem);
    border-radius: 0.85rem;
    border: 1px solid #3f6770;
    display: grid;
    align-content: start;
  }
  .uses section:nth-child(2) {
    background: linear-gradient(120deg, #182f41, #304d61);
  }
  .uses section > ::global(.icon) {
    color: #acdce0;
    width: 2rem;
    height: 2rem;
  }
  .uses section::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(
      ellipse at 105% 1%,
      #a5e1dc28 0,
      transparent 55%
    );
  }
  .uses h2,
  .matrix h2,
  .sources h2 {
    font-size: clamp(1.12rem, 2vw, 1.32rem);
    line-height: 1.3;
  }
  .uses h2 {
    margin: 0.8rem 0 0.4rem;
    color: #fff;
  }
  .uses p,
  .sources p {
    margin: 0.35rem 0;
    line-height: 1.55;
    max-width: 68ch;
  }
  .uses .credit {
    padding-left: 0.8rem;
    border-left: 2px solid #8abdc2;
    margin: 0.8rem 0;
    color: #c5dfe2;
    font-size: 0.91rem;
  }
  .uses a {
    color: #dcf9fd;
    font-weight: 640;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-underline-offset: 0.2em;
    justify-self: start;
  }
  .matrix,
  .sources {
    margin-top: 1.5rem;
    background: var(--panel-gradient);
    border: 1px solid var(--line);
    border-radius: 0.8rem;
    padding: clamp(1rem, 2vw, 1.6rem);
  }
  .matrix h2,
  .sources h2 {
    margin: 0 0 0.6rem;
  }
  .matrix dl {
    margin: 0;
  }
  .matrix dl > div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    flex-wrap: wrap;
    padding: 0.72rem 0;
    border-top: 1px solid var(--line);
  }
  .matrix dt {
    display: flex;
    gap: 0.65rem;
    align-items: center;
    font-weight: 600;
  }
  .matrix dt :global(.icon) {
    color: var(--accent);
    flex-shrink: 0;
  }
  .matrix dd {
    margin: 0;
    font: 500 0.88rem/1.45 var(--mono);
    color: var(--ink);
  }
  .matrix a,
  .sources a {
    color: var(--ink);
    text-underline-offset: 0.2em;
  }
  .sources nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1.15rem;
    margin-top: 1rem;
  }
</style>
