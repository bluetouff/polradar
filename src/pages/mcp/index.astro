---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
const tools = [
  [
    'polradar_search',
    'Rechercher des propositions',
    'Filtrez par mots, thème, candidature ou type de proposition.',
    'mesures',
  ],
  [
    'polradar_measure',
    'Lire une fiche et ses sources',
    'Retrouvez le passage cité, l’auteur, l’édition et les chiffres documentés.',
    'source',
  ],
  [
    'polradar_candidates',
    'Consulter les candidatures',
    'Obtenez les noms, les statuts et leurs références. Les retraits sont consultables sur demande.',
    'people',
  ],
  [
    'polradar_corpus',
    'Compter les contenus',
    'Distinguez les mesures de campagne, les textes de parti, les orientations et les archives.',
    'donnees',
  ],
  [
    'polradar_donnees',
    'Lire les données de campagne',
    'Retrouvez les sondages, l’économie, les budgets, les marchés prédictifs et l’agenda avec les dates de chaque relevé.',
    'sondages',
  ],
  [
    'polradar_question',
    'Explorer les questions',
    'Consultez la matrice et les positions documentées.',
    'source',
  ],
  [
    'polradar_comparer',
    'Comparer les candidats',
    'Choisissez une question et deux à six candidats.',
    'mesures',
  ],
  [
    'polradar_votes',
    'Retrouver un vote',
    'Lisez le texte soumis au vote et la liste nominative.',
    'donnees',
  ],
  [
    'polradar_changements',
    'Consulter un avant et un après',
    'Choisissez les documents de programme ou les révisions de la rédaction.',
    'clock',
  ],
  [
    'polradar_territoires',
    'Consulter une commune',
    'Retrouvez son inventaire SRU et son accessibilité aux généralistes.',
    'donnees',
  ],
  [
    'polradar_methodologie',
    'Comprendre la méthode',
    'Vérifiez qui porte un texte et la signification des dates.',
    'source',
  ],
];
---

<Base
  title="Serveur MCP de Polradar"
  description="Interrogez les propositions et les sources de Polradar avec un client MCP. Accès public en lecture seule."
>
  <header class="page-title">
    <h1>Serveur MCP de Polradar</h1>
    <p>
      Consultez les propositions et leurs sources depuis un assistant compatible
      MCP.
    </p>
  </header>
  <section class="connection" aria-labelledby="connect">
    <div>
      <h2 id="connect">Connecter un client</h2>
      <p>
        Choisissez un serveur distant en HTTP (Streamable HTTP), puis collez
        cette adresse.
      </p>
      <code>https://polradar.fr/api/mcp</code>
    </div>
    <div class="access">
      <span>
        <Icon name="check" /> Lecture seule
      </span>
      <span>Accès public sans clé</span>
      <a href="/mcp/documentation/">Guide de consultation pour les agents ↗</a>
      <a href="/mcp/statistiques/">Voir l’activité du serveur ↗</a>
      <a href="https://mcp.tc/i/polradar" rel="external noreferrer">
        Configurer mon client avec MCP.tc ↗
      </a>
    </div>
  </section>
  <section aria-labelledby="tools">
    <h2 id="tools">Outils disponibles</h2>
    <ul class="mcp-directory" role="list">
      {tools.map(([name, title, description, icon]) => (
        <li>
          <Icon name={icon} />
          <h3>{title}</h3>
          <p>{description}</p>
          <code>{name}</code>
        </li>
      ))}
    </ul>
  </section>
</Base>
<style>
  .connection,
  .mcp-directory li {
    border: 1px solid var(--panel-edge);
    border-radius: var(--card-radius);
    padding: clamp(1rem, 2vw, 1.6rem);
  }
  .connection {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.15rem 2rem;
    background: var(--night-gradient);
    color: #f0f8f8;
    margin-block: 1rem 1.5rem;
  }
  .connection h2,
  .mcp-directory h3 {
    font-size: 1.12rem;
    margin: 0;
  }
  .connection p {
    color: #d3e2e6;
    line-height: 1.5;
    margin: 0.35rem 0 0.65rem;
  }
  .connection code {
    display: inline-block;
    background: #12313e;
    border: 1px solid #719593;
    color: #c7eee2;
    border-radius: 0.4rem;
    padding: 0.55rem 0.7rem;
    font: 0.95rem/1.5 var(--mono);
    overflow-wrap: anywhere;
    max-width: 100%;
    user-select: all;
  }
  .connection > div {
    min-width: 0;
  }
  .access {
    display: grid;
    gap: 0.4rem;
    color: #d3e2e6;
    font-size: 0.9rem;
  }
  .access span:first-child {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    color: #c0eadb;
    font-weight: 650;
  }
  .access a {
    color: #eef8f7;
  }
  .mcp-directory {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 0.8rem;
    padding: 0;
    margin: 0.8rem 0;
  }
  .mcp-directory li {
    display: grid;
    align-content: start;
    gap: 0.45rem;
    background: var(--panel-gradient);
    box-shadow: var(--panel-shadow);
  }
  .mcp-directory li :global(.icon) {
    color: var(--accent);
    width: 1.55rem;
    height: 1.55rem;
    margin-bottom: 0.25rem;
  }
  .mcp-directory p {
    color: var(--muted);
    margin: 0;
  }
  .mcp-directory code {
    font: 0.8rem/1.4 var(--mono);
    color: #315963;
    overflow-wrap: anywhere;
  }
</style>
