---
import { Image } from 'astro:assets';
import PagedResults from '../components/PagedResults.astro';
import Base from '../layouts/Base.astro';
import { candidates } from '../lib/data';
import { portraits, portraitFor } from '../lib/portraits';
import { portraitPermissions } from '../lib/portrait-schema.mjs';
import { portraitLinks } from '../lib/portrait-links.mjs';
import '../styles/candidates.css';
---

<Base title="Crédits photographiques" section="/candidats/">
  <header class="page-title">
    <h1>Crédits photographiques</h1>
    <p>
      {portraits.length} portraits. Chaque fiche indique la publication
      d’origine, le crédit disponible et le statut des droits de reproduction.
    </p>
  </header>
  <p class="section-description">
    Polradar héberge les images et les adapte aux vignettes. Les photographies
    conservent leurs droits propres. Une licence de réutilisation, lorsqu’elle
    est publiée, figure à côté de la source. L’année indiquée est celle du
    cliché lorsqu’elle est connue.
  </p>
  <PagedResults total={portraits.length}>
    <div class="photo-credit-list" data-document-list>
      {portraits.map((credit) => {
        const candidate = candidates.find(
          (row) => row.id === credit.candidate,
        )!;
        const portrait = portraitFor(candidate.id)!;
        const publication = portraitLinks[candidate.id];
        const permission = portraitPermissions.find(
          (item) => item.candidate === candidate.id,
        );
        return (
          <article data-page-item class="photo-credit-row" id={candidate.id}>
            <a href={`/candidats/${candidate.id}/`} aria-label={candidate.name}>
              {portrait.preserveOriginal ? (
                <img
                  src={portrait.image.src}
                  width={portrait.image.width}
                  height={portrait.image.height}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <Image
                  src={portrait.image}
                  alt=""
                  width={128}
                  format="avif"
                  quality={65}
                  loading="lazy"
                />
              )}
            </a>
            <div>
              <h2>{candidate.name}</h2>
              {credit.title && <p>{credit.title}</p>}
              <p>
                {credit.author}
                {credit.year && ` · ${credit.year}`}
              </p>
              {permission && <p>{permission.note}</p>}
              {publication?.contactNote && <p>{publication.contactNote}</p>}
              <p>
                <a
                  href={credit.sourceUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Source du portrait ↗
                </a>
                {credit.licenseUrl ? (
                  <a
                    href={credit.licenseUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {credit.license} ↗
                  </a>
                ) : (
                  <span>{credit.license}</span>
                )}
                {publication?.sourceUrl &&
                  publication.url !== credit.sourceUrl && (
                    <a
                      href={publication.url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {publication.label} ↗
                    </a>
                  )}
                {permission && permission.identityUrl !== credit.sourceUrl && (
                  <a
                    href={permission.identityUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Fiche officielle ↗
                  </a>
                )}
              </p>
            </div>
          </article>
        );
      })}
    </div>
  </PagedResults>
  <script src="../scripts/document-pages.ts"></script>
</Base>
