---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { candidates } from '../lib/data';
import { portraits, portraitFor } from '../lib/portraits';
import { portraitPermissions } from '../lib/portrait-schema.mjs';
import '../styles/candidates.css';
---

<Base title="Crédits photographiques" section="/candidats/">
  <header class="page-title">
    <h1>Crédits photographiques</h1>
    <p>
      {portraits.length} portraits avec leurs crédits et conditions de
      réutilisation. La date indiquée est celle du portrait, lorsqu’elle est
      renseignée par la source.
    </p>
  </header>
  <p class="section-description">
    Les photographies sont servies depuis Polradar. Elles sont redimensionnées
    et recadrées à l’affichage. Les licences ou autorisations indiquées
    s’appliquent aux images, indépendamment de la licence MIT du code. Leur
    présence ne constitue pas un soutien à Polradar.
  </p>
  <div class="photo-credit-list">
    {portraits.map((credit) => {
      const candidate = candidates.find((row) => row.id === credit.candidate)!;
      const portrait = portraitFor(candidate.id)!;
      const permission = portraitPermissions.find(
        (item) => item.candidate === candidate.id,
      );
      return (
        <article class="photo-credit-row" id={candidate.id}>
          <a href={`/candidats/${candidate.id}/`} aria-label={candidate.name}>
            {portrait.preserveOriginal ? (
              <img
                src={portrait.image.src}
                width={portrait.image.width}
                height={portrait.image.height}
                alt=""
                loading="lazy"
                decoding="async"
              />
            ) : (
              <Image
                src={portrait.image}
                alt=""
                width={130}
                format="webp"
                loading="lazy"
              />
            )}
          </a>
          <div>
            <h2>{candidate.name}</h2>
            {credit.title && <p>{credit.title}</p>}
            <p>
              {credit.author}
              {credit.year && ` · ${credit.year}`}
            </p>
            {permission && <p>{permission.note}</p>}
            <p>
              <a
                href={credit.sourceUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                Source du portrait ↗
              </a>
              <a
                href={credit.licenseUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                {credit.license} ↗
              </a>
              {permission && (
                <a
                  href={permission.identityUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Fiche officielle ↗
                </a>
              )}
            </p>
          </div>
        </article>
      );
    })}
  </div>
</Base>
