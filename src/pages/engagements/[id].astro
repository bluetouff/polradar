---
import {
  collectiveLabel,
  unspecifiedCollective,
} from '../../lib/attribution.mjs';
import Base from '../../layouts/Base.astro';
import ArticleAside from '../../components/ArticleAside.astro';
import SourceLinks from '../../components/SourceLinks.astro';
import MeasureCard from '../../components/MeasureCard.astro';
import {
  engagements,
  measures,
  candidateById,
  themeById,
  scopes,
  formatDate,
} from '../../lib/data';
export function getStaticPaths() {
  return engagements.map((item) => ({
    params: { id: item.id },
    props: { item },
  }));
}
const { item } = Astro.props;
const collective = collectiveLabel(item);
const candidate = candidateById(item.candidate);
const theme = themeById(item.theme);
---

<Base
  title={`${item.title} : ${collective ?? candidate.name}`}
  description={item.bullets[0]}
>
  <div class="breadcrumbs">
    <a href="/engagements/">Engagements</a>
    <span>/</span>
    <a href={`/themes/${theme.id}/`}>{theme.label}</a>
  </div>
  <header class="page-title article-title">
    <div class="card-meta">
      {collective ? (
        <strong>{collective}</strong>
      ) : (
        <a href={`/candidats/${candidate.id}/`}>{candidate.name}</a>
      )}
      <span class:list={['tag', { archive: item.scope === 'archive' }]}>
        {scopes[item.scope]}
      </span>
    </div>
    <h1>{item.title}</h1>
    {collective === unspecifiedCollective && (
      <p>L’auteur des propositions reste à préciser.</p>
    )}
    <p>
      {item.edition} · document consulté le {formatDate(item.checked)}
    </p>
  </header>
  <div class="article-layout">
    <article class="prose">
      <h2>Mesures de cette fiche</h2>
      <div class="measure-list">
        {measures
          .filter((measure) => measure.parentId === item.id)
          .map((measure) => (
            <MeasureCard measure={measure} />
          ))}
      </div>
      {item.note && (
        <aside class="notice">
          <strong>Précisions</strong>
          <p>{item.note}</p>
        </aside>
      )}
      {item.scope === 'archive' && (
        <p class="archive-warning">
          Cette fiche décrit un programme de 2022. Elle ne constitue pas la
          confirmation d’un engagement pour 2027.
        </p>
      )}
      <h2>Sources</h2>
      <SourceLinks ids={item.sources} />
      <h2>Historique</h2>
      <ol class="version-list">
        {item.history.map((version) => (
          <li>
            <time datetime={version.date}>{formatDate(version.date)}</time>
            <h3>{version.event}</h3>
            <p>{version.summary}</p>
          </li>
        ))}
      </ol>
    </article>
    <ArticleAside
      links={[
        {
          href: `/candidats/${candidate.id}/`,
          label: `Le dossier de ${candidate.name}`,
          icon: 'people',
        },
        {
          href: `/themes/${theme.id}/`,
          label: `${theme.label} : les propositions`,
          icon: theme.id,
        },
        {
          href: `/comparer/?theme=${theme.id}&c=${candidate.id}`,
          label: 'Comparer sur ce sujet',
          icon: 'exchange',
        },
      ]}
      correctionHref={`mailto:admin@toonux.com?subject=${encodeURIComponent(`Correction Polradar : ${item.id}`)}`}
    />
  </div>
</Base>
