---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { documentedPolls, meta, formatDate } from '../lib/data';
import {
  documentaryCounts as corpus,
  documentaryHealth as quality,
} from '../lib/documentary-health';
import { legislativeVotes } from '../lib/votes-data';
import HomeCover from '../components/HomeCover.astro';
import HomeSignals from '../components/HomeSignals.astro';
import HomeExplorers from '../components/HomeExplorers.astro';
import HomeEvidence from '../components/HomeEvidence.astro';

import BriefCards from '../components/BriefCards.astro';
import { campaignBriefs } from '../lib/briefs';
const briefs = await campaignBriefs();
const articles = (
  await getCollection('articles', ({ data }) => !data.draft)
).sort(
  (a, b) =>
    b.data.published.localeCompare(a.data.published) ||
    a.data.title.localeCompare(b.data.title, 'fr'),
);
const counts = corpus.themes.map(({ id, label, counts }) => ({
  id,
  label,
  count: counts.campagne + counts.parti + counts.orientation,
}));
const maxCount = Math.max(1, ...counts.map((theme) => theme.count));
const number = new Intl.NumberFormat('fr-FR');
const latestPoll = documentedPolls
  .slice()
  .sort((a, b) => b.fieldworkEnd.localeCompare(a.fieldworkEnd))[0];
const pollInstitutes = [
  ...new Set(
    documentedPolls
      .filter((poll) => poll.fieldworkEnd === latestPoll?.fieldworkEnd)
      .map((poll) => poll.institute),
  ),
].sort((a, b) => a.localeCompare(b, 'fr'));
const paths = [
  [
    '/comparer/',
    'exchange',
    'Comparer les candidats',
    'Par question ou par thème',
  ],
  [
    '/economie/simulateurs/',
    'fiscalite',
    'Mon quotidien',
    'Salaire, logement, transports et retraite',
  ],
  ['/sondages/', 'sondages', 'Les sondages', 'Enquêtes et scénarios'],
  ['/territoires/', 'map-pin', 'Ma commune', 'Données et résultats locaux'],
] as const;
const register = [
  [
    '/mesures/',
    corpus.proposals,
    'propositions de campagne ou de parti',
    'mesures',
  ],
  [
    '/candidats/',
    quality.candidates.total - quality.candidates.withdrawn,
    'candidats suivis',
    'people',
  ],
  ['/sources/', quality.sources.catalogue, 'sources au catalogue', 'source'],
  [
    '/votes/',
    legislativeVotes.ballots.length,
    'scrutins dans les dossiers',
    'vote',
  ],
  [
    '/sondages/',
    quality.polls.documentedSurveys,
    'enquêtes identifiées',
    'sondages',
  ],
] as const;
---

<Base
  title="Présidentielle 2027 : candidats, programmes et sondages"
  description="Suivez la présidentielle française de 2027. Retrouvez les candidats, comparez les programmes et consultez les sondages, le calendrier et les sources."
>
  <HomeCover />
  <nav class="home-choices" aria-label="Par où commencer">
    {paths.map(([url, icon, label, caption]) => (
      <a href={url}>
        <span class="choice-icon" aria-hidden="true">
          <Icon name={icon} />
        </span>
        <span>
          <strong>{label}</strong>
          <small>{caption}</small>
        </span>
        <Icon name="arrow" class="choice-arrow" />
      </a>
    ))}
  </nav>
  {briefs.length > 0 && (
    <section class="home-briefs" aria-labelledby="home-briefs-title">
      <div class="register-heading">
        <h2 id="home-briefs-title">Brèves de campagne</h2>
        <a class="inline-action" href="/breves/">
          Toutes les brèves ↗
        </a>
      </div>
      <BriefCards items={briefs.slice(0, 3)} lead />
    </section>
  )}
  <div class="home-changes">
    {latestPoll && (
      <div>
        <Icon name="sondages" />
        <p>
          <a href="/sondages/">
            <strong>Derniers terrains de sondage</strong>
          </a>
          <span>
            {pollInstitutes.join(', ')} · fin du terrain le{' '}
            <time datetime={latestPoll.fieldworkEnd}>
              {formatDate(latestPoll.fieldworkEnd)}
            </time>
          </span>
        </p>
      </div>
    )}
    <div>
      <Icon name="historique" />
      <p>
        <a href="/mises-a-jour/">
          <strong>Dernières mises à jour</strong>
        </a>
        <span>
          Propositions et documents actualisés le{' '}
          <time datetime={meta.corpusUpdated}>
            {formatDate(meta.corpusUpdated)}
          </time>
        </span>
      </p>
    </div>
    <div>
      <Icon name="vote" />
      <p>
        <a href="/reperes/#voter">
          <strong>Préparer mon vote</strong>
        </a>
        <span>Inscription, bureau de vote et procuration</span>
      </p>
    </div>
  </div>
  <section
    id="dossiers"
    class="home-dossiers"
    aria-labelledby="home-dossiers-title"
  >
    <div class="register-heading">
      <h2 id="home-dossiers-title">Décryptages</h2>
      <a href="/dossiers/" class="inline-action">
        Tous les décryptages ↗
      </a>
    </div>
    <div class="home-dossier-grid">
      {articles.slice(0, 3).map((article) => (
        <a href={`/dossiers/${article.id}/`}>
          <span class="dossier-icon" aria-hidden="true">
            <Icon name={article.data.themes[0] ?? 'source'} />
          </span>
          <span class="dossier-copy">
            <strong>{article.data.title}</strong>
            <small>{article.data.description}</small>
          </span>
          <Icon name="arrow" class="dossier-arrow" />
        </a>
      ))}
    </div>
  </section>
  <section class="home-corpus" aria-labelledby="home-corpus-title">
    <div class="register-heading">
      <h2 id="home-corpus-title">Le corpus en chiffres</h2>
      <a href="/statistiques/" class="inline-action">
        Statistiques du corpus ↗
      </a>
    </div>
    <nav class="cover-register" aria-label="Rubriques du corpus">
      {register.map(([url, count, label, icon]) => (
        <a href={url}>
          <Icon name={icon} />
          <strong>{number.format(count)}</strong>
          <span>{label}</span>
        </a>
      ))}
    </nav>
    <p>
      Polradar est un projet indépendant. <a href="/methode/">Méthode</a> ·{' '}
      <a href="/donnees/">Données ouvertes</a> ·{' '}
      <a href="/licences/">Licences du projet</a>
    </p>
  </section>
  <HomeSignals />
  <div class="home-layout">
    <HomeEvidence />
    <section class="programme-index" aria-labelledby="programme-index-title">
      <div class="register-heading">
        <h2 id="programme-index-title">Programmes par thème</h2>
        <a href="/comparer/" class="inline-action">
          Ouvrir le comparateur ↗
        </a>
      </div>
      <p class="register-note">
        Nombre de fiches recensées hors archives de 2022.{' '}
        <a href="/statistiques/">Le corpus en chiffres</a>
      </p>
      <div class="theme-register">
        {counts.map((theme) => (
          <a
            href={
              theme.id === 'retraites'
                ? '/themes/retraites/'
                : `/comparer/?theme=${theme.id}`
            }
          >
            <Icon name={theme.id} />
            <span class="theme-entry">
              <span>{theme.label}</span>
              <svg
                viewBox="0 0 100 5"
                preserveAspectRatio="none"
                aria-hidden="true"
              >
                <rect class="theme-track" width="100" height="5" />
                <rect
                  class="theme-fill"
                  width={(theme.count / maxCount) * 100}
                  height="5"
                />
              </svg>
            </span>
            <span class="theme-count" aria-label={`${theme.count} fiches`}>
              {theme.count}
            </span>
            <span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>
    <HomeExplorers />
  </div>
</Base>

<style>
  .home-choices {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(0.5rem, 1.2vw, 0.9rem);
    margin-block: 0.8rem clamp(1.8rem, 4vw, 3.1rem);
  }
  .home-choices a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.62rem;
    padding: clamp(0.65rem, 1.2vw, 1rem);
    min-height: 5.15rem;
    border: 1px solid #b8c7c7;
    border-radius: 0.85rem;
    background: linear-gradient(146deg, #fff, #ebf0ef);
    box-shadow: 0 8px 24px -21px #1e4652bd;
    color: var(--ink);
    text-decoration: none;
    line-height: 1.25;
  }
  .home-choices a:first-child {
    border-color: #a0bdb9;
    background: linear-gradient(142deg, #f2faf7, #dbebe5);
  }
  .home-choices a:nth-child(2) {
    border-color: #d4c8b9;
    background: linear-gradient(142deg, #fffdf8, #f2e8da);
  }
  .home-choices a:nth-child(3) {
    background: linear-gradient(142deg, #f9fcfd, #e3edf5);
  }
  .home-choices a:is(:hover, :focus-visible) {
    border-color: #5d8689;
  }
  .home-choices a:hover strong,
  .home-dossier-grid a:hover strong {
    text-decoration: underline;
  }
  .home-choices :global(.icon) {
    color: var(--accent);
    width: 1.2rem;
    height: 1.2rem;
  }
  .choice-icon,
  .dossier-icon {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border-radius: 0.7rem;
    background: #d6e9e6;
  }
  .home-choices a:nth-child(2) .choice-icon {
    background: #efddc7;
  }
  .home-choices a:nth-child(3) .choice-icon {
    background: #dce9f4;
  }
  .home-choices :global(.choice-arrow) {
    width: 0.82rem;
    height: 0.82rem;
  }
  .home-choices small {
    display: block;
    margin-top: 0.25rem;
    color: var(--muted);
    font-size: 0.78rem;
  }
  .home-briefs .register-heading {
    border: 0;
    padding-bottom: 0.65rem;
  }
  .home-briefs .register-heading h2,
  .home-dossiers .register-heading h2,
  .home-corpus .register-heading h2 {
    font-size: clamp(1.18rem, 2vw, 1.6rem);
    letter-spacing: -0.028em;
  }
  .home-changes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.6rem 0.8rem;
    margin-block: 0.85rem clamp(1.75rem, 3.8vw, 3.15rem);
  }
  .home-changes > div {
    display: flex;
    align-items: start;
    padding: 0.75rem 0.9rem;
    border: 1px solid #c5d1ce;
    border-radius: 0.7rem;
    background: #eaf0ec;
    gap: 0.65rem;
  }
  .home-changes :global(.icon) {
    flex: none;
    color: var(--accent);
    margin-top: 0.18rem;
  }
  .home-changes span {
    display: block;
    color: var(--muted);
    font-size: 0.84rem;
  }
  .home-corpus {
    margin-bottom: clamp(1.4rem, 3vw, 2.3rem);
  }
  .home-corpus .register-heading {
    border-bottom: 0;
  }
  .home-corpus > p {
    margin-top: 0.65rem;
    font-size: 0.83rem;
    color: var(--muted);
  }
  .cover-register {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) repeat(2, minmax(0, 1fr));
    gap: 0.6rem;
  }
  .cover-register a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-content: center;
    align-items: center;
    gap: 0.32rem 0.6rem;
    padding: 0.85rem 1rem;
    border: 1px solid #bbccc9;
    border-radius: 0.8rem;
    background: linear-gradient(135deg, #f7fbfa, #e6eee9);
    color: var(--ink);
    text-decoration: none;
    line-height: 1.15;
  }
  .cover-register a:first-child {
    grid-row: span 2;
    border-color: #315c64;
    background:
      radial-gradient(ellipse at 100% 5%, #367275, transparent 67%),
      linear-gradient(112deg, #16303f, #1c4a52);
    color: #f4fafb;
  }
  .cover-register a:is(:hover, :focus-visible) {
    border-color: #5d8588;
    text-decoration: underline;
  }
  .cover-register :global(.icon) {
    grid-row: 1 / 3;
    color: var(--accent);
    width: 1.35rem;
    height: 1.35rem;
  }
  .cover-register strong {
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    font-weight: 630;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .cover-register span {
    grid-column: 2;
    color: var(--muted);
    font-size: 0.84rem;
    line-height: 1.35;
  }
  .cover-register a:first-child strong {
    color: #f5fbfb;
    font-size: clamp(1.9rem, 3.8vw, 3.1rem);
    letter-spacing: -0.038em;
  }
  .cover-register a:first-child span,
  .cover-register a:first-child :global(.icon) {
    color: #d5efed;
  }
  .cover-register a:first-child :global(.icon) {
    width: 1.85rem;
    height: 1.85rem;
  }
  .home-layout {
    display: grid;
    min-width: 0;
    gap: clamp(1.35rem, 2.4vw, 2rem);
    margin-top: clamp(1.45rem, 2.7vw, 2.3rem);
  }
  .programme-index {
    align-self: start;
    min-width: 0;
  }
  .home-dossiers {
    margin-bottom: clamp(1.65rem, 3.5vw, 2.85rem);
  }
  .programme-index .register-heading,
  .home-dossiers .register-heading {
    border: 0;
    align-items: baseline;
  }
  .register-note {
    margin: 0 0 0.5rem;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .home-dossier-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.7rem;
  }
  .home-dossier-grid a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: start;
    gap: 0.65rem 0.75rem;
    padding: clamp(0.85rem, 1.75vw, 1.3rem);
    border: 1px solid #b6cbce;
    border-radius: 0.85rem;
    background: linear-gradient(145deg, #fff, #e6efee);
    box-shadow: 0 8px 24px -21px #1e4652a8;
    text-decoration: none;
  }
  .home-dossier-grid a:is(:hover, :focus-visible) {
    border-color: #628889;
  }
  .home-dossier-grid .dossier-arrow {
    grid-area: 1 / 3;
    align-self: center;
  }
  .dossier-icon,
  .home-dossier-grid :global(.dossier-arrow) {
    color: var(--accent);
  }
  .dossier-copy {
    display: grid;
    gap: 0.3rem;
    grid-column: 1 / -1;
  }
  .dossier-copy small {
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1.45;
  }
  .dossier-copy strong {
    font-size: 1.02rem;
    line-height: 1.28;
  }
  .theme-register :global(.theme-track) {
    fill: #dce4e0;
  }
  .theme-register :global(.theme-fill) {
    fill: var(--accent);
  }
  .home-layout :global(.home-explorers) {
    margin: 0;
  }
  @media (max-width: 920px) {
    .home-choices {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 700px) {
    .home-choices :global(.choice-arrow) {
      display: none;
    }
    .home-choices a {
      grid-template-columns: auto minmax(0, 1fr);
    }
    .home-dossier-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .home-dossier-grid .dossier-copy {
      grid-column: 2;
      grid-row: 1;
    }
  }
  @media (max-width: 580px) {
    .home-changes {
      grid-template-columns: minmax(0, 1fr);
    }
    .cover-register {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .cover-register a:first-child {
      grid-row: auto;
      grid-column: 1 / -1;
    }
    .cover-register a {
      padding: 0.7rem;
    }
    .home-choices a {
      gap: 0.4rem;
      padding: 0.6rem;
      grid-template-columns: minmax(0, 1fr);
      align-content: start;
      font-size: 0.86rem;
    }
    .choice-icon {
      width: 2rem;
      height: 2rem;
    }
  }
</style>
