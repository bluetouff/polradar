---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CandidateCard from '../components/CandidateCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import {
  candidates,
  themes,
  engagements,
  sources,
  meta,
  formatDate,
} from '../lib/data';
const articles = (
  await getCollection('articles', ({ data }) => !data.draft)
).sort((a, b) => Number(b.data.featured) - Number(a.data.featured));
---

<Base>
  <div class="page-dateline">
    <span class="eyebrow">L’observatoire de la présidentielle</span>
    <span>Édition du {formatDate(meta.edition)}</span>
  </div>
  <section class="home-hero">
    <div class="hero-editorial">
      <p class="kicker">
        <span></span>COMPRENDRE AVANT DE CHOISIR
      </p>
      <h1>
        Une campagne.
        <br />
        Des choix
        <br />
        <em>à éclairer.</em>
      </h1>
      <p class="hero-description">
        Ce qui est proposé. Ce que cela engage. Ce qui change.
        <br class="desktop-break" /> Un regard indépendant, document après
        document.
      </p>
      <div class="hero-actions">
        <a class="button primary" href="/comparer/">
          Comparer les propositions <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href="/methode/">
          Découvrir la méthode
        </a>
      </div>
    </div>
    <aside class="hero-feature">
      <div class="feature-top">
        <span class="eyebrow">À EXPLORER</span>
        <span class="tag inverse">Le fond de la campagne</span>
      </div>
      <div class="feature-diagram" aria-hidden="true">
        <svg viewBox="0 0 450 225">
          <g fill="none" stroke="currentColor">
            <circle cx="225" cy="112" r="93" />
            <circle cx="225" cy="112" r="62" />
            <circle cx="225" cy="112" r="31" />
            <path d="M35 112h380M225 5v214M150 190 300 35" />
            <path
              class="diagram-accent"
              d="M225 112 292 45A95 95 0 0 1 320 112Z"
            />
          </g>
          <circle cx="270" cy="67" r="6" fill="currentColor" />
        </svg>
      </div>
      <p class="eyebrow">LE COMPARATEUR</p>
      <h2>
        Un sujet.
        <br />
        Les différences.
      </h2>
      <p>
        Retraites, salaires, énergie : confronter les engagements et retrouver
        leurs sources.
      </p>
      <a class="feature-link" href="/comparer/">
        Choisir mon sujet <span aria-hidden="true">↗</span>
      </a>
    </aside>
  </section>
  <div class="evidence-strip">
    <div>
      <b>{candidates.length}</b>
      <span>
        candidatures
        <br />
        dans le corpus
      </span>
    </div>
    <div>
      <b>{themes.length}</b>
      <span>
        enjeux
        <br />à explorer
      </span>
    </div>
    <div>
      <b>{engagements.length}</b>
      <span>
        fiches
        <br />
        documentaires
      </span>
    </div>
    <div>
      <b>{sources.length}</b>
      <span>
        références
        <br />
        consultables
      </span>
    </div>
    <a href="/transparence/">Ce que couvrent ces chiffres ↗</a>
  </div>
  <section class="section-space">
    <div class="section-heading">
      <div>
        <p class="eyebrow">PRENDRE DU RECUL</p>
        <h2>Les clés pour lire la campagne.</h2>
      </div>
      <a class="text-link" href="/dossiers/">
        Tous les décryptages ↗
      </a>
    </div>
    <div class="article-grid">
      {articles.slice(0, 3).map((article, index) => (
        <ArticleCard article={article} index={index} />
      ))}
    </div>
  </section>
  <section class="section-space themes-home">
    <div class="section-heading">
      <div>
        <p class="eyebrow">LES SUJETS QUI COMPTENT</p>
        <h2>Entrer par les enjeux.</h2>
      </div>
      <a class="text-link" href="/themes/">
        Les {themes.length} thèmes ↗
      </a>
    </div>
    <div class="topic-grid">
      {themes.slice(0, 6).map((theme, index) => (
        <a class="topic-card" href={`/themes/${theme.id}/`}>
          <span class="topic-number">{String(index + 1).padStart(2, '0')}</span>
          <div>
            <h3>{theme.label}</h3>
            <p>{theme.short}</p>
          </div>
          <span aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>
  <section class="section-space">
    <div class="section-heading">
      <div>
        <p class="eyebrow">LES PERSONNES ET LEURS PROJETS</p>
        <h2>Ouvrir les dossiers.</h2>
      </div>
      <a class="text-link" href="/candidats/">
        Toutes les candidatures ↗
      </a>
    </div>
    <div class="candidate-grid">
      {candidates.slice(0, 3).map((candidate) => (
        <CandidateCard candidate={candidate} />
      ))}
    </div>
  </section>
  <section class="method-banner">
    <div>
      <p class="eyebrow">NOTRE ENGAGEMENT ÉDITORIAL</p>
      <h2>
        Une proposition mérite
        <br />
        mieux qu’une étiquette.
      </h2>
    </div>
    <div>
      <p>
        Chaque fiche distingue les documents de campagne, les orientations de
        parti et les archives. Les dates et les informations manquantes restent
        visibles.
      </p>
      <a class="button light" href="/sources/">
        Explorer les sources ↗
      </a>
    </div>
  </section>
</Base>
