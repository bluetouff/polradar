---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { documentedPolls, meta, formatDate } from '../lib/data';
import {
  documentaryCounts as corpus,
  documentaryHealth as quality,
} from '../lib/documentary-health';
import { legislativeVotes } from '../lib/votes-data';
import HomeCover from '../components/HomeCover.astro';
import HomeSignals from '../components/HomeSignals.astro';
import HomeExplorers from '../components/HomeExplorers.astro';
import HomeEvidence from '../components/HomeEvidence.astro';

import BriefCards from '../components/BriefCards.astro';
import { campaignBriefs } from '../lib/briefs';
const briefs = await campaignBriefs();
const articles = (
  await getCollection('articles', ({ data }) => !data.draft)
).sort(
  (a, b) =>
    b.data.published.localeCompare(a.data.published) ||
    a.data.title.localeCompare(b.data.title, 'fr'),
);
const counts = corpus.themes.map(({ id, label, counts }) => ({
  id,
  label,
  count: counts.campagne + counts.parti + counts.orientation,
}));
const maxCount = Math.max(1, ...counts.map((theme) => theme.count));
const number = new Intl.NumberFormat('fr-FR');
const latestPoll = documentedPolls
  .slice()
  .sort((a, b) => b.fieldworkEnd.localeCompare(a.fieldworkEnd))[0];
const pollInstitutes = [
  ...new Set(
    documentedPolls
      .filter((poll) => poll.fieldworkEnd === latestPoll?.fieldworkEnd)
      .map((poll) => poll.institute),
  ),
].sort((a, b) => a.localeCompare(b, 'fr'));
const paths = [
  [
    '/comparer/',
    'exchange',
    'Comparer les candidats',
    'Par question ou par thème',
  ],
  [
    '/economie/simulateurs/',
    'fiscalite',
    'Mon quotidien',
    'Retraite, CSG et électricité',
  ],
  ['/sondages/', 'sondages', 'Les sondages', 'Enquêtes et scénarios'],
  ['/territoires/', 'map-pin', 'Ma commune', 'Données et résultats locaux'],
] as const;
const register = [
  [
    '/candidats/',
    quality.candidates.total - quality.candidates.withdrawn,
    'candidats suivis',
  ],
  ['/mesures/', corpus.proposals, 'propositions de campagne ou de parti'],
  ['/sources/', quality.sources.catalogue, 'sources au catalogue'],
  ['/votes/', legislativeVotes.ballots.length, 'scrutins dans les dossiers'],
  ['/sondages/', quality.polls.documentedSurveys, 'enquêtes identifiées'],
] as const;
---

<Base
  title="Présidentielle 2027 : candidats, programmes et sondages"
  description="Suivez la présidentielle française de 2027. Retrouvez les candidats, comparez les programmes et consultez les sondages, le calendrier et les sources."
>
  <HomeCover />
  <nav class="home-choices" aria-label="Par où commencer">
    {paths.map(([url, icon, label, caption]) => (
      <a href={url}>
        <Icon name={icon} />
        <span>
          <strong>{label}</strong>
          <small>{caption}</small>
        </span>
        <Icon name="arrow" class="choice-arrow" />
      </a>
    ))}
  </nav>
  {briefs.length > 0 && (
    <section class="home-briefs" aria-labelledby="home-briefs-title">
      <div class="register-heading">
        <h2 id="home-briefs-title">Brèves de campagne</h2>
        <a class="inline-action" href="/breves/">
          Toutes les brèves ↗
        </a>
      </div>
      <BriefCards items={briefs.slice(0, 3)} lead />
    </section>
  )}
  <div class="home-changes">
    {latestPoll && (
      <div>
        <Icon name="sondages" />
        <p>
          <a href="/sondages/">
            <strong>Derniers terrains de sondage</strong>
          </a>
          <span>
            {pollInstitutes.join(', ')} · fin du terrain le{' '}
            <time datetime={latestPoll.fieldworkEnd}>
              {formatDate(latestPoll.fieldworkEnd)}
            </time>
          </span>
        </p>
      </div>
    )}
    <div>
      <Icon name="historique" />
      <p>
        <a href="/mises-a-jour/">
          <strong>Dernières mises à jour</strong>
        </a>
        <span>
          Propositions et documents actualisés le{' '}
          <time datetime={meta.corpusUpdated}>
            {formatDate(meta.corpusUpdated)}
          </time>
        </span>
      </p>
    </div>
    <div>
      <Icon name="vote" />
      <p>
        <a href="/reperes/#voter">
          <strong>Préparer mon vote</strong>
        </a>
        <span>Inscription, bureau de vote et procuration</span>
      </p>
    </div>
  </div>
  <section class="home-corpus" aria-labelledby="home-corpus-title">
    <div class="register-heading">
      <h2 id="home-corpus-title">Le corpus en chiffres</h2>
      <a href="/statistiques/" class="inline-action">
        Statistiques du corpus ↗
      </a>
    </div>
    <nav class="cover-register" aria-label="Accès rapides">
      {register.map(([url, count, label]) => (
        <a href={url}>
          <strong>{number.format(count)}</strong>
          <span>{label}</span>
        </a>
      ))}
    </nav>
    <p>
      Polradar est un projet indépendant. <a href="/methode/">Méthode</a> ·{' '}
      <a href="/donnees/">Données ouvertes</a> ·{' '}
      <a href="/licences/">Licences du projet</a>
    </p>
  </section>
  <HomeSignals />
  <div class="home-layout">
    <HomeEvidence />
    <section class="programme-index" aria-labelledby="programme-index-title">
      <div class="register-heading">
        <h2 id="programme-index-title">Programmes par thème</h2>
        <a href="/comparer/" class="inline-action">
          Ouvrir le comparateur ↗
        </a>
      </div>
      <p class="register-note">
        Nombre de fiches recensées hors archives de 2022.{' '}
        <a href="/statistiques/">Le corpus en chiffres</a>
      </p>
      <div class="theme-register">
        {counts.map((theme) => (
          <a
            href={
              theme.id === 'retraites'
                ? '/themes/retraites/'
                : `/comparer/?theme=${theme.id}`
            }
          >
            <Icon name={theme.id} />
            <span class="theme-entry">
              <span>{theme.label}</span>
              <svg
                viewBox="0 0 100 5"
                preserveAspectRatio="none"
                aria-hidden="true"
              >
                <rect class="theme-track" width="100" height="5" />
                <rect
                  class="theme-fill"
                  width={(theme.count / maxCount) * 100}
                  height="5"
                />
              </svg>
            </span>
            <span class="theme-count" aria-label={`${theme.count} fiches`}>
              {theme.count}
            </span>
            <span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>
    <section
      id="dossiers"
      class="home-dossiers"
      aria-labelledby="home-dossiers-title"
    >
      <div class="register-heading">
        <h2 id="home-dossiers-title">Derniers dossiers</h2>
        <a href="/dossiers/" class="inline-action">
          Tous les dossiers ↗
        </a>
      </div>
      <div class="home-dossier-grid">
        {articles.slice(0, 3).map((article) => (
          <a href={`/dossiers/${article.id}/`}>
            <span class="dossier-icon">
              <Icon name={article.data.themes[0] ?? 'source'} />
            </span>
            <span class="dossier-copy">
              <small>
                {article.data.category} <span aria-hidden="true">·</span>{' '}
                <time datetime={article.data.published}>
                  {formatDate(article.data.published)}
                </time>
              </small>
              <strong>{article.data.title}</strong>
            </span>
            <Icon name="arrow" class="dossier-arrow" />
          </a>
        ))}
      </div>
    </section>
    <HomeExplorers />
  </div>
</Base>

<style>
  .home-choices {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-block: 1px solid var(--line);
    margin-bottom: clamp(1.3rem, 2.4vw, 2.1rem);
  }
  .home-choices a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.65rem;
    padding: 0.85rem 0.75rem;
    min-height: 4.6rem;
    color: var(--ink);
    text-decoration: none;
    line-height: 1.25;
  }
  .home-choices a + a {
    border-inline-start: 1px solid var(--line);
  }
  .home-choices a:hover {
    background: var(--light);
  }
  .home-choices a:hover strong,
  .home-dossier-grid a:hover strong {
    text-decoration: underline;
  }
  .home-choices :global(.icon) {
    color: var(--accent);
    width: 1.2rem;
    height: 1.2rem;
  }
  .home-choices :global(.choice-arrow) {
    width: 0.82rem;
    height: 0.82rem;
  }
  .home-choices small {
    display: block;
    margin-top: 0.25rem;
    color: var(--muted);
    font-size: 0.78rem;
  }
  .home-briefs .register-heading {
    border: 0;
    padding-bottom: 0.65rem;
  }
  .home-changes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.6rem 1.3rem;
    margin-block: 1rem clamp(1.75rem, 3vw, 2.5rem);
  }
  .home-changes > div {
    display: flex;
    align-items: start;
    padding-top: 0.65rem;
    border-top: 1px solid var(--line);
    gap: 0.65rem;
  }
  .home-changes :global(.icon) {
    flex: none;
    color: var(--accent);
    margin-top: 0.18rem;
  }
  .home-changes span {
    display: block;
    color: var(--muted);
    font-size: 0.84rem;
  }
  .home-corpus {
    margin-bottom: clamp(1.4rem, 3vw, 2.3rem);
  }
  .home-corpus .register-heading {
    border-bottom: 0;
  }
  .home-corpus > p {
    margin-top: 0.65rem;
    font-size: 0.83rem;
    color: var(--muted);
  }
  .cover-register {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    border-block: 1px solid var(--line);
  }
  .cover-register a {
    display: grid;
    align-content: start;
    gap: 0.24rem;
    padding: 0.7rem 0.65rem;
    color: var(--ink);
    text-decoration: none;
    line-height: 1.15;
  }
  .cover-register a + a {
    border-inline-start: 1px solid var(--line);
  }
  .cover-register a:hover {
    background: var(--light);
    text-decoration: underline;
  }
  .cover-register strong {
    font-size: 1.55rem;
    font-weight: 580;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .cover-register span {
    color: var(--muted);
    font-size: 0.84rem;
    line-height: 1.35;
  }
  .home-layout {
    display: grid;
    min-width: 0;
    gap: clamp(1.35rem, 2.4vw, 2rem);
    margin-top: clamp(1.45rem, 2.7vw, 2.3rem);
  }
  .programme-index,
  .home-dossiers {
    align-self: start;
    min-width: 0;
    border-top: 2px solid var(--accent);
  }
  .programme-index .register-heading,
  .home-dossiers .register-heading {
    border: 0;
    align-items: baseline;
  }
  .register-note {
    margin: 0 0 0.5rem;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .home-dossier-grid a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.65rem;
    border-top: 1px solid var(--line);
    padding: 0.7rem 0.3rem;
    text-decoration: none;
  }
  .dossier-icon,
  .home-dossier-grid :global(.dossier-arrow) {
    color: var(--accent);
  }
  .dossier-copy {
    display: grid;
    gap: 0.3rem;
  }
  .dossier-copy small {
    color: var(--muted);
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
  }
  .dossier-copy strong {
    font-size: 1.02rem;
    line-height: 1.28;
  }
  .theme-register :global(.theme-track) {
    fill: #dce4e0;
  }
  .theme-register :global(.theme-fill) {
    fill: var(--accent);
  }
  .home-layout :global(.home-explorers) {
    margin: 0;
  }
  @media (max-width: 800px) {
    .home-choices {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .home-choices a:nth-child(odd) {
      border-inline-start: 0;
    }
    .home-choices a:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
    .home-choices :global(.choice-arrow) {
      display: none;
    }
    .home-choices a {
      grid-template-columns: auto minmax(0, 1fr);
    }
  }
  @media (max-width: 580px) {
    .home-changes {
      grid-template-columns: minmax(0, 1fr);
    }
    .cover-register {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .cover-register a:nth-child(4) {
      border-inline-start: 0;
    }
    .cover-register a:nth-child(n + 4) {
      border-top: 1px solid var(--line);
    }
    .home-choices a {
      padding-inline: 0.45rem;
      font-size: 0.9rem;
    }
  }
  @media (min-width: 1024px) {
    .home-layout {
      grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr);
    }
    .home-layout > :global(section:not(.programme-index):not(.home-dossiers)) {
      grid-column: 1/-1;
    }
  }
</style>
