---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { themes, measures, formatDate } from '../lib/data';
import HomeCover from '../components/HomeCover.astro';
import HomeSignals from '../components/HomeSignals.astro';
import HomeExplorers from '../components/HomeExplorers.astro';
import HomeEvidence from '../components/HomeEvidence.astro';

import BriefCards from '../components/BriefCards.astro';
import { campaignBriefs } from '../lib/briefs';
const briefs = await campaignBriefs();
const articles = (
  await getCollection('articles', ({ data }) => !data.draft)
).sort(
  (a, b) =>
    b.data.published.localeCompare(a.data.published) ||
    a.data.title.localeCompare(b.data.title, 'fr'),
);
const current = measures.filter((item) => item.scope !== 'archive');
const counts = themes.map((theme) => ({
  ...theme,
  count: current.filter((item) => item.theme === theme.id).length,
}));
const maxCount = Math.max(1, ...counts.map((theme) => theme.count));
---

<Base
  title="Présidentielle 2027 : candidats, programmes et sondages"
  description="Suivez la présidentielle française de 2027. Retrouvez les candidats, comparez les programmes et consultez les sondages, le calendrier et les sources."
>
  <div class="home-front">
    <HomeCover />
    <HomeSignals />
  </div>
  <nav class="home-choices" aria-label="Que cherchez-vous ?">
    <a href="/questions/">
      <Icon name="exchange" />
      <span>
        <strong>Qui propose quoi ?</strong>
        <small>Comparer les réponses à une question</small>
      </span>
    </a>
    <a href="/economie/declarations/">
      <Icon name="donnees" />
      <span>
        <strong>Vérifier un chiffre</strong>
        <small>Retrouver la série publique et sa période</small>
      </span>
    </a>
    <a href="/reperes/#voter">
      <Icon name="vote" />
      <span>
        <strong>Préparer mon vote</strong>
        <small>Inscription, bureau de vote et procuration</small>
      </span>
    </a>
    <a href="/mises-a-jour/">
      <Icon name="clock" />
      <span>
        <strong>Quoi de neuf ?</strong>
        <small>Consulter le journal des mises à jour</small>
      </span>
    </a>
  </nav>
  {briefs.length > 0 && (
    <section class="home-briefs" aria-labelledby="home-briefs-title">
      <div class="register-heading">
        <h2 id="home-briefs-title">Brèves de campagne</h2>
        <a class="inline-action" href="/breves/">
          Toutes les brèves ↗
        </a>
      </div>
      <BriefCards items={briefs.slice(0, 3)} />
    </section>
  )}
  <div class="home-layout">
    <HomeEvidence />
    <section class="programme-index" aria-labelledby="programme-index-title">
      <div class="register-heading">
        <h2 id="programme-index-title">Programmes par thème</h2>
        <a href="/comparer/" class="inline-action">
          Ouvrir le comparateur ↗
        </a>
      </div>
      <p class="register-note">
        Nombre de fiches recensées hors archives de 2022.
      </p>
      <div class="theme-register">
        {counts.map((theme) => (
          <a
            href={
              theme.id === 'retraites'
                ? '/themes/retraites/'
                : `/comparer/?theme=${theme.id}`
            }
          >
            <Icon name={theme.id} />
            <span class="theme-entry">
              <span>{theme.label}</span>
              <svg
                viewBox="0 0 100 5"
                preserveAspectRatio="none"
                aria-hidden="true"
              >
                <rect class="theme-track" width="100" height="5" />
                <rect
                  class="theme-fill"
                  width={(theme.count / maxCount) * 100}
                  height="5"
                />
              </svg>
            </span>
            <span class="theme-count" aria-label={`${theme.count} fiches`}>
              {theme.count}
            </span>
            <span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>
    <section
      id="dossiers"
      class="home-dossiers"
      aria-labelledby="home-dossiers-title"
    >
      <div class="register-heading">
        <h2 id="home-dossiers-title">Derniers dossiers</h2>
        <a href="/dossiers/" class="inline-action">
          Tous les dossiers ↗
        </a>
      </div>
      <div class="home-dossier-grid">
        {articles.slice(0, 3).map((article) => (
          <a href={`/dossiers/${article.id}/`}>
            <span class="dossier-icon">
              <Icon name={article.data.themes[0] ?? 'source'} />
            </span>
            <span class="dossier-copy">
              <small>
                {article.data.category} <span aria-hidden="true">·</span>{' '}
                <time datetime={article.data.published}>
                  {formatDate(article.data.published)}
                </time>
              </small>
              <strong>{article.data.title}</strong>
            </span>
            <Icon name="arrow" class="dossier-arrow" />
          </a>
        ))}
      </div>
    </section>
    <HomeExplorers />
  </div>
</Base>

<style>
  .home-front {
    display: grid;
    grid-template-columns: minmax(0, 0.93fr) minmax(0, 1.4fr);
    gap: clamp(0.65rem, 1.3vw, 1.2rem);
    margin-bottom: 1rem;
  }
  .home-front > :global(.election-cover) {
    margin: 0;
  }
  @media (max-width: 990px) {
    .home-front {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .home-briefs {
    margin-block: 0 1.4rem;
  }
  .home-briefs .register-heading {
    padding-bottom: 0.75rem;
    border-bottom: 0;
  }
  .home-choices {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 0.65rem;
    margin: 0 0 1.25rem;
  }
  .home-choices a {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 1rem;
    text-decoration: none;
    color: var(--ink);
    background: var(--panel-gradient);
    border: 1px solid var(--line);
    border-radius: 0.7rem;
  }
  .home-choices a:hover strong {
    text-decoration: underline;
  }
  .home-choices :global(.icon) {
    flex: none;
    color: var(--accent);
  }
  .home-choices span {
    display: grid;
    gap: 0.25rem;
  }
  .home-choices small {
    color: var(--muted);
    line-height: 1.4;
  }
  .home-layout {
    display: grid;
    min-width: 0;
    gap: clamp(1rem, 1.8vw, 1.7rem);
  }
  .programme-index,
  .home-dossiers {
    margin: 0;
    align-self: start;
    min-width: 0;
    border: 1px solid #b4c7ce;
    border-radius: 0.7rem;
    background: var(--panel-gradient);
    padding: clamp(0.85rem, 1.55vw, 1.5rem);
  }
  .home-dossiers {
    color: #eef6f7;
    background:
      radial-gradient(ellipse at 100% 0, #365a65, transparent 64%),
      linear-gradient(135deg, #192e3c, #10232f);
    border-color: #395561;
  }
  .programme-index .register-heading,
  .home-dossiers .register-heading {
    border: 0;
    padding-block: 0 0.75rem;
    align-items: baseline;
  }
  .home-dossiers h2 {
    color: #f0f7f8;
  }
  .home-dossiers .inline-action {
    color: #b7d9df;
  }
  .register-note {
    margin: 0 0 0.5rem;
    color: var(--muted);
    font-size: 0.82rem;
  }
  .home-dossier-grid a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(0.55rem, 1.2vw, 1rem);
    border-top: 1px solid #48636e;
    padding: 0.95rem 0;
    color: inherit;
    text-decoration: none;
  }
  .home-dossier-grid a:hover strong,
  .home-dossier-grid a:focus-visible strong {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }
  .home-dossier-grid a:focus-visible {
    outline-color: var(--ice);
  }
  .dossier-icon {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.4rem;
    color: #c8e2e7;
    background: linear-gradient(145deg, #3b5868, #263e4b);
    border: 1px solid #55727e;
    border-radius: 0.4rem;
  }
  .dossier-icon :global(.icon) {
    width: 1.15rem;
    height: 1.15rem;
  }
  .dossier-copy {
    display: grid;
    gap: 0.28rem;
  }
  .dossier-copy small {
    font: 500 0.76rem/1.35 var(--sans);
    color: #bbced5;
    font-variant-numeric: tabular-nums;
  }
  .dossier-copy small span {
    padding-inline: 0.18rem;
  }
  .dossier-copy strong {
    color: #f2f7f9;
    font: 610 clamp(1.02rem, 1.35vw, 1.19rem)/1.32 var(--sans);
    letter-spacing: -0.018em;
  }
  .home-dossier-grid :global(.dossier-arrow) {
    width: 0.95rem;
    height: 0.95rem;
    color: #acced7;
  }
  .theme-register > a > :global(.icon) {
    background: #d9e7ea;
    border-color: #a8bdc6;
    color: #375b69;
  }
  .theme-register :global(.theme-track) {
    fill: #cddbe0;
  }
  .theme-register :global(.theme-fill) {
    fill: #477888;
  }
  .home-layout :global(.home-explorers) {
    margin: 0;
    border: 0;
  }
  .home-layout :global(.home-explorers .explorer-index > a) {
    background: var(--panel-gradient);
    border: 1px solid var(--line);
    border-radius: 0.6rem;
  }
  .home-layout :global(.home-explorers .explorer-index > a:hover h3) {
    text-decoration: underline;
  }
  @media print {
    .home-dossiers {
      color: black;
      background: white;
    }
    .home-dossiers :is(h2, .inline-action, small, strong),
    .home-dossier-grid :global(.dossier-arrow),
    .dossier-icon {
      color: black;
    }
  }
  @media (min-width: 1040px) {
    .home-layout {
      grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr);
    }
    .home-layout > :global(section:not(.programme-index):not(.home-dossiers)) {
      grid-column: 1/-1;
    }
  }
  @media (min-width: 1330px) {
    .home-layout .theme-register {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
