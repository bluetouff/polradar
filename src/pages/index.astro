---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { themes, measures, formatDate } from '../lib/data';
import HomeCover from '../components/HomeCover.astro';
import HomeSignals from '../components/HomeSignals.astro';
import HomeExplorers from '../components/HomeExplorers.astro';
import HomeEvidence from '../components/HomeEvidence.astro';

const articles = (
  await getCollection('articles', ({ data }) => !data.draft)
).sort(
  (a, b) =>
    b.data.published.localeCompare(a.data.published) ||
    a.data.title.localeCompare(b.data.title, 'fr'),
);
const current = measures.filter((item) => item.scope !== 'archive');
const counts = themes.map((theme) => ({
  ...theme,
  count: current.filter((item) => item.theme === theme.id).length,
}));
const maxCount = Math.max(1, ...counts.map((theme) => theme.count));
---

<Base>
  <HomeCover />
  <div class="home-layout">
    <HomeSignals />
    <HomeEvidence />
    <section class="programme-index" aria-labelledby="programme-index-title">
      <div class="register-heading">
        <h2 id="programme-index-title">Programmes par thème</h2>
        <a href="/comparer/" class="inline-action">
          Ouvrir le comparateur ↗
        </a>
      </div>
      <p class="register-note">
        Nombre de fiches recensées hors archives de 2022.
      </p>
      <div class="theme-register">
        {counts.map((theme) => (
          <a href={`/comparer/?theme=${theme.id}`}>
            <Icon name={theme.id} />
            <span class="theme-entry">
              <span>{theme.label}</span>
              <svg
                viewBox="0 0 100 5"
                preserveAspectRatio="none"
                aria-hidden="true"
              >
                <rect class="theme-track" width="100" height="5" />
                <rect
                  class="theme-fill"
                  width={(theme.count / maxCount) * 100}
                  height="5"
                />
              </svg>
            </span>
            <span class="theme-count" aria-label={`${theme.count} fiches`}>
              {theme.count}
            </span>
            <span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>
    <section class="home-dossiers" aria-labelledby="home-dossiers-title">
      <div class="register-heading">
        <h2 id="home-dossiers-title">Derniers dossiers</h2>
        <a href="/dossiers/" class="inline-action">
          Tous les dossiers ↗
        </a>
      </div>
      <div class="home-dossier-grid">
        {articles.slice(0, 3).map((article) => (
          <a href={`/dossiers/${article.id}/`}>
            <small>
              {article.data.category} ·{' '}
              <time datetime={article.data.published}>
                {formatDate(article.data.published)}
              </time>
            </small>
            <strong>{article.data.title}</strong>
          </a>
        ))}
      </div>
    </section>
    <HomeExplorers />
  </div>
</Base>

<style>
  .home-layout {
    display: grid;
    min-width: 0;
    gap: clamp(1rem, 1.8vw, 1.7rem);
  }
  .programme-index,
  .home-dossiers {
    margin: 0;
    align-self: start;
    min-width: 0;
    border: 1px solid #aa9ab5;
    background: #f0e9f7;
    padding: clamp(0.8rem, 1.4vw, 1.45rem);
  }
  .home-dossiers {
    background: #f3ddce;
  }
  .programme-index .register-heading,
  .home-dossiers .register-heading {
    border: 0;
    padding-block: 0 0.65rem;
    align-items: baseline;
  }
  .register-note {
    margin: 0 0 0.5rem;
    color: var(--muted);
    font-size: 0.82rem;
  }
  .home-dossier-grid a {
    display: grid;
    gap: 0.4rem;
    border-top: 1px solid #ad9489;
    padding-block: 0.85rem;
    text-decoration: none;
  }
  .home-dossier-grid a:hover strong {
    text-decoration: underline;
  }
  .home-dossier-grid small {
    font: 0.75rem var(--mono);
    color: #584a52;
  }
  .home-dossier-grid strong {
    font: 400 1.55rem/1.09 var(--display);
    color: var(--press);
  }
  .theme-register > a > :global(.icon) {
    background: #e1d3f1;
    border-color: #beacd0;
    color: #443454;
  }
  .home-layout :global(.home-explorers) {
    margin: 0;
    border: 0;
  }
  .home-layout :global(.home-explorers .explorer-index > a) {
    background: #d5e5df;
    border: 1px solid #9baea5;
    border-top: 3px solid var(--press);
    border-radius: 0;
  }
  .home-layout :global(.home-explorers .explorer-index > a:hover h3) {
    text-decoration: underline;
  }
  @media (min-width: 1040px) {
    .home-layout {
      grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr);
    }
    .home-layout > :global(section:not(.programme-index):not(.home-dossiers)) {
      grid-column: 1/-1;
    }
  }
  @media (min-width: 1330px) {
    .home-layout .theme-register {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
