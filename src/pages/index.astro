---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import {
  candidates,
  themes,
  engagements,
  sources,
  events,
  formatDate,
} from '../lib/data';
const articles = (
  await getCollection('articles', ({ data }) => !data.draft)
).sort((a, b) => Number(b.data.featured) - Number(a.data.featured));
const recent = events
  .filter((event) => event.kind === 'past')
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 3);
const dates = events.filter((event) => event.kind === 'announced');
---

<Base>
  <header class="page-title home-title">
    <h1>Présidentielle 2027</h1>
    <p>Programmes, candidats et calendrier électoral.</p>
  </header>
  <div class="campaign-index">
    <section class="programme-index" aria-labelledby="programme-index-title">
      <div class="register-heading">
        <h2 id="programme-index-title">Comparer les programmes</h2>
        <a href="/comparer/" class="inline-action">
          Ouvrir le comparateur ↗
        </a>
      </div>
      <p class="register-note">
        Un thème, deux ou trois candidats. Les archives de 2022 sont séparées.
      </p>
      <div class="theme-register">
        {themes.map((theme, index) => (
          <a href={`/comparer/?theme=${theme.id}`}>
            <span class="theme-number" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <span>{theme.label}</span>
            <span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
      <div class="corpus-line">
        <span>
          {engagements.filter((item) => item.scope !== 'archive').length} fiches
          hors archives
        </span>
        <span>
          {engagements.filter((item) => item.scope === 'archive').length}{' '}
          archives de 2022
        </span>
        <a href="/sources/">{sources.length} sources ↗</a>
      </div>
    </section>
    <section
      class="candidate-register"
      aria-labelledby="candidate-register-title"
    >
      <div class="register-heading">
        <h2 id="candidate-register-title">Candidats</h2>
        <span class="index-total">
          {String(candidates.length).padStart(2, '0')}
        </span>
      </div>
      <p class="register-note">Sélection · ordre alphabétique</p>
      <ol class="candidate-roster">
        {candidates.map((candidate, index) => (
          <li>
            <a href={`/candidats/${candidate.id}/`}>
              <span class="roster-number" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span class="roster-person">
                <strong>{candidate.name}</strong>
                <span>{candidate.party}</span>
              </span>
              <span class="roster-arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          </li>
        ))}
      </ol>
      <a class="register-bottom" href="/candidats/">
        Statuts et fiches des candidats <span aria-hidden="true">↗</span>
      </a>
    </section>
    <section class="home-dossiers" aria-labelledby="home-dossiers-title">
      <div class="register-heading">
        <h2 id="home-dossiers-title">Dossiers</h2>
        <a href="/dossiers/" class="inline-action">
          Tous les dossiers ↗
        </a>
      </div>
      <div class="article-grid">
        {articles.slice(0, 3).map((article, index) => (
          <ArticleCard article={article} index={index} />
        ))}
      </div>
    </section>
  </div>
  <div class="home-bottom">
    <section aria-labelledby="recent-title">
      <div class="register-heading">
        <h2 id="recent-title">Chronologie de la campagne</h2>
        <a href="/campagne/" class="inline-action">
          Voir la chronologie ↗
        </a>
      </div>
      <ol class="recent-list">
        {recent.map((event) => (
          <li>
            <time datetime={event.date}>{formatDate(event.date)}</time>
            <span>{event.title}</span>
            <a href="/campagne/" aria-label={`Consulter : ${event.title}`}>
              ↗
            </a>
          </li>
        ))}
      </ol>
    </section>
    <section
      class="election-calendar"
      aria-labelledby="election-calendar-title"
    >
      <div class="register-heading">
        <h2 id="election-calendar-title">Dates du scrutin</h2>
      </div>
      {dates.map((event) => (
        <div class="calendar-entry">
          <time datetime={event.date}>{formatDate(event.date)}</time>
          <span>
            {event.id === 'premier-tour' ? 'Premier tour' : 'Second tour'}
          </span>
        </div>
      ))}
      <a class="inline-action" href="/reperes/">
        Calendrier et sources ↗
      </a>
    </section>
  </div>
</Base>
