---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { questions, questionThemes } from '../lib/questions';
import { candidates } from '../lib/data';
import { searchKinds } from '../lib/search-kinds';
import { searchEntries } from '../lib/search';
import PagedResults from '../components/PagedResults.astro';
import Pager from '../components/Pager.astro';
import SearchResultCards from '../components/SearchResultCards.astro';
import AnswerResults from '../components/AnswerResults.astro';
import { pageRange } from '../lib/pagination';
interface Props {
  page?: number;
}
const { page = 1 } = Astro.props;
const entries = await searchEntries();
const current = entries.filter((entry) => entry.scope !== 'archive');
const range = pageRange(current.length, page);
const years = [...new Set(entries.map((entry) => entry.year).filter(Boolean))]
  .sort()
  .reverse();
const examples = questions.filter(({ id }) =>
  [
    'retraites-conditions-depart',
    'soins-de-proximite',
    'fiscalite-csg-salaires',
  ].includes(id),
);
const recent = current
  .filter((entry) => entry.type === 'source' && entry.date)
  .sort(
    (a, b) =>
      b.date.localeCompare(a.date) || a.title.localeCompare(b.title, 'fr'),
  )
  .slice(0, 3);
---

<Base title={page === 1 ? 'Recherche' : `Recherche · page ${page}`} noindex>
  <header class="page-title">
    <h1>Recherche</h1>
    <p>Candidats, propositions, lois, scrutins et chiffres publics.</p>
  </header>
  <form hidden id="search-form" class="search-workbench" role="search">
    <label class="query-caption" for="search-query">
      Rechercher dans Polradar
    </label>
    <div class="query-line">
      <input
        id="search-query"
        maxlength="200"
        type="search"
        name="q"
        placeholder="Ex. prix de l’électricité ou que proposent les candidats ?"
        autocomplete="off"
        aria-describedby="search-privacy"
      />
      <button class="button primary" type="submit">
        <Icon name="search" /> Rechercher
      </button>
    </div>
    <p id="search-privacy" class="muted">
      Une question complète est envoyée à Polradar quand vous la validez.
    </p>
    <details class="reader-options" id="search-options">
      <summary>Filtrer par candidat, thème, type ou année</summary>
      <div class="facet-filters">
        <label>
          Candidat
          <select name="candidate">
            <option value="">Tous</option>
            {candidates.map((candidate) => (
              <option value={candidate.id}>{candidate.name}</option>
            ))}
          </select>
        </label>
        <label>
          Thème
          <select name="theme">
            <option value="">Tous</option>
            {questionThemes.map((theme) => (
              <option value={theme.id}>{theme.label}</option>
            ))}
          </select>
        </label>
        <label>
          Type
          <select name="type">
            <option value="">Tous</option>
            {Object.entries(searchKinds).map(([id, label]) => (
              <option value={id}>{label}</option>
            ))}
          </select>
        </label>
        <label>
          Publication
          <select name="year">
            <option value="">Toutes les années</option>
            {years.map((year) => (
              <option value={year}>{year}</option>
            ))}
          </select>
        </label>
        <label class="check-label">
          <input type="checkbox" name="archives" value="1" />
          Archives 2022
        </label>
        <button class="button small" type="reset">
          Réinitialiser
        </button>
      </div>
    </details>
  </form>
  <AnswerResults />
  <section
    id="search-discovery"
    class="search-discovery"
    hidden={page !== 1}
    aria-labelledby="search-discovery-title"
  >
    <div>
      <h2 id="search-discovery-title">Des questions pour commencer</h2>
      <ul class="search-examples">
        {examples.map(({ title, href }) => (
          <li>
            <a href={href}>
              <Icon name="exchange" />
              {title}
              <span aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
      <nav class="search-links" aria-label="Autres façons d’explorer">
        <a href="/candidats/">
          <Icon name="people" />
          Candidats
        </a>
        <a href="/dossiers/">
          <Icon name="source" />
          Dossiers
        </a>
        <a href="/economie/simulateurs/">
          <Icon name="fiscalite" />
          Simulateurs
        </a>
      </nav>
    </div>
    <div class="discovery-topics">
      <h2>Explorer les thèmes</h2>
      <ul>
        {current
          .filter(({ type }) => type === 'theme')
          .map(({ url, title, theme }) => (
            <li>
              <a href={url}>
                <Icon name={theme} />
                {title}
              </a>
            </li>
          ))}
      </ul>
    </div>
    <div class="discovery-recent">
      <h2>Documents récents</h2>
      <ul>
        {recent.map(({ url, title, date }) => (
          <li>
            <a href={url} rel="noreferrer">
              {title} ↗
            </a>
            <time datetime={date}>
              {new Intl.DateTimeFormat('fr-FR', {
                dateStyle: 'medium',
                timeZone: 'Europe/Paris',
              }).format(new Date(date + 'T12:00:00Z'))}
            </time>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <noscript>
    <p class="muted">
      Ouvrez <a href="/themes/">un thème</a> ou{' '}
      <a href="/candidats/">une fiche candidat</a>.
    </p>
    {page === 1 && (
      <section aria-labelledby="catalogue-sans-script">
        <h2 id="catalogue-sans-script">Catalogue sans JavaScript</h2>
        <Pager range={range} base="/recherche/" />
        <div id="search-fallback" class="advanced-results">
          <SearchResultCards entries={current.slice(range.start, range.end)} />
        </div>
      </section>
    )}
  </noscript>
  <template id="search-empty">
    <div class="empty-results search-empty">
      <h2>Aucun résultat</h2>
      <p>
        Vérifiez l’orthographe, essayez une recherche plus courte ou élargissez
        les filtres.
      </p>
      <div>
        <button type="button" class="button" data-reset-search>
          Réinitialiser la recherche
        </button>
        <a href="/themes/">Parcourir les thèmes</a>
      </div>
    </div>
  </template>
  <div class="search-toolbar" hidden={page === 1}>
    <p id="search-count" class="results-meta" role="status" aria-live="polite">
      {current.length} résultats
    </p>
    <div>
      <button type="button" class="button small" id="export-csv">
        <Icon name="download" />
        CSV
      </button>
      <button type="button" class="button small" id="export-json">
        <Icon name="download" />
        JSON
      </button>
      <button type="button" class="button small" id="search-share">
        Copier le lien
      </button>
      <button type="button" class="button small" id="search-save" hidden>
        Enregistrer la recherche
      </button>
    </div>
  </div>
  <nav
    id="search-types"
    class="search-links search-types"
    aria-label="Types de résultats"
    hidden
  ></nav>
  <PagedResults
    base="/recherche/"
    total={current.length}
    page={page}
    hidden={page === 1}
  >
    <div id="search-results" class="advanced-results">
      {page > 1 && (
        <SearchResultCards entries={current.slice(range.start, range.end)} />
      )}
    </div>
  </PagedResults>
  <script src="../scripts/search.ts"></script>
</Base>

<style>
  .search-workbench {
    max-width: 56rem;
    padding-top: 0;
    border: 0;
  }
  .query-caption {
    display: block;
    margin-bottom: 0.35rem;
    font-size: 0.9rem;
    font-weight: 650;
  }
  .query-line input {
    flex: 1;
    min-height: 3rem;
    font: 1rem var(--sans);
  }
  .query-line button {
    min-height: 3rem;
    gap: 0.45rem;
  }
  .query-line button :global(.icon) {
    width: 1rem;
    height: 1rem;
  }
  #search-privacy {
    margin-block: 0.45rem 0.8rem;
    font-size: 0.85rem;
  }
  .search-toolbar button {
    min-height: var(--target-size);
  }
  .search-discovery {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
    gap: 1.4rem clamp(1.25rem, 4vw, 3.2rem);
    margin-block: 1.25rem;
  }
  .search-discovery h2 {
    font-size: 1.12rem;
    margin: 0 0 0.4rem;
  }
  .search-discovery ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .search-examples a,
  .discovery-topics a,
  .search-links a,
  .search-links :global(button) {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    min-height: var(--target-size);
  }
  .search-examples a {
    padding-block: 0.35rem;
    border-block-end: 1px solid var(--line);
    text-decoration-thickness: 1px;
  }
  .search-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.85rem;
    margin-block: 0.75rem;
    font-size: 0.88rem;
  }
  .search-links :global(button) {
    min-height: 2.6rem;
  }
  .discovery-topics ul,
  .discovery-recent ul {
    display: grid;
    gap: 0.2rem 0.8rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9.5rem), 1fr));
  }
  .discovery-topics a {
    text-decoration: none;
  }
  .discovery-topics a:hover {
    text-decoration: underline;
  }
  .search-discovery :global(.icon) {
    flex: 0 0 1rem;
    color: var(--accent);
  }
  .discovery-recent {
    grid-column: 1 / -1;
    border-block-start: 1px solid var(--line);
    padding-top: 0.85rem;
  }
  .discovery-recent ul {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
  }
  .discovery-recent li {
    display: grid;
    align-content: start;
    gap: 0.25rem;
    padding-block: 0.4rem;
  }
  .discovery-recent time {
    color: var(--muted);
    font-size: 0.78rem;
  }
  .advanced-results :global(.result-meta) {
    font: 600 0.78rem/1.35 var(--sans);
  }
  .advanced-results :global(.result-symbol) {
    background: var(--light);
    color: var(--accent);
    border-color: var(--line);
  }
  .advanced-results :global(h2 a:hover) {
    text-decoration: underline;
  }
  :global(.search-empty) {
    grid-column: 1 / -1;
    padding: 0.8rem 0 1.1rem;
  }
  :global(.search-empty p) {
    color: var(--muted);
    margin-block: 0.45rem 0.85rem;
  }
  :global(.search-empty > div) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem 1rem;
  }
  :global(.search-empty .button) {
    min-height: var(--target-size);
  }
  @media (max-width: 420px) {
    .query-line button :global(.icon) {
      display: none;
    }
  }
  @media (max-width: 700px) {
    .search-discovery {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
