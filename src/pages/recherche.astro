---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { candidates, themes } from '../lib/data';
import { searchEntries, searchKinds } from '../lib/search';
import PagedResults from '../components/PagedResults.astro';
import { pageRange } from '../lib/pagination';
interface Props {
  page?: number;
}
const { page = 1 } = Astro.props;
const entries = await searchEntries();
const current = entries.filter((entry) => entry.scope !== 'archive');
const range = pageRange(current.length, page);
const years = [...new Set(entries.map((entry) => entry.year).filter(Boolean))]
  .sort()
  .reverse();
---

<Base title={page === 1 ? 'Recherche' : `Recherche · page ${page}`} noindex>
  <header class="page-title feature-title">
    <span class="feature-emblem">
      <Icon name="search" />
    </span>
    <div>
      <h1>Recherche</h1>
      <p>
        Mesures, programmes, documents et sondages. Les filtres se combinent.
      </p>
    </div>
  </header>
  <form hidden id="search-form" class="search-workbench">
    <label class="search-input">
      <Icon name="search" />
      <input
        id="search-query"
        maxlength="200"
        type="search"
        name="q"
        placeholder="Retraites, SMIC, un candidat…"
        aria-label="Votre recherche"
        autocomplete="off"
      />
    </label>
    <div class="facet-filters">
      <label>
        Candidat
        <select name="candidate">
          <option value="">Tous</option>
          {candidates.map((candidate) => (
            <option value={candidate.id}>{candidate.name}</option>
          ))}
        </select>
      </label>
      <label>
        Thème
        <select name="theme">
          <option value="">Tous</option>
          {themes.map((theme) => (
            <option value={theme.id}>{theme.label}</option>
          ))}
        </select>
      </label>
      <label>
        Type
        <select name="type">
          <option value="">Tous</option>
          {Object.entries(searchKinds).map(([id, label]) => (
            <option value={id}>{label}</option>
          ))}
        </select>
      </label>
      <label>
        Publication
        <select name="year">
          <option value="">Toutes les années</option>
          {years.map((year) => (
            <option value={year}>{year}</option>
          ))}
        </select>
      </label>
      <label class="check-label">
        <input type="checkbox" name="archives" value="1" />
        Archives 2022
      </label>
      <button class="button" type="submit">
        Rechercher
      </button>
      <button class="button small" type="reset">
        Réinitialiser
      </button>
    </div>
  </form>
  <div class="search-toolbar">
    <p id="search-count" class="results-meta" role="status" aria-live="polite">
      {current.length} résultats
    </p>
    <div>
      <button type="button" class="button small" id="export-csv">
        <Icon name="download" />
        CSV
      </button>
      <button type="button" class="button small" id="export-json">
        <Icon name="download" />
        JSON
      </button>
      <button type="button" class="button small" id="search-share">
        Copier le lien
      </button>
    </div>
  </div>
  <PagedResults base="/recherche/" total={current.length} page={page}>
    <div id="search-results" class="advanced-results">
      {current.slice(range.start, range.end).map((entry) => (
        <article class="advanced-result">
          <span class="result-symbol">
            <Icon
              name={
                entry.type === 'mesure'
                  ? entry.theme
                  : entry.type === 'sondage'
                    ? 'sondages'
                    : entry.type === 'evenement'
                      ? 'clock'
                      : entry.type === 'candidat'
                        ? 'people'
                        : entry.type === 'source'
                          ? 'source'
                          : 'layers'
              }
            />
          </span>
          <div>
            <p class="result-meta">
              {searchKinds[entry.type]}
              {entry.year && ` · ${entry.year}`}
            </p>
            <h2>
              <a
                href={entry.url}
                target={entry.url.startsWith('https:') ? '_blank' : undefined}
                rel={
                  entry.url.startsWith('https:')
                    ? 'noopener noreferrer'
                    : undefined
                }
              >
                {entry.title}
              </a>
            </h2>
            <p>
              {entry.text.slice(0, 220)}
              {entry.text.length > 220 ? '…' : ''}
            </p>
          </div>
          <span aria-hidden="true">↗</span>
        </article>
      ))}
    </div>
  </PagedResults>
  <script src="../scripts/search.ts"></script>
</Base>
