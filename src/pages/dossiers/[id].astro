---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleAside from '../../components/ArticleAside.astro';
import SourceLinks from '../../components/SourceLinks.astro';
import RetirementDossier from '../../components/RetirementDossier.astro';
import { formatDate, themeById } from '../../lib/data';
export async function getStaticPaths() {
  return (await getCollection('articles', ({ data }) => !data.draft)).map(
    (article) => ({ params: { id: article.id }, props: { article } }),
  );
}
const { article } = Astro.props;
const { Content } = await render(article);
const interactive = article.id === 'retraites-ages-et-conditions';
---

<Base
  title={article.data.title}
  description={article.data.description}
  articlePublished={article.data.published}
  lastModified={article.data.updated}
  section="/dossiers/"
>
  <div class="breadcrumbs">
    <a href="/dossiers/">Décryptages</a>
    <span>/</span>
    <span>{article.data.category}</span>
  </div>
  <header class="page-title article-title">
    <p class="eyebrow reading-meta">
      {article.data.category} ·{' '}
      <time datetime={article.data.published}>
        {formatDate(article.data.published)}
      </time>
    </p>
    <h1>{article.data.title}</h1>
    <p>{article.data.description}</p>
  </header>
  <div class:list={{ 'article-layout': !interactive }}>
    <article class:list={{ prose: !interactive }}>
      {interactive ? <RetirementDossier /> : <Content />}
      <p>
        <a rel="license" href="/licences/#editions">
          Article de Polradar · CC BY 4.0
        </a>
      </p>
      <section class="article-sources">
        <h2>Sources & documents</h2>
        <SourceLinks ids={article.data.sources} />
      </section>
      <p class="editorial-note">
        Dernière modification : {formatDate(article.data.updated)}. Rédaction
        Polradar.
      </p>
    </article>
    {!interactive && (
      <ArticleAside
        links={[
          ...article.data.themes.map((id) => ({
            href: `/themes/${id}/`,
            label: `${themeById(id).label} : les propositions`,
            icon: id,
          })),
          { href: '/comparer/', label: 'Le comparateur', icon: 'exchange' },
          { href: '/methode/', label: 'Notre méthode', icon: 'source' },
        ]}
      />
    )}
  </div>
</Base>
