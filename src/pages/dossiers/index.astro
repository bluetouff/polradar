---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
const articles = (
  await getCollection('articles', ({ data }) => !data.draft)
).sort((a, b) => b.data.published.localeCompare(a.data.published));
---

<Base title="Décryptages et clés de lecture" section="/dossiers/">
  <header class="page-title">
    <p class="eyebrow">PRENDRE DU RECUL</p>
    <h1>
      La campagne.
      <br />
      <em>Avec du contexte.</em>
    </h1>
    <p>
      Des repères pour lire un programme, comprendre ses hypothèses et comparer
      des propositions qui ne parlent pas toujours de la même chose.
    </p>
  </header>
  <div class="article-grid">
    {articles.map((article, index) => (
      <ArticleCard article={article} index={index} />
    ))}
  </div>
</Base>
