---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
const articles = (
  await getCollection('articles', ({ data }) => !data.draft)
).sort((a, b) => b.data.published.localeCompare(a.data.published));
---

<Base
  title="Dossiers de la présidentielle 2027"
  description="Décryptages sourcés sur la présidentielle 2027 : financement des propositions, retraites, lecture des sondages et suivi des programmes."
  section="/dossiers/"
>
  <header class="page-title">
    <h1>Dossiers</h1>
    <p>Retraites, financement des propositions et lecture des sondages.</p>
  </header>
  <div class="article-grid">
    {articles.map((article) => (
      <ArticleCard article={article} />
    ))}
  </div>
</Base>
