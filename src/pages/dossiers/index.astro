---
import { getCollection } from 'astro:content';
import DossierLinks from '../../components/DossierLinks.astro';
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
const articles = (
  await getCollection('articles', ({ data }) => !data.draft)
).sort((a, b) => b.data.published.localeCompare(a.data.published));
---

<Base
  title="Dossiers de la présidentielle 2027"
  description="Prix agricoles, cantines scolaires, logement, santé et retraites. Les propositions de la présidentielle 2027 comparées aux données publiques."
  section="/dossiers/"
>
  <header class="page-title">
    <h1>Dossiers</h1>
    <p>
      Prix agricoles, cantines scolaires, salaires, logement, accès aux soins et
      retraites.
    </p>
  </header>
  <DossierLinks />
  <div class="article-grid">
    {articles.map((article) => (
      <ArticleCard article={article} />
    ))}
  </div>
</Base>
