---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import FollowButton from '../components/FollowButton.astro';
import FollowChanges from '../components/FollowChanges.astro';
import { activeCandidates as candidates, themes } from '../lib/data';
---

<Base title="Mon suivi" section="/suivi/" noindex>
  <header class="page-title feature-title">
    <span class="feature-emblem">
      <Icon name="suivi" />
    </span>
    <div>
      <h1>Mon suivi</h1>
      <p>
        Retrouvez les candidats et les thèmes que vous suivez, ainsi que vos
        recherches et comparaisons enregistrées dans ce navigateur.
      </p>
    </div>
  </header>
  <p>
    <a href="/suivi/enquetes/">Mes dossiers d’enquête ↗</a>
  </p>
  <div id="follow-app">
    <FollowChanges />
    <p id="follow-status" role="status" class="results-meta"></p>
    <section
      id="saved-views"
      class="section-space"
      aria-labelledby="saved-views-title"
      hidden
    >
      <h2 id="saved-views-title" tabindex="-1">
        Recherches et comparaisons
      </h2>
      <p id="saved-views-status" role="status" class="results-meta"></p>
      <ul id="saved-views-list"></ul>
    </section>
    <section class="section-space">
      <div class="register-heading">
        <h2 id="fiches-suivies">Fiches suivies</h2>
        <button id="follow-clear" type="button" class="button small" disabled>
          Effacer mon suivi
        </button>
      </div>
      <div id="follow-results" class="measure-list">
        <p class="notice">
          Sélectionnez un candidat ou un thème pour afficher les fiches
          correspondantes.
        </p>
      </div>
    </section>
    <div class="follow-layout" id="choisir-suivi">
      <section>
        <div class="register-heading">
          <h2>Candidats</h2>
          <Icon name="people" />
        </div>
        <div class="follow-candidates">
          {candidates.map((candidate) => (
            <div>
              <a href={`/candidats/${candidate.id}/`}>{candidate.name}</a>
              <FollowButton
                kind="candidate"
                id={candidate.id}
                name={candidate.name}
              />
            </div>
          ))}
        </div>
      </section>
      <section>
        <div class="register-heading">
          <h2>Thèmes</h2>
          <Icon name="layers" />
        </div>
        <div class="follow-themes">
          {themes.map((theme) => (
            <div>
              <Icon name={theme.id} />
              <span>{theme.label}</span>
              <FollowButton kind="theme" id={theme.id} name={theme.label} />
            </div>
          ))}
        </div>
      </section>
    </div>
    <section class="section-space">
      <div class="register-heading">
        <h2>Flux RSS sélectionnés</h2>
        <Icon name="rss" />
      </div>
      <div id="follow-feeds" class="feed-list">
        <p>Les flux apparaîtront selon votre sélection.</p>
      </div>
    </section>
  </div>
  <noscript>
    <p class="notice">
      Le suivi local nécessite JavaScript. Les flux ci-dessous restent
      accessibles.
    </p>
  </noscript>
  <details class="section-space">
    <summary>Tous les flux disponibles</summary>
    <div class="feed-list">
      {candidates.map((candidate) => (
        <a href={`/rss/candidats/${candidate.id}.xml`}>
          <Icon name="rss" />
          {candidate.name}
        </a>
      ))}
      {themes.map((theme) => (
        <a href={`/rss/themes/${theme.id}.xml`}>
          <Icon name="rss" />
          {theme.label}
        </a>
      ))}
    </div>
  </details>
</Base>

<style>
  #saved-views-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  #saved-views-list :global(li) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    padding-block: 0.65rem;
    border-block-start: 1px solid var(--line);
  }
  #saved-views-list :global(a) {
    flex: 1 1 18rem;
    display: grid;
    align-content: center;
    min-height: var(--target-size, 44px);
    overflow-wrap: anywhere;
    font-weight: 600;
  }
  #saved-views-list :global(a > span) {
    color: var(--muted);
    font-size: 0.86rem;
    font-weight: 400;
  }
  #saved-views-list :global(button) {
    min-height: var(--target-size, 44px);
  }
</style>
