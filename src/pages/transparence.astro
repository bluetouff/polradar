---
import Base from '../layouts/Base.astro';
import {
  candidates,
  measures,
  polls,
  versions,
  watch,
  sources,
  themes,
  meta,
  formatDate,
} from '../lib/data';
---

<Base title="À propos de Polradar">
  <header class="page-title">
    <h1>À propos de Polradar</h1>
    <p>
      Projet personnel de bluetouff. Code et contenus originaux sous licence
      MIT.
    </p>
  </header>
  <div class="two-col">
    <article class="panel">
      <h2>Contenu du corpus</h2>
      <ul class="reading-list">
        <li>
          {candidates.length} candidatures sélectionnées, sans prétention à
          l’exhaustivité.
        </li>
        <li>{themes.length} thèmes communs à chaque dossier.</li>
        <li>
          {measures.filter((e) => e.scope !== 'archive').length} fiches hors
          archives, orientations incluses.
        </li>
        <li>
          {measures.filter((e) => e.scope === 'archive').length} fiches
          d’archives 2022.
        </li>
        <li>
          {sources.length} références, dont certaines servent de repères
          institutionnels.
        </li>
      </ul>
      <p>
        Dernière mise à jour du corpus : {formatDate(meta.corpusUpdated)}. Les
        dates de consultation figurent dans chaque source.
      </p>
    </article>
    <aside class="repository-note">
      <h2>Dépôt GitHub</h2>
      <p>
        Le dépôt public contient le code, les données et l’historique des
        modifications. Les documents de tiers conservent leurs licences.
      </p>
      <a
        class="repository-link"
        href={meta.repository}
        target="_blank"
        rel="noopener noreferrer"
      >
        bluetouff/polradar ↗
      </a>
    </aside>
  </div>
  <section class="prose section-space">
    <h2>Rubriques disponibles</h2>
    <p>
      Les mesures disposent de fiches distinctes, de références et d’un
      historique avant/après ({versions.length} versions). La recherche combine
      candidat, thème, type de contenu, année de publication connue et archives,
      avec export CSV ou JSON. Le suivi par candidat ou thème reste dans le
      navigateur et propose des flux RSS spécialisés. La veille couvre
      {watch.length} sources sélectionnées.
    </p>
    <h2>Données suivies</h2>
    <p>
      Les {polls.length} scénarios publiés proviennent de{' '}
      {new Set(polls.map((poll) => poll.institute)).size} instituts. Les dates
      des enquêtes, des cours de marché, des séries Eurostat et des relevés de
      l’Arcom figurent dans le{' '}
      <a href="/mises-a-jour/">journal des mises à jour automatiques</a>.
    </p>
    <h2>Contrôles de publication</h2>
    <p>
      La construction vérifie les identifiants, les références, les dates, la
      séparation des archives et la cohérence des chiffres budgétaires du cadre
      commun. Ces contrôles techniques accompagnent la vérification éditoriale
      des documents ; ils ne la remplacent pas.
    </p>
  </section>
</Base>

<style>
  .repository-note {
    align-self: start;
    display: grid;
    gap: 0.7rem;
    padding: clamp(1.1rem, 2.4vw, 1.8rem);
    border: 1px solid #486877;
    border-radius: 0.7rem;
    background: linear-gradient(115deg, #142d3b, #204654);
    color: #f5fbfe;
  }
  .repository-note h2 {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }
  .repository-note h2::before {
    content: '';
    width: 1.55rem;
    height: 1.55rem;
    background: #a5e1e8;
    mask: url('/icons/depot-git.svg') center / contain no-repeat;
    flex: none;
  }
  .repository-note h2,
  .repository-note p {
    margin: 0;
    color: inherit;
  }
  .repository-note p {
    color: #d9e9ef;
    line-height: 1.55;
    max-width: 60ch;
  }
  .repository-link {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: #fff;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.23em;
  }
  .repository-link:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }
  .repository-note ::selection {
    color: #112c39;
    background: #d0edf3;
  }
</style>
