---
import PagedResults from '../components/PagedResults.astro';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import {
  watch,
  sources,
  sourceKinds,
  formatTimestamp,
  meta,
} from '../lib/data';
import '../styles/watch.css';
import { technicalFreshness } from '../lib/source-freshness';

const labels: Record<string, string> = {
  accessible: 'Accessible',
  modifie: 'Contenu à examiner',
  indisponible: 'Indisponible',
  bloque: 'Accès non exploitable',
};
const formats: Record<string, string> = {
  web: 'Web',
  pdf: 'PDF',
  video: 'Vidéo',
  autre: 'Autre',
};
const baselines = new Map(watch.map((row) => [row.sourceId, row]));
const sourceMap = new Map(sources.map((s) => [s.id, s]));
const rows = [...technicalFreshness.values()].flatMap((row) => {
  const source = sourceMap.get(row.sourceId);
  if (!source) return [];
  const previous = baselines.get(row.sourceId);
  const detailed = previous?.checkedAt === row.checkedAt ? previous : null;
  const path = new URL(source.url).pathname;
  const format =
    source.watchFormat === 'youtube-oembed'
      ? 'video'
      : /\.pdf$/i.test(path) || detailed?.contentType.includes('pdf')
        ? 'pdf'
        : detailed?.contentType.includes('html')
          ? 'web'
          : 'autre';
  return [
    {
      ...row,
      source,
      format,
      host: new URL(source.url).hostname.replace(/^www\./, ''),
      message: detailed?.message,
      httpStatus: detailed?.httpStatus,
      reviewNote: previous?.reviewNote,
      reviewedAt: previous?.reviewedAt,
    },
  ];
});
const states = [
  {
    id: 'accessible',
    label: 'Accessibles',
    icon: 'check',
    count: rows.filter((row) => row.status === 'accessible').length,
  },
  {
    id: 'modifie',
    label: 'À examiner',
    icon: 'historique',
    count: rows.filter((row) => row.status === 'modifie').length,
  },
  {
    id: 'indisponible',
    label: 'Accès non exploitables',
    icon: 'warning',
    count: rows.filter(
      (row) => row.status === 'indisponible' || row.status === 'bloque',
    ).length,
  },
];
const formatCounts = Object.entries(formats)
  .map(([id, label]) => ({
    id,
    label,
    count: rows.filter((row) => row.format === id).length,
  }))
  .filter((format) => format.count > 0);
const checked = rows
  .map((row) => row.checkedAt)
  .sort()
  .at(-1);
let stateOffset = 0;
---

<Base title="Veille des programmes" section="/veille/">
  <header class="page-title feature-title">
    <span class="feature-emblem">
      <Icon name="veille" />
    </span>
    <div>
      <h1>Veille des programmes</h1>
      <p>Accessibilité des sources et changements à examiner.</p>
    </div>
    <a
      class="button"
      href={`${meta.repository}/actions/workflows/watch.yml`}
      target="_blank"
      rel="noopener noreferrer"
    >
      <Icon name="clock" /> Dernières exécutions ↗
    </a>
  </header>

  <p class="evidence-related">
    <a class="inline-action" href="/mises-a-jour/">
      Derniers contrôles automatiques et incidents ↗
    </a>
  </p>
  <div class="watch-dashboard">
    <section class="watch-health" aria-labelledby="watch-health-title">
      <div class="watch-health-heading">
        <span>Relevé intégré</span>
        <Icon name="veille" />
      </div>
      <h2 id="watch-health-title">
        <strong>{rows.length}</strong>
        <span>sources contrôlées</span>
      </h2>
      {checked && (
        <p class="watch-checked">
          Dernier contrôle intégré :{' '}
          <time datetime={checked}>{formatTimestamp(checked)} (Paris)</time>
        </p>
      )}
      <svg
        class="watch-state-bar"
        viewBox="0 0 100 8"
        preserveAspectRatio="none"
        role="img"
        aria-label={states
          .map((state) => `${state.label} : ${state.count}`)
          .join(' ; ')}
      >
        {states.map((state) => {
          const start = stateOffset;
          const width = rows.length ? (state.count / rows.length) * 100 : 0;
          stateOffset += width;
          return (
            <rect
              class={`watch-bar-${state.id}`}
              x={start}
              width={width}
              height="8"
            />
          );
        })}
      </svg>
      <div class="watch-state-totals">
        {states.map((state) => (
          <div class={`watch-total-${state.id}`}>
            <Icon name={state.icon} />
            <strong>{state.count}</strong>
            <span>{state.label}</span>
          </div>
        ))}
      </div>
    </section>
    <section class="watch-source-map" aria-labelledby="watch-map-title">
      <div class="watch-map-heading">
        <h2 id="watch-map-title">Accès aux fiches</h2>
        <span id="watch-map-count">{rows.length} sources</span>
      </div>
      <p>Chaque case ouvre la fiche de sa source.</p>
      <div class="watch-matrix">
        {rows.map((row, index) => (
          <a
            href={`#watch-${row.sourceId}`}
            class={`watch-cell watch-cell-${row.status}`}
            data-watch-cell={row.sourceId}
            title={`${row.source.title} · ${labels[row.status]}`}
            aria-label={`${row.source.title} : ${labels[row.status]}`}
          >
            {String(index + 1).padStart(2, '0')}
          </a>
        ))}
      </div>
      <div class="watch-format-totals">
        {formatCounts.map((format) => (
          <span>
            <b>{format.count}</b> {format.label}
          </span>
        ))}
      </div>
    </section>
  </div>

  <div class="watch-register-heading">
    <h2>Sources du relevé</h2>
    <span>Les dates de contrôle figurent dans chaque fiche.</span>
  </div>
  <form id="watch-filters" class="watch-filters" hidden>
    <label>
      Rechercher
      <input
        id="watch-search"
        type="search"
        maxlength="200"
        placeholder="Une source, un domaine…"
        autocomplete="off"
      />
    </label>
    <label>
      État
      <select id="watch-state">
        <option value="">Tous les états</option>
        {Object.entries(labels).map(([id, label]) => (
          <option value={id}>{label}</option>
        ))}
      </select>
    </label>
    <label>
      Format
      <select id="watch-format">
        <option value="">Tous les formats</option>
        {formatCounts.map((format) => (
          <option value={format.id}>{format.label}</option>
        ))}
      </select>
    </label>
    <button type="reset" class="button">
      Réinitialiser
    </button>
  </form>
  <p
    class="results-meta"
    id="watch-filter-status"
    role="status"
    aria-live="polite"
  >
    {rows.length} sources
  </p>
  <PagedResults total={rows.length}>
    <div class="watch-source-grid">
      {rows.map((row, index) => (
        <article
          class={`watch-card watch-card-${row.status}`}
          id={`watch-${row.sourceId}`}
          data-watch-source={row.sourceId}
          data-watch-status={row.status}
          data-watch-format={row.format}
          data-watch-search={`${row.source.title} ${row.host}`}
        >
          <div class="watch-card-heading">
            <span class="watch-document-icon">
              <Icon name={row.format === 'video' ? 'veille' : 'source'} />
            </span>
            <span class="watch-document-format">
              {formats[row.format]}
              <small>{sourceKinds[row.source.kind]}</small>
            </span>
            <span class="watch-source-number">
              {String(index + 1).padStart(2, '0')}
            </span>
          </div>
          <h3>
            <a href={row.source.url} target="_blank" rel="noopener noreferrer">
              {row.source.title}
              <Icon name="external" />
            </a>
          </h3>
          <p class="watch-source-host">{row.host}</p>
          <div class="watch-card-footer">
            <span class={`watch-card-status status-${row.status}`}>
              <Icon
                name={
                  row.status === 'accessible'
                    ? 'check'
                    : row.status === 'modifie'
                      ? 'historique'
                      : 'warning'
                }
              />
              {labels[row.status]}
            </span>
            <p class="watch-card-time">
              <Icon name="clock" />
              Dernière tentative{' '}
              <time datetime={row.checkedAt}>
                {formatTimestamp(row.checkedAt)} (Paris)
              </time>
            </p>
            <details class="watch-card-details">
              <summary>Détail du contrôle</summary>
              <p>
                {row.lastSuccessAt
                  ? 'Dernier accès réussi le ' +
                    formatTimestamp(row.lastSuccessAt) +
                    ' (Paris).'
                  : 'Aucun accès réussi daté dans les relevés disponibles.'}
              </p>
              {row.message && <p>{row.message}</p>}
              {row.httpStatus != null && (
                <p>Réponse HTTP : {row.httpStatus}.</p>
              )}
              {row.reviewNote && <p>{row.reviewNote}</p>}
              {row.reviewedAt && (
                <p>
                  Relecture du contenu : {formatTimestamp(row.reviewedAt)}{' '}
                  (Paris).
                </p>
              )}
            </details>
          </div>
        </article>
      ))}
    </div>
  </PagedResults>
  <p class="notice" id="watch-empty" hidden>
    Aucune source pour cette sélection.
  </p>
  <details class="watch-process">
    <summary>
      <Icon name="layers" /> Fonctionnement de la veille
    </summary>
    <ol>
      <li>
        <b>01</b> Collecte quotidienne
      </li>
      <li>
        <b>02</b> Relecture du rapport
      </li>
      <li>
        <b>03</b> Mise à jour des fiches
      </li>
    </ol>
    <p>
      Un changement de page est signalé pour examen. Les fiches éditoriales sont
      mises à jour après vérification. La date du contrôle est distincte de la
      consultation éditoriale.
    </p>
    <p>
      Pour une vidéo, le relevé vérifie sa disponibilité et ses métadonnées. Le
      son et les images ne sont pas comparés.
    </p>
    <a
      href={`${meta.repository}/actions/workflows/watch.yml`}
      target="_blank"
      rel="noopener noreferrer"
    >
      Consulter les rapports ↗
    </a>
  </details>
  <script src="../scripts/watch.ts"></script>
</Base>
