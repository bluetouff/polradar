---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SourceLinks from '../../components/SourceLinks.astro';
import { candidateById, formatDate } from '../../lib/data';
import { campaignBriefs } from '../../lib/briefs';
export async function getStaticPaths() {
  return (await campaignBriefs()).map((brief) => ({
    params: { id: brief.article.id },
    props: { brief },
  }));
}
const { article, event, entry } = Astro.props.brief;
const Content = entry ? (await render(entry)).Content : null;
---

<Base
  title={article.data.title}
  description={article.data.description}
  section="/breves/"
  articlePublished={article.data.published}
>
  <nav class="breadcrumbs" aria-label="Fil d’Ariane">
    <a href="/breves/">Brèves de campagne</a>
  </nav>
  <article
    class="brief-reading"
    itemscope
    itemtype={
      entry ? 'https://schema.org/NewsArticle' : 'https://schema.org/WebPage'
    }
  >
    <link
      itemprop="mainEntityOfPage"
      href={new URL(Astro.url.pathname, Astro.site).href}
    />
    <span
      itemprop="publisher"
      itemscope
      itemtype="https://schema.org/Organization"
    >
      <meta itemprop="name" content="Polradar" />
    </span>
    <header>
      <p class="brief-byline reading-meta">
        <span
          itemprop="author"
          itemscope
          itemtype="https://schema.org/Organization"
        >
          <span itemprop="name">
            {entry
              ? 'Rédaction Polradar'
              : 'Veille des publications officielles'}
          </span>
        </span>{' '}
        · Publié le{' '}
        <time itemprop="datePublished" datetime={article.data.published}>
          {formatDate(article.data.published)}
        </time>
      </p>
      <h1 itemprop="headline">{article.data.title}</h1>
      <p class="brief-deck" itemprop="description">
        {article.data.description}
      </p>
    </header>
    {entry?.data.reperes && (
      <section class="brief-dates" aria-label="Chronologie du dossier">
        <h2>Les dates du dossier</h2>
        <ol>
          {entry.data.reperes.map((r) => (
            <li>
              <strong>{r.periode}</strong>
              <span>{r.fait}</span>
            </li>
          ))}
        </ol>
      </section>
    )}
    {Content ? (
      <div class="prose">
        <Content />
      </div>
    ) : (
      <p>
        Le document d’origine est daté du{' '}
        <time datetime={event.date}>{formatDate(event.date)}</time>.
      </p>
    )}
    {event.eventDate && (
      <p>
        Date annoncée de l’événement{' '}
        <time datetime={event.eventDate}>{formatDate(event.eventDate)}</time>.
      </p>
    )}
    {entry && (
      <p class="brief-byline">
        <a rel="license" href="/licences/#editions">
          Texte de Polradar · CC BY 4.0
        </a>
      </p>
    )}
    <section class="article-sources">
      <h2>Sources</h2>
      <SourceLinks ids={event.sources} />
    </section>
    <nav aria-label="Dossiers liés" class="brief-links">
      <a href={'/campagne/#' + event.id}>
        Le fait du {formatDate(event.date)} dans la chronologie ↗
      </a>
      {event.candidates.map((id) => (
        <a href={'/candidats/' + id + '/'}>{candidateById(id).name} ↗</a>
      ))}
    </nav>
  </article>
</Base>
<style>
  .brief-reading {
    max-width: 52rem;
    margin-inline: auto;
    padding: clamp(1.1rem, 3.5vw, 3rem);
    border: 1px solid var(--line);
    border-top: 3px solid #398090;
    border-radius: 0.8rem;
    background: var(--panel-gradient);
  }
  .brief-byline {
    margin: 0 0 0.65rem;
    font-size: 0.82rem;
    color: var(--muted);
  }
  .brief-reading h1 {
    margin: 0;
    font-size: clamp(1.5rem, 3vw, 1.75rem);
  }
  .brief-deck {
    margin: 0.85rem 0 1.25rem;
    font-size: 1.1rem;
    line-height: 1.55;
  }
  .brief-reading .prose {
    max-width: 68ch;
  }
  .brief-links {
    border-top: 1px solid var(--line);
    padding-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
  }
  .brief-links a {
    text-underline-offset: 0.2em;
  }
  .brief-dates {
    margin: 1.25rem 0 1.5rem;
    border: 1px solid #9cbac3;
    border-radius: 0.8rem;
    background: linear-gradient(120deg, #142d3b, #204e5b);
    padding: clamp(1rem, 3vw, 1.45rem);
    color: #f3fafb;
  }
  .brief-dates h2 {
    margin: 0 0 1rem;
    font-size: 1rem;
    color: #f3fafb;
  }
  .brief-dates ol {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 8rem), 1fr));
    gap: 0.9rem 1rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .brief-dates li {
    padding-top: 0.6rem;
    border-top: 2px solid #72a9b4;
    min-width: 0;
  }
  .brief-dates strong,
  .brief-dates span {
    display: block;
  }
  .brief-dates strong {
    font-size: 0.92rem;
    color: #b6e4e8;
  }
  .brief-dates span {
    margin-top: 0.35rem;
    font-size: 0.88rem;
    line-height: 1.45;
    color: #e7eff2;
  }
</style>
