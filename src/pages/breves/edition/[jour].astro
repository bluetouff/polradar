---
import Base from '../../../layouts/Base.astro';
import BriefCards from '../../../components/BriefCards.astro';
import { briefEditions } from '../../../lib/brief-editions';
import {
  editorialIssueLabels,
  editorialSections,
} from '../../../lib/editorial-reviews.mjs';
import {
  formatDate,
  formatTimestamp,
  meta,
  sourceById,
} from '../../../lib/data';
export async function getStaticPaths() {
  return (await briefEditions()).map((edition) => ({
    params: { jour: edition.day },
    props: { edition },
  }));
}
const { edition } = Astro.props;
const status = { annonce: 'Annoncé', tenu: 'Tenu', annule: 'Annulé' };
const title = 'Le point de campagne du ' + formatDate(edition.day);
const collections = [
  {
    id: 'nouvelles-mesures',
    title: 'Mesures ajoutées',
    rows: edition.measures.filter((row) => !row.before),
  },
  {
    id: 'propositions-modifiees',
    title: 'Propositions modifiées',
    rows: edition.measures.filter((row) => row.before),
  },
];
---

<Base
  title={title}
  section="/breves/"
  description={
    'Brèves, enquêtes et rendez-vous documentés dans l’édition du ' +
    formatDate(edition.day) +
    '.'
  }
>
  <nav class="breadcrumbs" aria-label="Fil d’Ariane">
    <a href="/breves/">Toutes les brèves</a>
  </nav>
  <header class="page-title">
    <h1>{title}</h1>
    <p>Informations publiées ou ajoutées le {formatDate(edition.day)}.</p>
    <a href="/breves/rss.xml">Suivre les brèves par RSS</a> ·{' '}
    <a href="/suivi/">Mon suivi</a>
  </header>
  {edition.briefs.length > 0 ? (
    <BriefCards items={edition.briefs} lead />
  ) : (
    <p>Aucune nouvelle brève confirmée dans cette édition.</p>
  )}
  {edition.documents.length > 0 && (
    <section class="day-facts" id="programmes">
      <h2>Documents de programme publiés</h2>
      <ul>
        {edition.documents.map((doc) => (
          <li>
            <a href={doc.url} rel="noreferrer">
              {doc.title} ↗
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
  {collections
    .filter(({ rows }) => rows.length)
    .map(({ id, title, rows }) => (
      <section class="day-facts" id={id}>
        <h2>{title}</h2>
        <ul>
          {rows.slice(0, 5).map((measure) => (
            <li>
              <a href={measure.href}>{measure.title}</a>{' '}
              {measure.author && <span>· {measure.author}</span>}{' '}
              {measure.after?.sources[0] && (
                <a href={measure.after.sources[0].url} rel="noreferrer">
                  Document d’origine ↗
                </a>
              )}
            </li>
          ))}
        </ul>
        {rows.length > 5 && (
          <a href="/mises-a-jour/">
            {rows.length} fiches dans le journal des mises à jour
          </a>
        )}
      </section>
    ))}
  {(edition.surveys.length > 0 || edition.meetings.length > 0) && (
    <section class="day-facts" id="sondages-agenda">
      <h2>Sondages et agenda du jour</h2>
      <ul>
        {edition.surveys.map((p) => (
          <li>
            <strong>Enquête publiée · {p.institute}</strong>{' '}
            <a href={'/sondages/#enquete=' + p.id}>Voir les scénarios</a> ·{' '}
            <a href={sourceById(p.noticeSource).url}>Notice officielle</a>
          </li>
        ))}
        {edition.meetings.map((e) => (
          <li>
            <strong>
              {status[e.status]} · {e.title}
            </strong>{' '}
            <a href={'/agenda/#' + e.id}>Agenda</a> ·{' '}
            <a href={sourceById(e.source).url}>Source</a>
          </li>
        ))}
      </ul>
    </section>
  )}
  {edition.deadlines.length > 0 && (
    <section class="day-facts" id="echeances">
      <h2>Prochaines dates du scrutin</h2>
      <ul>
        {edition.deadlines.map((event) => (
          <li>
            <time datetime={event.date}>{formatDate(event.date)}</time> ·{' '}
            {event.title} ·{' '}
            <a href={sourceById(event.sources[0]).url} rel="noreferrer">
              Annonce officielle ↗
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
  {edition.passages.length > 0 && (
    <section class="day-facts" aria-labelledby="edition-checks">
      <h2 id="edition-checks">Vérification des sources</h2>
      {edition.passages.length > 1 && edition.access.checked > 0 && (
        <p>
          {edition.access.checked} sources distinctes contrôlées, dont{' '}
          {edition.access.accessible} accessibles au moins une fois dans la
          journée.
        </p>
      )}
      <div class="edition-passes">
        {edition.passages.map((passage) => {
          const checks = passage.hosted?.checks ?? [];
          const incidents = checks.filter(
            (check) => !check.ok || check.issues?.length,
          );
          const manualIncidents = passage.hosted
            ? []
            : passage.sections.filter((item) => item.status !== 'consulte');
          const changes = [
            ...new Map(
              [
                ...passage.sections.flatMap((section) => section.changes),
                ...(passage.hosted?.changes ?? []),
              ].map((item) => [item.path, item]),
            ).values(),
          ];
          return (
            <article class="edition-pass">
              <h3>
                {passage.scope === 'annonces'
                  ? 'Annonces officielles prioritaires'
                  : 'Revue éditoriale complète'}
              </h3>
              <time datetime={passage.checkedAt}>
                {formatTimestamp(passage.checkedAt)} · Paris
              </time>
              {passage.hosted ? (
                <p>
                  <strong>
                    {checks.filter((check) => check.ok).length} sur{' '}
                    {checks.length}
                  </strong>{' '}
                  sources accessibles.
                </p>
              ) : (
                <p>{passage.sections.length} rubriques examinées.</p>
              )}
              {incidents.length + manualIncidents.length > 0 && (
                <details>
                  <summary>
                    Incidents ({incidents.length + manualIncidents.length})
                  </summary>
                  <ul>
                    {incidents.map((check) => {
                      const source = sourceById(check.id);
                      return (
                        <li>
                          {check.url ? (
                            <a href={check.url}>{source.title}</a>
                          ) : (
                            source.title
                          )}
                          {' · '}
                          {check.issues?.length
                            ? check.issues
                                .map((issue) => editorialIssueLabels[issue])
                                .join(', ')
                            : 'source indisponible'}
                        </li>
                      );
                    })}
                    {manualIncidents.map((row) => (
                      <li>
                        {
                          editorialSections[
                            row.id as keyof typeof editorialSections
                          ]
                        }{' '}
                        · {row.note}
                      </li>
                    ))}
                  </ul>
                </details>
              )}
              {changes.length > 0 && (
                <details>
                  <summary>
                    Publications dans Polradar ({changes.length})
                  </summary>
                  <ul>
                    {changes.map((item) => (
                      <li>
                        <a href={item.path}>{item.title}</a>
                      </li>
                    ))}
                  </ul>
                </details>
              )}
              {passage.hosted && (
                <a
                  href={
                    meta.repository +
                    '/actions/runs/' +
                    passage.hosted.run +
                    '/attempts/' +
                    passage.hosted.attempt
                  }
                >
                  Rapport du passage ↗
                </a>
              )}
            </article>
          );
        })}
      </div>
      <a href="/mises-a-jour/#revue-editoriale">
        Consulter le journal de veille
      </a>
    </section>
  )}
</Base>
<style>
  .day-facts {
    margin-block: 1.4rem;
    border-top: 1px solid var(--line);
    padding-block: 1rem;
  }
  .day-facts h2 {
    font-size: 1.14rem;
  }
  .day-facts li {
    margin: 0.65rem 0;
  }
  .day-facts p,
  .day-facts li {
    line-height: 1.5;
  }
  .day-facts a {
    color: var(--ink);
    text-underline-offset: 0.18em;
  }
  .edition-passes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 0.75rem;
    margin-block: 0.85rem;
  }
  .edition-pass {
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: 0.55rem;
    background: var(--panel-gradient);
    overflow-wrap: anywhere;
  }
  .edition-pass h3 {
    margin: 0 0 0.3rem;
    font-size: 1rem;
  }
  .edition-pass time {
    color: var(--muted);
    font-size: 0.88rem;
  }
  .edition-pass p {
    margin-block: 0.5rem;
  }
  .edition-pass summary {
    cursor: pointer;
    padding-block: 0.4rem;
  }
  .edition-pass > a {
    display: inline-block;
    margin-top: 0.55rem;
  }
</style>
