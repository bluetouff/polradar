---
import CSGPaie from '../../components/CSGPaie.astro';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import DossierPaie from '../../components/DossierPaie.astro';
import DossierTerritoire from '../../components/DossierTerritoire.astro';
import { healthMeasures } from '../../lib/dossiers-territoriaux';
import '../../styles/dossiers-terrain.css';
import {
  activeCandidates as candidates,
  formatDate,
  formatTimestamp,
  scopes,
} from '../../lib/data';
import {
  questions,
  questionThemes,
  latestSourceCheck,
} from '../../lib/questions';
import { digitalLawSections } from '../../lib/digital-law-data';
import { sameSentence } from '../../lib/measure-text';
import { voteCasePath } from '../../lib/legislative-votes.mjs';
import { voteCases } from '../../lib/votes-data';
import { proposalTracks } from '../../lib/proposal-data';
import { retirementPath } from '../../lib/retirement-comparison.mjs';
import '../../styles/questions.css';
export function getStaticPaths() {
  return questions.map((q) => ({ params: { id: q.id }, props: { q } }));
}
const { q } = Astro.props;
const payrollReadings: Record<string, string> = {
  'attal-csg-salaires':
    'Sur la paie à 2 000 € bruts, la CSG actuelle est de 180,78 €. Effacer entièrement cette ligne libérerait ce montant avant impôt, à autres prélèvements constants. La campagne ne publie pas le barème reliant cet exemple à son gain maximal.',
  'zemmour-csg-activite':
    'Pour le salarié de notre exemple, la ligne supprimée représenterait 180,78 € avant impôt. Le gain final d’un indépendant dépend de son assiette et de ses prélèvements propres.',
  'glucksmann-csg-salaires':
    'Le candidat chiffre son exemple à 2 000 € nets. Pour une paie à 2 000 € bruts, il faudrait connaître le taux applicable et le salaire net de départ.',
  'villepin-cotisations-vers-csg':
    'Pour établir une nouvelle fiche de paie, il faudrait les cotisations supprimées et les nouveaux taux de CSG. Les deux gains cités sont les estimations du programme à dix ans.',
};
const t = questionThemes.find((x) => x.id === q.theme)!;
const digitalCase = digitalLawSections
  .flatMap((section) => section.cases)
  .find((item) => q.id === 'numerique-' + item.id);
const covered = candidates.filter((c) => q.candidateIds.includes(c.id));
const missing = candidates.filter((c) => !q.candidateIds.includes(c.id));
const ids = new Set(q.entries.map((e) => e.measure.id));
const votes = voteCases.filter((v) => ids.has(v.measureId));
const tracks = proposalTracks.filter((v) =>
  v.measureIds.some((id) => ids.has(id)),
);
const checkLabels = {
  accessible: 'Accessible',
  modifie: 'Changement à relire',
  bloque: 'Accès bloqué',
  indisponible: 'Indisponible',
};
---

<Base
  title={q.title}
  section="/questions/"
  description={
    'Positions recensées, textes de campagne et sources sur cette question. ' +
    t.label +
    '.'
  }
>
  <nav class="breadcrumbs" aria-label="Fil d’Ariane">
    <a href="/questions/">Qui propose quoi ?</a>
    <span>/</span>
    <a href={'/questions/#' + t.id}>{t.label}</a>
  </nav>
  <header class="q-intro">
    <div>
      <h1>{q.title}</h1>
      <p>
        {covered.length} dossier{covered.length === 1 ? '' : 's'} avec une
        réponse sourcée sur {candidates.length} candidats suivis
      </p>
    </div>
    <Icon name={t.icon} />
  </header>
  <nav class="q-related" aria-label="Explorer cette question">
    <a href={'/comparer/?question=' + q.id} data-compare-return>
      Comparer deux candidats sur cette question ↗
    </a>
    {q.related && <a href={q.related.href}>{q.related.label} ↗</a>}
    {q.id === 'retraites-conditions-depart' && (
      <>
        <a href="/themes/retraites/">
          Toutes les propositions sur les retraites ↗
        </a>
        <a href={retirementPath}>
          Programmes et droit en vigueur par génération ↗
        </a>
      </>
    )}
    {q.id === 'retraites-protection-revenus' && (
      <a href="/dossiers/indexation-pensions/">
        Effets sur les ménages et les finances publiques ↗
      </a>
    )}
    <a href="#couverture">Voir les dossiers examinés ↓</a>
  </nav>
  {q.id === 'fiscalite-csg-salaires' && <DossierPaie />}
  {q.id === 'logement-obligations-parc-social' && (
    <DossierTerritoire mode="sru" />
  )}
  {q.id === 'fiscalite-csg-salaires' && <CSGPaie />}
  {q.id === 'sante-installation-medecins' && <DossierTerritoire mode="apl" />}
  <div class="q-answers">
    {covered.map((c) => (
      <article class="q-answer" id={'candidat-' + c.id}>
        <header>
          <Icon name="people" />
          <h2>
            <a href={'/candidats/' + c.id + '/'}>{c.name}</a>
          </h2>
        </header>
        {q.entries
          .filter((e) => e.candidate.id === c.id)
          .map(({ measure, version, author, refs }) => (
            <section>
              <p class="q-byline">
                {scopes[version.snapshot.scope]}
                {version.snapshot.scope === 'parti' && ' · ' + author}
                {refs.some((r) => r.source.originalFormat) &&
                  ' · Déclaration publique'}
              </p>
              <h3>
                <a
                  href={
                    '/mesures/' + measure.id + '/#version-' + version.number
                  }
                >
                  {version.snapshot.title}
                </a>
              </h3>
              {!sameSentence(
                version.snapshot.title,
                version.snapshot.description,
              ) && <p>{version.snapshot.description}</p>}
              {q.id === 'fiscalite-csg-salaires' && (
                <dl class="terrain-details">
                  <div>
                    <dt>Personnes concernées</dt>
                    <dd>
                      {version.snapshot.beneficiaries ??
                        'Public non précisé dans le texte.'}
                    </dd>
                  </div>
                  <div>
                    <dt>Calendrier</dt>
                    <dd>{version.snapshot.timing ?? 'Date non précisée.'}</dd>
                  </div>
                  <div>
                    <dt>Effet sur la paie</dt>
                    <dd>{payrollReadings[measure.id]}</dd>
                  </div>
                  <div>
                    <dt>Financement annoncé</dt>
                    <dd>{version.snapshot.financing ?? 'À documenter.'}</dd>
                  </div>
                </dl>
              )}
              {q.id === 'sante-installation-medecins' &&
                healthMeasures[measure.id] && (
                  <dl class="terrain-details">
                    <div>
                      <dt>Public concerné</dt>
                      <dd>{healthMeasures[measure.id][0]}</dd>
                    </div>
                    <div>
                      <dt>Décision et mise en œuvre</dt>
                      <dd>{healthMeasures[measure.id][1]}</dd>
                    </div>
                    <div>
                      <dt>Calendrier</dt>
                      <dd>
                        {version.snapshot.timing ??
                          'Date de mise en œuvre non précisée dans ce passage.'}
                      </dd>
                    </div>
                  </dl>
                )}
              {q.id === 'logement-obligations-parc-social' &&
                version.snapshot.timing && (
                  <p>
                    <strong>Échéance annoncée</strong> ·{' '}
                    {version.snapshot.timing}
                  </p>
                )}
              {version.number !== measure.revision && (
                <p class="q-stale">
                  <a href={'/mesures/' + measure.id + '/'}>
                    Une version plus récente de cette fiche est disponible ↗
                  </a>
                </p>
              )}
              <details class="q-citations">
                <summary>Sources et dates ({refs.length})</summary>
                {refs.map((ref) => {
                  const check = latestSourceCheck(ref.sourceId);
                  return (
                    <div>
                      <a
                        href={
                          ref.fragment
                            ? ref.source.url.split('#')[0] + '#' + ref.fragment
                            : ref.source.url
                        }
                        rel="noreferrer"
                      >
                        {ref.source.title} ↗
                      </a>
                      <p>{ref.locator}</p>
                      <small>
                        {ref.source.published
                          ? 'Publié le ' + formatDate(ref.source.published)
                          : ref.source.publishedYear
                            ? 'Publié en ' + ref.source.publishedYear
                            : 'Date de publication non précisée'}{' '}
                        · Consulté le {formatDate(ref.source.checked)}
                      </small>
                      <small>
                        {check
                          ? checkLabels[check.status] +
                            ' au contrôle du ' +
                            formatTimestamp(check.checkedAt)
                          : ref.source.watch
                            ? 'Contrôle de ce document indisponible dans le dernier rapport.'
                            : 'Document hors veille quotidienne.'}
                      </small>
                    </div>
                  );
                })}
              </details>
            </section>
          ))}
      </article>
    ))}
  </div>
  {digitalCase?.contextMeasures.length ? (
    <section class="q-coverage">
      <h2>
        {digitalCase.id === 'signalement-cyber'
          ? 'Signaler un délit en tant que victime'
          : 'Protection générale des communications'}
      </h2>
      {digitalCase.contextMeasures.map((item) => (
        <p>
          {item.author} · <a href={item.href}>{item.title}</a>
        </p>
      ))}
      <p>
        <a href={digitalCase.href}>
          Consulter les règles en vigueur et les travaux parlementaires ↗
        </a>
      </p>
    </section>
  ) : null}
  <section class="q-coverage" id="couverture">
    <h2>Couverture documentaire</h2>
    <p>
      {covered.length} dossier{covered.length === 1 ? '' : 's'} avec une
      proposition, une orientation ou un texte de parti relié à cette question.
    </p>
    {q.reviews.length > 0 && (
      <div class="q-reviews">
        <h3>Documents examinés sans réponse sur cette question</h3>
        {q.reviews.map((r) => {
          const check = latestSourceCheck(r.sourceId);
          return (
            <p id={'revue-' + r.candidate}>
              <strong>
                {candidates.find((c) => c.id === r.candidate)?.name}
              </strong>{' '}
              · {r.locator} Aucune proposition explicite sur cette question
              relevée lors de la lecture du {formatDate(r.checked)}.{' '}
              <a href={r.source.url}>Ouvrir le document ↗</a>
              {check && (
                <small class="q-review-status">
                  Contrôle du {formatTimestamp(check.checkedAt)} ·{' '}
                  {checkLabels[check.status]}
                </small>
              )}
            </p>
          );
        })}
      </div>
    )}
    {missing.length > 0 && (
      <details>
        <summary>
          {missing.length} candidat{missing.length === 1 ? '' : 's'} sans fiche
          reliée à cette question
        </summary>
        <p>
          Polradar n’a pas encore relié de réponse sourcée à ces dossiers. Le
          nom ouvre la fiche du candidat et les documents déjà recensés.
        </p>
        <ul>
          {missing.map((c) => (
            <li>
              <a href={'/candidats/' + c.id + '/'}>{c.name}</a>
            </li>
          ))}
        </ul>
      </details>
    )}
  </section>
  {(votes.length > 0 || tracks.length > 0) && (
    <section class="q-coverage">
      <h2>Votes et versions liés aux propositions</h2>
      <ul>
        {votes.map((v) => (
          <li>
            <a href={voteCasePath(v.id)}>{v.title} · scrutin ↗</a>
          </li>
        ))}
        {tracks.map((v) => (
          <li>
            <a href={'/evolution/#dossier=' + v.id}>{v.title} · évolution ↗</a>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>

<script>
  const link = document.querySelector<HTMLAnchorElement>(
    '[data-compare-return]',
  );
  const selectionFragment = '#comparaison?';
  if (link && location.hash.startsWith(selectionFragment)) {
    const from = new URLSearchParams(
      location.hash.slice(selectionFragment.length),
    );
    const to = new URLSearchParams();
    const slug = /^[a-z0-9]+(?:-[a-z0-9]+)*$/;
    const ids = [...new Set((from.get('c') ?? '').slice(0, 302).split(','))]
      .filter((id) => id.length <= 100 && slug.test(id))
      .slice(0, 3);
    const theme = from.get('theme');
    if (ids.length) {
      to.set('c', ids.join(','));
      link.textContent = 'Reprendre la comparaison ↗';
    }
    if (theme && theme.length <= 100 && slug.test(theme))
      to.set('theme', theme);
    if (from.get('count') === '3') to.set('count', '3');
    if (from.get('archives') === '1') to.set('archives', '1');
    if (to.size) link.hash = selectionFragment + to.toString();
  }
</script>
