---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { groups } from '../lib/navigation';

const professionals = [
  ['/donnees/', 'Données ouvertes et exports'],
  ['/studio/', 'Studio graphique'],
  ['/presse/', 'Espace presse et partenariats'],
  ['/api/', 'API publique'],
  ['/mcp/', 'Serveur MCP'],
  ['/mcp/documentation/', 'Documentation pour les assistants'],
  ['/mcp/statistiques/', 'Activité du serveur MCP'],
] as const;
const professionalUrls = new Set<string>(professionals.map(([url]) => url));
---

<Base
  title="Toutes les rubriques"
  description="Retrouvez les rubriques de Polradar, les outils de comparaison et les données de la présidentielle 2027."
>
  <header class="page-title">
    <h1>Toutes les rubriques</h1>
  </header>
  <div class="rubrique-index">
    {groups.map((group) => (
      <section id={group.id} aria-labelledby={group.id + '-rubriques'}>
        <h2 id={group.id + '-rubriques'}>
          <Icon name={group.icon} /> {group.name}
        </h2>
        <ul>
          {group.links
            .filter(([url]) => !professionalUrls.has(url))
            .map(([url, label]) => (
              <li>
                <a href={url}>{label}</a>
              </li>
            ))}
        </ul>
      </section>
    ))}
    <section id="professionnels" aria-labelledby="professionnels-rubriques">
      <h2 id="professionnels-rubriques">
        <Icon name="donnees" /> Données et outils professionnels
      </h2>
      <ul>
        {professionals.map(([url, label]) => (
          <li>
            <a href={url}>{label}</a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>

<style>
  .rubrique-index {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(17rem, 100%), 1fr));
    align-items: start;
    gap: 0.85rem;
  }
  .rubrique-index section {
    min-inline-size: 0;
    padding: 0.6rem;
    border: 1px solid var(--line);
    border-radius: var(--surface-radius);
    background: var(--sheet);
    overflow-wrap: anywhere;
  }
  .rubrique-index #professionnels {
    background: var(--light);
  }
  .rubrique-index h2 {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 0.35rem;
    padding: 0.55rem 0.65rem;
    border-inline-start: 2px solid var(--accent);
    border-radius: 0.25rem;
    background: var(--light);
    color: var(--accent);
    font: 400 1.18rem/1.25 var(--serif);
    text-wrap: wrap;
  }
  .rubrique-index h2 :global(.icon) {
    flex: none;
    inline-size: 1rem;
    block-size: 1rem;
  }
  .rubrique-index ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .rubrique-index a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.55rem;
    min-height: var(--target-size);
    padding: 0.33rem 0.65rem;
    border-radius: 0.3rem;
    font-size: 0.9rem;
    text-decoration: none;
  }
  .rubrique-index a::after {
    content: '';
    flex: 0 0 0.35rem;
    block-size: 0.35rem;
    border: solid var(--accent);
    border-width: 0 1.5px 1.5px 0;
    transform: rotate(-45deg);
  }
  .rubrique-index a:is(:hover, :focus-visible) {
    background: var(--paper);
    text-decoration: underline;
  }
</style>
