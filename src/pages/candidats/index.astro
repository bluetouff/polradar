---
import PagedResults from '../../components/PagedResults.astro';
import Base from '../../layouts/Base.astro';
import CandidateCard from '../../components/CandidateCard.astro';
import Icon from '../../components/Icon.astro';
import { candidates, themes } from '../../lib/data';
import '../../styles/candidates.css';
---

<Base title="Candidats" section="/candidats/">
  <header class="registry-heading">
    <div>
      <p class="registry-kicker">PRÉSIDENTIELLE 2027 / LES DOSSIERS</p>
      <h1>
        Candidats <span>{candidates.length}</span>
      </h1>
      <p>Les personnalités, leurs propositions et les textes consultés.</p>
    </div>
    <a class="divergence-invite" href="/echiquier/">
      <Icon name="exchange" />
      <span>
        <strong>Échiquier politique</strong>
        <small>Partis, positions et données par candidature</small>
      </span>
      <span aria-hidden="true">↗</span>
    </a>
  </header>
  <div class="registry-controls" data-candidate-controls hidden>
    <label>
      <span>Nom ou formation politique</span>
      <input
        type="search"
        data-candidate-query
        placeholder="Rechercher une candidature…"
        autocomplete="off"
      />
    </label>
    <label>
      <span>Explorer les fiches par thème</span>
      <select data-candidate-theme>
        <option value="">Tous les thèmes</option>
        {themes.map((theme) => (
          <option value={theme.id}>{theme.label}</option>
        ))}
      </select>
    </label>
    <p role="status" data-candidate-status aria-live="polite"></p>
  </div>
  <div class="registry-legend">
    <span>Ordre alphabétique</span>
    <p>Les repères colorés indiquent les thèmes documentés dans Polradar.</p>
    <a href="/credits-photos/">Crédits photos ↗</a>
  </div>
  <PagedResults total={candidates.length}>
    <div class="candidate-gallery" id="candidate-list">
      {candidates.map((candidate) => (
        <CandidateCard candidate={candidate} />
      ))}
    </div>
  </PagedResults>
  <aside class="notice section-space">
    <strong>
      Déclaration, investiture et validation sont des étapes distinctes.
    </strong>
    <p>
      Chaque dossier cite la source de son statut. L’admission au scrutin relève
      du Conseil constitutionnel. Une fiche peu renseignée reflète le périmètre
      du corpus et ne démontre pas l’absence de propositions.
    </p>
    <a href="/reperes/">Comprendre les étapes ↗</a>
  </aside>
  <script src="../../scripts/candidates.ts"></script>
</Base>
