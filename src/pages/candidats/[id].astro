---
import PagedResults from '../../components/PagedResults.astro';
import Base from '../../layouts/Base.astro';
import MeasureCard from '../../components/MeasureCard.astro';
import FollowButton from '../../components/FollowButton.astro';
import SourceLinks from '../../components/SourceLinks.astro';
import CandidatePortrait from '../../components/CandidatePortrait.astro';
import { campaignBriefs } from '../../lib/briefs';
import CandidateActivity from '../../components/CandidateActivity.astro';
import Icon from '../../components/Icon.astro';
import {
  candidates,
  formatDate,
  measureById,
  measures,
  sourceById,
  themes,
} from '../../lib/data';
import { documents } from '../../lib/documents';
import { portraitLinks } from '../../lib/portrait-links.mjs';
import { portraitFor } from '../../lib/portraits';
import { proposalTracks, financingMaps } from '../../lib/proposal-data';
import { voteCasePath } from '../../lib/legislative-votes.mjs';
import { voteCases } from '../../lib/votes-data';
import { questions } from '../../lib/questions';
import '../../styles/candidates.css';
export function getStaticPaths() {
  return candidates.map((candidate) => ({
    params: { id: candidate.id },
    props: { candidate },
  }));
}
const { candidate } = Astro.props;
const briefs = (await campaignBriefs()).filter((b) =>
  b.event.candidates.includes(candidate.id),
);
const records = measures.filter(
  (measure) => measure.candidate === candidate.id,
);
const current = records.filter((record) => record.scope !== 'archive');
const archives = records.filter((record) => record.scope === 'archive');
const byTheme = themes.map((theme) => ({
  ...theme,
  items: current.filter((measure) => measure.theme === theme.id),
}));
const documented = byTheme.filter((theme) => theme.items.length);
const missing = byTheme.filter((theme) => !theme.items.length);
const portrait = portraitFor(candidate.id);
const externalPortrait = portraitLinks[candidate.id];
const evolutionLink = proposalTracks.find((t) => t.candidate === candidate.id);
const financingLink = financingMaps.find((m) => m.candidate === candidate.id);
const votesLink = voteCases.find((v) => v.candidate === candidate.id);
const statusSource = sourceById(candidate.statusSource);
const programmeReviews = documents.flatMap((document) =>
  document.coverage && document.candidates.includes(candidate.id)
    ? [document.coverage]
    : [],
);
const internationalQuestions = questions.filter(
  (question) =>
    question.theme === 'europe' && question.candidateIds.includes(candidate.id),
);
const candidateQuestions = questions.filter(
  (question) =>
    question.candidateIds.includes(candidate.id) ||
    question.complements.some(
      ({ candidate: person }) => person.id === candidate.id,
    ),
);
---

<Base
  title={candidate.name}
  description={`${candidate.party} : engagements documentés, textes consultés et sources pour la présidentielle 2027.`}
  section="/candidats/"
>
  <div class="breadcrumbs">
    <a href="/candidats/">Candidats</a>
    <span>/</span>
    <span>{candidate.name}</span>
  </div>
  <header class="candidate-hero">
    <figure>
      <div class="profile-portrait">
        <CandidatePortrait candidate={candidate} eager />
      </div>
      {portrait ? (
        <figcaption>
          <a href={`/credits-photos/#${candidate.id}`}>
            Photo {portrait.credit.year} · crédits ↗
          </a>
        </figcaption>
      ) : (
        externalPortrait && (
          <figcaption>
            <a href={externalPortrait.url} rel="noreferrer">
              {externalPortrait.label} ↗
            </a>
          </figcaption>
        )
      )}
    </figure>
    <div class="profile-identity">
      <p class="profile-party">{candidate.party}</p>
      <h1>{candidate.name}</h1>
      <p class="profile-status">{candidate.status}</p>
      <p class="profile-checked">
        <a href="#source-du-statut">
          Statut vérifié le{' '}
          <time datetime={statusSource.checked}>
            {formatDate(statusSource.checked)}
          </time>
        </a>
      </p>
    </div>
    <div class="profile-intro">
      <p class="candidate-summary">{candidate.note}</p>
      <div class="feature-actions">
        <a
          class="button primary"
          aria-label={`Comparer les propositions de ${candidate.name}`}
          href={`/comparer/?c=${candidate.id}&theme=retraites`}
        >
          <Icon name="exchange" />
          <span>Comparer</span>
        </a>
        <FollowButton
          kind="candidate"
          id={candidate.id}
          name={candidate.name}
        />
      </div>
    </div>
    <dl class="profile-figures" aria-label="Contenu du dossier">
      <div>
        <dt>
          <a href="#mesures-du-candidat">Fiches hors archives</a>
        </dt>
        <dd>{current.length}</dd>
      </div>
      <div>
        <dt>Thèmes renseignés</dt>
        <dd>
          {documented.length}
          <small> / {themes.length}</small>
        </dd>
      </div>
      <div>
        <dt>Archives de 2022</dt>
        <dd>{archives.length}</dd>
      </div>
    </dl>
  </header>
  <nav class="profile-jumps" aria-label="Dans ce dossier">
    <a href="#mesures-du-candidat">Mesures et orientations</a>
    {programmeReviews.length > 0 && (
      <a href="#programme-lecture">Relecture du programme</a>
    )}
    <a href={'/documents/candidats/' + candidate.id + '/'}>
      Documents et passages cités
    </a>
    {votesLink && <a href={voteCasePath(votesLink.id)}>Votes passés</a>}
    {evolutionLink && (
      <a href={`/evolution/#dossier=${evolutionLink.id}`}>Évolutions</a>
    )}
    {financingLink && (
      <a href={`/financements/#carte=${financingLink.id}`}>Financements</a>
    )}
    {archives.length > 0 && <a href="#archives-2022">Archives 2022</a>}
  </nav>
  {internationalQuestions.length > 0 && (
    <nav class="profile-jumps" aria-label="Europe et monde">
      {internationalQuestions.map((question) => (
        <a href={question.href + '#candidat-' + candidate.id}>
          {question.title}
        </a>
      ))}
    </nav>
  )}
  {candidateQuestions.length > 0 && (
    <details class="profile-topic-index profile-question-index">
      <summary>
        <Icon name="layers" />
        Grandes questions ({candidateQuestions.length})
        <Icon name="chevron" />
      </summary>
      <nav class="profile-jumps" aria-label="Grandes questions documentées">
        {candidateQuestions.map((question) => (
          <a href={question.href + '#candidat-' + candidate.id}>
            {question.title}
          </a>
        ))}
      </nav>
    </details>
  )}
  <div class="profile-layout">
    <div>
      <div class="section-heading">
        <div>
          <span id="mesures-du-profil" aria-hidden="true"></span>
          <h2 id="mesures-du-candidat">Mesures et orientations</h2>
        </div>
      </div>
      {current.length ? (
        <PagedResults total={current.length}>
          <div data-document-list>
            {documented.map((theme) => (
              <section
                data-page-group
                class="candidate-theme"
                id={`theme-${theme.id}`}
              >
                <header class="candidate-theme-heading">
                  <Icon name={theme.id} />
                  <h3>{theme.label}</h3>
                  <span>
                    {theme.items.length} fiche
                    {theme.items.length > 1 ? 's' : ''}
                  </span>
                </header>
                <div class="measure-list">
                  {theme.items.map((item) => (
                    <MeasureCard measure={item} level="h4" />
                  ))}
                </div>
              </section>
            ))}
          </div>
        </PagedResults>
      ) : (
        <div class="notice">
          <p>Aucune proposition récente documentée pour cette candidature.</p>
        </div>
      )}
      {programmeReviews.length > 0 && (
        <section class="programme-reading" aria-labelledby="programme-lecture">
          <h2 id="programme-lecture">Relecture du programme</h2>
          {programmeReviews.map((review) => (
            <details>
              <summary>
                <strong>{review.perimeter}</strong>
                <span>
                  {review.total} sections identifiées · {review.reviewed} relues
                  · {review.remaining} à examiner
                </span>
              </summary>
              <p>
                Relecture du{' '}
                <time datetime={review.checked}>
                  {formatDate(review.checked)}
                </time>
                .
              </p>
              <ol>
                {review.units.map((unit) => (
                  <li>
                    <a href={unit.sourceUrl} rel="noreferrer">
                      {unit.title} ↗
                    </a>
                    {unit.review === 'sans-engagement-precis' && (
                      <small>Sans engagement précis</small>
                    )}
                    {unit.review === 'a-examiner' && <small>À examiner</small>}
                    {unit.review === 'a-completer' && (
                      <small>Relecture à compléter</small>
                    )}
                    {unit.measureIds.length > 0 && (
                      <ul>
                        {unit.measureIds.map((id) => (
                          <li>
                            <a href={`/mesures/${id}/`}>
                              {measureById(id).title}
                            </a>
                          </li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))}
              </ol>
            </details>
          ))}
        </section>
      )}
      {briefs.length > 0 && (
        <section class="candidate-briefs">
          <h2>Brèves de campagne</h2>
          <ul>
            {briefs.map((b) => (
              <li>
                <a href={b.href}>{b.article.data.title}</a>
              </li>
            ))}
          </ul>
        </section>
      )}
      <CandidateActivity candidate={candidate} />
      <p>
        <a
          class="inline-action"
          href={'/documents/candidats/' + candidate.id + '/'}
        >
          Documents et passages cités dans ce dossier ↗
        </a>
      </p>
      <p>
        <a class="inline-action" href={`/numerique/candidats/#${candidate.id}`}>
          Numérique · mesures et documents examinés ↗
        </a>
      </p>
      {missing.length > 0 && (
        <details class="missing-themes">
          <summary>Les thèmes restant à documenter ({missing.length})</summary>
          <ul>
            {missing.map((t) => (
              <li>{t.label}</li>
            ))}
          </ul>
        </details>
      )}
      {archives.length > 0 && (
        <section class="section-space">
          <div class="section-heading">
            <div>
              <h2 id="archives-2022">Archives de 2022</h2>
            </div>
          </div>
          <p class="section-description">
            La confirmation d’une candidature ne reconduit pas automatiquement
            son ancien programme.
          </p>
          <div class="measure-list">
            {archives.map((item) => (
              <MeasureCard measure={item} />
            ))}
          </div>
        </section>
      )}
    </div>
    <aside class="profile-aside" aria-label="Parcourir le dossier">
      {documented.length > 0 && (
        <details class="profile-topic-index">
          <summary>
            <Icon name="layers" />
            Accès par thème
            <Icon name="chevron" />
          </summary>
          <nav class="profile-theme-nav" aria-label="Thèmes documentés">
            {documented.map((theme) => (
              <a href={`#theme-${theme.id}`}>
                <Icon name={theme.id} />
                <span>{theme.label}</span>
                <span aria-label={`${theme.items.length} fiches`}>
                  {theme.items.length}
                </span>
              </a>
            ))}
          </nav>
        </details>
      )}
      {(votesLink || evolutionLink || financingLink) && (
        <section class="profile-resources">
          <h2>Analyses du programme</h2>
          <nav
            class="profile-evidence-links"
            aria-label="Analyses du programme"
          >
            {votesLink && (
              <a href={voteCasePath(votesLink.id)}>
                <Icon name="vote" />
                <span>Propositions et votes passés</span>
                <Icon name="arrow" />
              </a>
            )}
            {evolutionLink && (
              <a href={`/evolution/#dossier=${evolutionLink.id}`}>
                <Icon name="historique" />
                <span>Évolution des propositions</span>
                <Icon name="arrow" />
              </a>
            )}
            {financingLink && (
              <a href={`/financements/#carte=${financingLink.id}`}>
                <Icon name="exchange" />
                <span>Carte des financements</span>
                <Icon name="arrow" />
              </a>
            )}
          </nav>
        </section>
      )}
      <section class="profile-resources" id="source-du-statut">
        <h2>Source du statut</h2>
        <SourceLinks ids={[candidate.statusSource]} />
        <a href="/transparence/" class="text-link">
          Périmètre du suivi ↗
        </a>
      </section>
      {candidate.programmeReview && (
        <details class="profile-topic-index">
          <summary>
            <Icon name="source" />
            Sources du programme
            <Icon name="chevron" />
          </summary>
          <p>
            Vérifiées le{' '}
            <time datetime={candidate.programmeReview.checked}>
              {formatDate(candidate.programmeReview.checked)}
            </time>
            .
          </p>
          <SourceLinks ids={candidate.programmeReview.sources} compact />
        </details>
      )}
    </aside>
  </div>
  <script src="../../scripts/document-pages.ts"></script>
</Base>
