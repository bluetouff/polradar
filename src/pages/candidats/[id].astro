---
import Base from '../../layouts/Base.astro';
import MeasureCard from '../../components/MeasureCard.astro';
import FollowButton from '../../components/FollowButton.astro';
import SourceLinks from '../../components/SourceLinks.astro';
import CandidatePortrait from '../../components/CandidatePortrait.astro';
import Icon from '../../components/Icon.astro';
import { candidates, measures, themes } from '../../lib/data';
import { portraitFor } from '../../lib/portraits';
import { proposalTracks, financingMaps } from '../../lib/proposal-data';
import { voteCases } from '../../lib/votes-data';
import '../../styles/candidates.css';
export function getStaticPaths() {
  return candidates.map((candidate) => ({
    params: { id: candidate.id },
    props: { candidate },
  }));
}
const { candidate } = Astro.props;
const records = measures.filter(
  (measure) => measure.candidate === candidate.id,
);
const current = records.filter((record) => record.scope !== 'archive');
const archives = records.filter((record) => record.scope === 'archive');
const covered = new Set(current.map((measure) => measure.theme)).size;
const portrait = portraitFor(candidate.id);
const evolutionLink = proposalTracks.find((t) => t.candidate === candidate.id);
const financingLink = financingMaps.find((m) => m.candidate === candidate.id);
const votesLink = voteCases.find((v) => v.candidate === candidate.id);
---

<Base
  title={candidate.name}
  description={`${candidate.party} : engagements documentés, textes consultés et sources pour la présidentielle 2027.`}
  section="/candidats/"
>
  <div class="breadcrumbs">
    <a href="/candidats/">Candidatures</a>
    <span>/</span>
    <span>{candidate.name}</span>
  </div>
  <header class="candidate-hero">
    <figure>
      <div class="profile-portrait">
        <CandidatePortrait candidate={candidate} eager />
      </div>
      {portrait && (
        <figcaption>
          <a href={`/credits-photos/#${candidate.id}`}>
            Photo {portrait.credit.year} · crédits ↗
          </a>
        </figcaption>
      )}
    </figure>
    <div>
      <p class="eyebrow">{candidate.party}</p>
      <h1>{candidate.name}</h1>
      <span class="tag">{candidate.status}</span>
      <p class="candidate-summary">{candidate.note}</p>
      <div class="feature-actions">
        <a
          class="button primary"
          href={`/comparer/?c=${candidate.id},${candidate.id === 'melenchon' ? 'philippe' : 'melenchon'}&theme=retraites`}
        >
          Comparer ses propositions ↗
        </a>
        <FollowButton
          kind="candidate"
          id={candidate.id}
          name={candidate.name}
        />
      </div>
      {(evolutionLink || financingLink || votesLink) && (
        <nav class="profile-evidence-links" aria-label="Analyses du programme">
          {votesLink && (
            <a href={`/votes/#dossier=${votesLink.id}`}>
              <Icon name="vote" />
              Propositions et votes passés
            </a>
          )}
          {evolutionLink && (
            <a href={`/evolution/#dossier=${evolutionLink.id}`}>
              <Icon name="historique" />
              Évolution des propositions
            </a>
          )}
          {financingLink && (
            <a href={`/financements/#carte=${financingLink.id}`}>
              <Icon name="exchange" />
              Carte des financements
            </a>
          )}
        </nav>
      )}
      {covered > 0 && (
        <nav class="profile-theme-nav" aria-label="Thèmes documentés">
          {themes
            .filter((theme) => current.some((row) => row.theme === theme.id))
            .map((theme) => (
              <a href={`#theme-${theme.id}`}>
                <Icon name={theme.id} />
                {theme.label}
              </a>
            ))}
        </nav>
      )}
    </div>
  </header>
  <div class="profile-layout">
    <aside class="profile-aside">
      <p class="eyebrow">ÉTAT DU DOSSIER</p>
      <b>
        {covered}
        <span> / {themes.length} thèmes</span>
      </b>
      <p>
        Renseignés dans ce corpus, orientations incluses. Les archives de 2022
        sont comptées à part.
      </p>
      <hr />
      <p class="eyebrow">SOURCE DU STATUT</p>
      <SourceLinks ids={[candidate.statusSource]} />
      <a href="/transparence/" class="text-link">
        Périmètre du suivi ↗
      </a>
    </aside>
    <div>
      <div class="section-heading">
        <div>
          <h2>Mesures et orientations</h2>
        </div>
      </div>
      {current.length ? (
        themes.map((theme) => {
          const items = current.filter((item) => item.theme === theme.id);
          return (
            items.length > 0 && (
              <section class="candidate-theme" id={`theme-${theme.id}`}>
                <header class="candidate-theme-heading">
                  <Icon name={theme.id} />
                  <h3>{theme.label}</h3>
                  <span>
                    {items.length} fiche{items.length > 1 ? 's' : ''}
                  </span>
                </header>
                <div class="measure-list">
                  {items.map((item) => (
                    <MeasureCard measure={item} level="h4" />
                  ))}
                </div>
              </section>
            )
          );
        })
      ) : (
        <div class="notice">
          <h3>Aucune fiche de campagne 2027</h3>
          <p>
            Le corpus actuel ne contient pas encore de fiche de campagne récente
            pour cette candidature. Les archives sont séparées ci-dessous.
          </p>
        </div>
      )}
      <details class="missing-themes">
        <summary>
          Les thèmes restant à documenter ({themes.length - covered})
        </summary>
        <ul>
          {themes
            .filter((t) => !current.some((e) => e.theme === t.id))
            .map((t) => (
              <li>{t.label}</li>
            ))}
        </ul>
      </details>
      {archives.length > 0 && (
        <section class="section-space">
          <div class="section-heading">
            <div>
              <h2>Archives de 2022</h2>
            </div>
          </div>
          <p class="section-description">
            La confirmation d’une candidature ne reconduit pas automatiquement
            son ancien programme.
          </p>
          <div class="measure-list">
            {archives.map((item) => (
              <MeasureCard measure={item} />
            ))}
          </div>
        </section>
      )}
    </div>
  </div>
</Base>
