---
import PagedResults from '../components/PagedResults.astro';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { measures, versions, candidates, formatDate } from '../lib/data';
import { sourceCommit } from '../../scripts/release-revision.mjs';
const updated = versions
  .filter((version) => version.kind !== 'import')
  .sort((a, b) => b.observedOn.localeCompare(a.observedOn));
---

<Base title="Historique des fiches" section="/historique/">
  <header class="page-title feature-title">
    <span class="feature-emblem">
      <Icon name="historique" />
    </span>
    <div>
      <h1>Historique des fiches</h1>
      <p>
        {versions.length} versions conservées pour {measures.length} fiches. Les
        précisions éditoriales sont distinguées des évolutions de programme.
      </p>
    </div>
  </header>
  <p class="notice">
    <a href="/evolution/">
      Comparer les propositions dans les documents officiels ↗
    </a>
  </p>
  <section
    id="comparaison-historique"
    class="version-workbench"
    data-source-commit={sourceCommit ?? undefined}
  >
    <div class="register-heading">
      <h2 id="history-heading">Comparer deux états d’une fiche</h2>
    </div>
    <form
      id="history-form"
      class="facet-filters"
      action="/historique/#comparaison-historique"
      method="get"
      aria-labelledby="history-heading"
      hidden
    >
      <label for="history-measure">
        Fiche
        <select id="history-measure" name="mesure" required>
          <option value="">Choisir une fiche</option>
          {measures.map((measure) => (
            <option value={measure.id}>
              {
                candidates.find(
                  (candidate) => candidate.id === measure.candidate,
                )!.name
              }{' '}
              · {measure.title}
            </option>
          ))}
        </select>
      </label>
      <label for="history-mode">
        Comparer par
        <select id="history-mode" name="mode">
          <option value="versions">Numéros de version</option>
          <option value="dates">Dates d’enregistrement</option>
        </select>
      </label>
      <label for="history-before">
        Avant
        <select id="history-before" name="avant"></select>
      </label>
      <label for="history-after">
        Après
        <select id="history-after" name="apres"></select>
      </label>
      <label for="history-date-before" hidden>
        Première date
        <input
          type="date"
          id="history-date-before"
          name="dateAvant"
          aria-describedby="history-date-help"
          disabled
        />
      </label>
      <label for="history-date-after" hidden>
        Deuxième date
        <input
          type="date"
          id="history-date-after"
          name="dateApres"
          aria-describedby="history-date-help"
          disabled
        />
      </label>
      <button class="button" type="submit">
        Comparer
      </button>
    </form>
    <p id="history-date-help" class="small muted" hidden>
      La comparaison retient la dernière version dont l’enregistrement est daté
      à la fin de chaque journée, heure de Paris.
    </p>
    <noscript>
      <p class="notice">
        Les versions et leurs résumés restent consultables dans le journal
        ci-dessous et sur chaque fiche.
      </p>
    </noscript>
    <p id="history-status" class="results-meta" role="status"></p>
    <div id="history-result">
      <p class="notice">Sélectionnez une fiche pour examiner ses versions.</p>
    </div>
  </section>
  <section class="section-space">
    <div class="register-heading">
      <h2>Dernières modifications éditoriales</h2>
      <span class="index-total">{updated.length}</span>
    </div>
    <PagedResults total={updated.length}>
      <ol class="version-timeline" data-document-list>
        {updated.map((version) => {
          const measure = measures.find(
            (item) => item.id === version.measureId,
          )!;
          return (
            <li data-page-item>
              <span class="version-node" aria-hidden="true"></span>
              <div>
                <time datetime={version.observedOn}>
                  {formatDate(version.observedOn)}
                </time>
                <h3>
                  <a
                    href={`/historique/?mesure=${measure.id}&apres=${version.number}`}
                  >
                    {measure.title}
                  </a>
                </h3>
                <p>
                  {
                    candidates.find(
                      (candidate) => candidate.id === measure.candidate,
                    )!.name
                  }{' '}
                  · version {version.number}
                </p>
                <p>{version.summary}</p>
              </div>
              <Icon name="historique" />
            </li>
          );
        })}
      </ol>
    </PagedResults>
  </section>
  <script src="../scripts/history.ts"></script>
  <script src="../scripts/document-pages.ts"></script>
</Base>
