---
import '../styles/global.css';
import '../styles/features.css';
import '../styles/editorial.css';
import '../styles/edition.css';
import { navigationFor } from '../lib/navigation';
import SiteFooter from '../components/SiteFooter.astro';
import BrandLogo from '../components/BrandLogo.astro';
import SiteNavigation from '../components/SiteNavigation.astro';
import { menuStyle } from '../lib/menu-sprite';
import Icon from '../components/Icon.astro';
import ShareLinks from '../components/ShareLinks.astro';
import { socialImageFor } from '../lib/social-images.mjs';
import archivoFont from '../assets/fonts/archivo-latin.woff2?url';
import { meta, formatDate } from '../lib/data';
interface Props {
  title?: string;
  description?: string;
  section?: string;
  noindex?: boolean;
}
const {
  title = 'Présidentielle 2027',
  description = 'Programmes, candidatures, calendrier et sources de la présidentielle française de 2027.',
  section = '',
  noindex = false,
} = Astro.props;
const navigation = navigationFor(Astro.url.pathname, section);
const canonical = new URL(Astro.url.pathname, Astro.site);
const social = socialImageFor(Astro.url.pathname);
const socialImageUrl = new URL(social.url, Astro.site);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#101e2c" />
    <link
      rel="preload"
      href={archivoFont}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href={menuStyle} />
    <title>{title} · Polradar</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Publications et mises à jour Polradar"
      href="/rss.xml"
    />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={`${title} · Polradar`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Polradar" />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={social.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} · Polradar`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={social.alt} />
  </head>
  <body data-desk={Astro.url.pathname === '/' ? 'accueil' : navigation.desk}>
    <a class="skip-link" href="#contenu">
      Aller au contenu
    </a>
    <div class="app-frame">
      <header class="publication-header">
        <div class="masthead">
          <div class="rail-brand">
            <a href="/" class="wordmark" aria-label="Polradar, accueil">
              <BrandLogo />
            </a>
            <p>
              <span class="election-context">Présidentielle française</span>
              <span class="election-year">2027</span>
            </p>
            <a href="/recherche/" class="mobile-search" aria-label="Rechercher">
              <Icon name="search" />
            </a>
          </div>
          <div class="masthead-actions">
            <time datetime={meta.edition}>
              Édition du
              <br />
              {formatDate(meta.edition)}
            </time>
            <a href="/recherche/">
              <Icon name="search" />
              Rechercher
            </a>
          </div>
        </div>
        <SiteNavigation current={navigation.current} />
      </header>
      <div class="page-column">
        <main id="contenu" class="container" tabindex="-1">
          <slot />
          <ShareLinks title={title} canonical={canonical} />
        </main>
        <SiteFooter />
      </div>
    </div>
    <script src="../scripts/follow.ts"></script>
  </body>
</html>
