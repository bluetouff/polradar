---
import '../styles/global.css';
import { meta, formatDate } from '../lib/data';
interface Props {
  title?: string;
  description?: string;
  section?: string;
  noindex?: boolean;
}
const {
  title = 'Présidentielle 2027',
  description = 'Programmes, candidatures, calendrier et sources de la présidentielle française de 2027.',
  section = '',
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [
  ['/', 'Accueil'],
  ['/candidats/', 'Candidats'],
  ['/comparer/', 'Comparer'],
  ['/themes/', 'Thèmes'],
  ['/campagne/', 'Chronologie'],
  ['/dossiers/', 'Dossiers'],
  ['/economie/', 'Économie'],
  ['/sondages/', 'Sondages'],
];
const active = (url: string) =>
  url === '/'
    ? Astro.url.pathname === '/'
    : section === url || Astro.url.pathname.startsWith(url);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <meta name="color-scheme" content="light" />
    <title>{title} · Polradar</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Dossiers Polradar"
      href="/rss.xml"
    />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={`${title} · Polradar`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
  </head>
  <body>
    <a class="skip-link" href="#contenu">
      Aller au contenu
    </a>
    <div class="app-frame">
      <aside class="site-rail">
        <header class="rail-brand">
          <a href="/" class="wordmark" aria-label="Polradar, accueil">
            polradar<span aria-hidden="true" class="wordmark-cursor"></span>
          </a>
          <p>
            Présidentielle française<span>2027</span>
          </p>
        </header>
        <nav class="main-nav" aria-label="Navigation principale">
          {nav.map(([url, label], index) => (
            <a href={url} aria-current={active(url) ? 'page' : undefined}>
              <span class="nav-index" aria-hidden="true">
                {String(index).padStart(2, '0')}
              </span>
              <span>{label}</span>
              <span class="nav-marker" aria-hidden="true">
                ↗
              </span>
            </a>
          ))}
        </nav>
        <nav class="rail-utility" aria-label="Informations">
          <a href="/engagements/">Tous les engagements</a>
          <a href="/sources/">Sources</a>
          <a href="/reperes/">Calendrier électoral</a>
          <a href="/methode/">Méthode</a>
        </nav>
        <div class="rail-note">
          <span class="registration-mark" aria-hidden="true">
            +
          </span>
          <span>
            France
            <br />
            Scrutin présidentiel
          </span>
        </div>
      </aside>
      <div class="page-column">
        <header class="site-bar">
          <span>FRANCE / PRÉSIDENTIELLE 2027</span>
          <time datetime={meta.edition}>
            Édition du {formatDate(meta.edition)}
          </time>
          <a href="/recherche/">
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <circle cx="8" cy="8" r="5.5" />
              <path d="m12 12 5 5" />
            </svg>
            Rechercher
          </a>
        </header>
        <main id="contenu" class="container" tabindex="-1">
          <slot />
        </main>
        <footer class="site-footer">
          <div class="footer-links">
            <span>Polradar · bluetouff</span>
            <a href="/transparence/">À propos</a>
            <a href="/methode/">Méthode</a>
            <a href="/sources/">Sources</a>
            <a href="/reperes/">Calendrier</a>
            <a href="/engagements/">Engagements</a>
            <a href="/mentions/">Mentions & confidentialité</a>
            <a href={meta.repository} target="_blank" rel="noopener noreferrer">
              GitHub · MIT ↗
            </a>
            <a href="/rss.xml">RSS</a>
          </div>
          <p>
            Programmes consultés au {formatDate(meta.corpusUpdated)} · Sélection
            non exhaustive
          </p>
        </footer>
      </div>
    </div>
  </body>
</html>
