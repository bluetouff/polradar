---
import '../styles/global.css';
import '../styles/features.css';
import '../styles/mobile-nav.css';
import '../styles/editorial.css';
import SiteFooter from '../components/SiteFooter.astro';
import Icon from '../components/Icon.astro';
import archivoFont from '../assets/fonts/archivo-latin.woff2?url';
import { meta, formatDate } from '../lib/data';
interface Props {
  title?: string;
  description?: string;
  section?: string;
  noindex?: boolean;
}
const {
  title = 'Présidentielle 2027',
  description = 'Programmes, candidatures, calendrier et sources de la présidentielle française de 2027.',
  section = '',
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [
  ['/', 'Accueil', 'institutions'],
  ['/mesures/', 'Mesures', 'mesures'],
  ['/comparer/', 'Comparer', 'layers'],
  ['/divergences/', 'Divergences', 'exchange'],
  ['/candidats/', 'Candidats', 'people'],
  ['/evolution/', 'Évolution', 'historique'],
  ['/financements/', 'Financements', 'exchange'],
  ['/campagne/', 'Campagne', 'historique'],
  ['/sondages/', 'Sondages', 'sondages'],
  ['/marches-predictifs/', 'Marchés', 'markets'],
  ['/temps-de-parole/', 'Temps de parole', 'microphone'],
  ['/budget-programmes/', 'Budgets', 'euro'],
  ['/agenda/', 'Agenda', 'map-pin'],
  ['/veille/', 'Veille', 'veille'],
  ['/historique/', 'Historique', 'historique'],
  ['/suivi/', 'Mon suivi', 'suivi'],
];
const primaryUrls = [
  '/',
  '/mesures/',
  '/comparer/',
  '/divergences/',
  '/candidats/',
  '/evolution/',
  '/financements/',
  '/campagne/',
];
const active = (url: string) =>
  url === '/'
    ? Astro.url.pathname === '/'
    : section === url || Astro.url.pathname.startsWith(url);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#173746" />
    <link
      rel="preload"
      href={archivoFont}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <title>{title} · Polradar</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Publications et mises à jour Polradar"
      href="/rss.xml"
    />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={`${title} · Polradar`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
  </head>
  <body>
    <a class="skip-link" href="#contenu">
      Aller au contenu
    </a>
    <div class="app-frame">
      <header class="publication-header">
        <div class="masthead">
          <div class="rail-brand">
            <a href="/" class="wordmark" aria-label="Polradar, accueil">
              <svg class="brand-mark" viewBox="0 0 40 40" aria-hidden="true">
                <path
                  d="M9 7v27m0-26h12a9 9 0 0 1 0 18H9"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="4"
                />
                <path d="M29 29h7v7h-7z" fill="currentColor" />
              </svg>
              polradar
            </a>
            <p>
              <span class="election-context">Présidentielle française</span>
              <span class="election-year">2027</span>
            </p>
            <details class="mobile-navigation">
              <summary>
                Menu <Icon name="filter" />
              </summary>
              <nav aria-label="Navigation complète">
                {nav.map(([url, label]) => (
                  <a href={url} aria-current={active(url) ? 'page' : undefined}>
                    {label}
                  </a>
                ))}
                <a href="/themes/">Thèmes</a>
                <a href="/dossiers/">Dossiers</a>
                <a href="/sources/">Sources</a>
                <a href="/reperes/">Calendrier électoral</a>
                <a href="/recherche/">Rechercher</a>
              </nav>
            </details>
          </div>
          <div class="masthead-actions">
            <time datetime={meta.edition}>
              Édition du
              <br />
              {formatDate(meta.edition)}
            </time>
            <a href="/recherche/">
              <Icon name="search" />
              Rechercher
            </a>
          </div>
        </div>
        <div class="publication-nav">
          <nav class="main-nav" aria-label="Navigation principale">
            {nav
              .filter(([url]) => primaryUrls.includes(url))
              .map(([url, label, icon]) => (
                <a href={url} aria-current={active(url) ? 'page' : undefined}>
                  <Icon name={icon} />
                  <span>{label}</span>
                </a>
              ))}
          </nav>
          <details class="publication-nav-more">
            <summary>
              Explorer <Icon name="filter" />
            </summary>
            <nav aria-label="Autres rubriques">
              {nav
                .filter(([url]) => !primaryUrls.includes(url))
                .map(([url, label, icon]) => (
                  <a href={url} aria-current={active(url) ? 'page' : undefined}>
                    <Icon name={icon} />
                    {label}
                  </a>
                ))}
              <a href="/themes/">
                <Icon name="layers" />
                Thèmes
              </a>
              <a href="/dossiers/">
                <Icon name="source" />
                Dossiers
              </a>
              <a href="/sources/">
                <Icon name="source" />
                Sources
              </a>
              <a href="/methode/">
                <Icon name="check" />
                Méthode
              </a>
            </nav>
          </details>
        </div>
      </header>
      <div class="page-column">
        <main id="contenu" class="container" tabindex="-1">
          <slot />
        </main>
        <SiteFooter />
      </div>
    </div>
    <script src="../scripts/follow.ts"></script>
  </body>
</html>
