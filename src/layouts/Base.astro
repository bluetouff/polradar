---
import '../styles/global.css';
import '../styles/features.css';
import Icon from '../components/Icon.astro';
import archivoFont from '../assets/fonts/archivo-latin.woff2?url';
import { meta, formatDate } from '../lib/data';
interface Props {
  title?: string;
  description?: string;
  section?: string;
  noindex?: boolean;
}
const {
  title = 'Présidentielle 2027',
  description = 'Programmes, candidatures, calendrier et sources de la présidentielle française de 2027.',
  section = '',
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [
  ['/', 'Accueil', 'institutions'],
  ['/mesures/', 'Mesures', 'mesures'],
  ['/comparer/', 'Comparer', 'layers'],
  ['/candidats/', 'Candidats', 'people'],
  ['/campagne/', 'Campagne', 'historique'],
  ['/sondages/', 'Sondages', 'sondages'],
  ['/marches-predictifs/', 'Marchés', 'markets'],
  ['/veille/', 'Veille', 'veille'],
  ['/historique/', 'Historique', 'historique'],
  ['/suivi/', 'Mon suivi', 'suivi'],
];
const active = (url: string) =>
  url === '/'
    ? Astro.url.pathname === '/'
    : section === url || Astro.url.pathname.startsWith(url);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#173746" />
    <link
      rel="preload"
      href={archivoFont}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <title>{title} · Polradar</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Publications et mises à jour Polradar"
      href="/rss.xml"
    />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={`${title} · Polradar`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
  </head>
  <body>
    <a class="skip-link" href="#contenu">
      Aller au contenu
    </a>
    <div class="app-frame">
      <aside class="site-rail">
        <header class="rail-brand">
          <a href="/" class="wordmark" aria-label="Polradar, accueil">
            <svg class="brand-mark" viewBox="0 0 40 40" aria-hidden="true">
              <path
                d="M9 7v27m0-26h12a9 9 0 0 1 0 18H9"
                fill="none"
                stroke="currentColor"
                stroke-width="4"
              />
              <path d="M29 29h7v7h-7z" fill="#f2b39d" />
            </svg>
            polradar
          </a>
          <p>
            Présidentielle française<span>2027</span>
          </p>
        </header>
        <nav class="main-nav" aria-label="Navigation principale">
          {nav.map(([url, label, icon]) => (
            <a href={url} aria-current={active(url) ? 'page' : undefined}>
              <Icon name={icon} />
              <span>{label}</span>
              <span class="nav-marker" aria-hidden="true">
                ↗
              </span>
            </a>
          ))}
        </nav>
        <nav class="rail-utility" aria-label="Informations">
          <a href="/themes/">Thèmes</a>
          <a href="/dossiers/">Dossiers</a>
          <a href="/economie/">Économie</a>
          <a href="/sources/">Sources</a>
          <a href="/reperes/">Calendrier électoral</a>
          <a href="/methode/">Méthode</a>
        </nav>
        <div class="rail-note">
          <span class="registration-mark" aria-hidden="true">
            +
          </span>
          <span>
            France
            <br />
            Scrutin présidentiel
          </span>
        </div>
      </aside>
      <div class="page-column">
        <header class="site-bar">
          <span>FRANCE / PRÉSIDENTIELLE 2027</span>
          <time datetime={meta.edition}>
            Édition du {formatDate(meta.edition)}
          </time>
          <a href="/recherche/">
            <Icon name="search" />
            Rechercher
          </a>
        </header>
        <main id="contenu" class="container" tabindex="-1">
          <slot />
        </main>
        <footer class="site-footer">
          <div class="footer-links">
            <span class="footer-credit">
              <span>Polradar · a</span>
              <a href="https://l0g.fr/" class="log-wordmark" aria-label="l0g_">
                <span aria-hidden="true">l</span>
                <span class="log-wordmark-zero" aria-hidden="true">
                  0
                </span>
                <span aria-hidden="true">g</span>
                <span class="log-wordmark-cursor" aria-hidden="true">
                  _
                </span>
              </a>
              <span>website by</span>
              <a href="https://bluetouff.com/">bluetouff</a>
            </span>
            <a href="/transparence/">À propos</a>
            <a href="/methode/">Méthode</a>
            <a href="/sources/">Sources</a>
            <a href="/themes/">Thèmes</a>
            <a href="/dossiers/">Dossiers</a>
            <a href="/economie/">Économie</a>
            <a href="/campagne/">Chronologie</a>
            <a href="/reperes/">Calendrier</a>
            <a href="/engagements/">Engagements</a>
            <a href="/mentions/">Mentions & confidentialité</a>
            <a href={meta.repository} target="_blank" rel="noopener noreferrer">
              GitHub · MIT ↗
            </a>
            <a href="/rss.xml">RSS</a>
          </div>
          <p>
            Corpus mis à jour le {formatDate(meta.corpusUpdated)} · Sélection
            non exhaustive
          </p>
        </footer>
      </div>
    </div>
    <script src="../scripts/follow.ts"></script>
  </body>
</html>
