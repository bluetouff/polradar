---
import '../styles/global.css';
import '../styles/features.css';
import '../styles/editorial.css';
import '../styles/edition.css';
import '../styles/cards.css';
import '../styles/reading.css';
import { navigationFor } from '../lib/navigation';
import SiteFooter from '../components/SiteFooter.astro';
import CompactFooter from '../components/CompactFooter.astro';
import SupportLink from '../components/SupportLink.astro';
import BrandLogo from '../components/BrandLogo.astro';
import SiteNavigation from '../components/SiteNavigation.astro';
import SiteDirectory from '../components/SiteDirectory.astro';
import { menuStyle } from '../lib/menu-sprite';
import ShareLinks from '../components/ShareLinks.astro';
import { socialImageFor } from '../lib/social-images.mjs';
import archivoFont from '../assets/fonts/archivo-latin.woff2?url';
import { meta, formatDate } from '../lib/data';
interface Props {
  title?: string;
  description?: string;
  section?: string;
  noindex?: boolean;
  canonicalPath?: string;
  publicationTool?: boolean;
  articlePublished?: string;
  lastModified?: string;
  language?: 'fr' | 'en';
}
const {
  title = 'Présidentielle 2027',
  description = 'Programmes, candidatures, calendrier et sources de la présidentielle française de 2027.',
  section = '',
  publicationTool = false,
  articlePublished,
  lastModified,
  noindex = false,
  canonicalPath = Astro.url.pathname,
  language = 'fr',
} = Astro.props;
const navigation = navigationFor(Astro.url.pathname, section);
const Footer =
  Astro.url.pathname.split('/').filter(Boolean).length > 1
    ? CompactFooter
    : SiteFooter;
const canonical = new URL(canonicalPath, Astro.site);
// News briefs and the dataset catalogue identify their more specific entities in the page.
const specificSchema =
  /^\/breves\/[^/]+\//.test(canonical.pathname) ||
  canonical.pathname === '/donnees/';
const schemaType =
  noindex || specificSchema
    ? undefined
    : canonical.pathname === '/'
      ? 'WebSite'
      : 'WebPage';
const social = socialImageFor(Astro.url.pathname);
const socialImageUrl = new URL(social.url, Astro.site);
---

<!doctype html>
<html
  lang={language}
  data-last-modified={lastModified}
  itemscope={Boolean(schemaType)}
  itemtype={schemaType && 'https://schema.org/' + schemaType}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#192d38" />
    <link
      rel="preload"
      href={archivoFont}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href={menuStyle} />
    <title
      itemprop={schemaType === 'WebPage' ? 'name' : undefined}
    >{title} · Polradar</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonical} />
    <slot name="head" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="apple-touch-icon" href="/marque/polradar-192.png" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={
        section === '/breves/'
          ? 'Brèves de campagne'
          : 'Publications et mises à jour Polradar'
      }
      href={section === '/breves/' ? '/breves/rss.xml' : '/rss.xml'}
    />
    <meta
      property="og:type"
      content={articlePublished ? 'article' : 'website'}
    />
    {articlePublished && (
      <meta property="article:published_time" content={articlePublished} />
    )}
    <meta
      property="og:locale"
      content={language === 'en' ? 'en_GB' : 'fr_FR'}
    />
    <meta property="og:title" content={`${title} · Polradar`} />
    <meta
      property="og:description"
      content={description}
      itemprop={schemaType && 'description'}
    />
    <meta
      property="og:url"
      content={canonical}
      itemprop={schemaType && 'url'}
    />
    <meta
      property="og:site_name"
      content="Polradar"
      itemprop={schemaType === 'WebSite' ? 'name' : undefined}
    />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:secure_url" content={socialImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={social.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} · Polradar`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={social.alt} />
  </head>
  <body data-desk={Astro.url.pathname === '/' ? 'accueil' : navigation.desk}>
    <a class="skip-link" href="#contenu">
      {language === 'en' ? 'Skip to content' : 'Aller au contenu'}
    </a>
    <div class="app-frame">
      <header
        class="publication-header"
        lang={language === 'en' ? 'fr' : undefined}
      >
        <div class="masthead">
          <div class="rail-brand">
            <a href="/" class="wordmark" aria-label="Polradar, accueil">
              <BrandLogo />
            </a>
            <p>
              <span class="election-context">Présidentielle française</span>
              <span class="election-year">2027</span>
            </p>
          </div>
          <div class="masthead-actions">
            <time data-polradar-date="edition" datetime={meta.edition}>
              Édition du
              <br />
              {formatDate(meta.edition)}
            </time>
            {!publicationTool && <SiteDirectory />}
            <SupportLink compact />
            <a
              href="/recherche/"
              class="masthead-search"
              aria-label="Rechercher"
            >
              <span>Rechercher</span>
            </a>
          </div>
        </div>
        {!publicationTool && <SiteNavigation current={navigation.current} />}
      </header>
      <div class="page-column">
        <main id="contenu" class="container" tabindex="-1">
          <slot />
          {!publicationTool && language === 'fr' && (
            <ShareLinks title={title} canonical={canonical} />
          )}
        </main>
        <Footer language={language === 'en' ? 'fr' : undefined} />
      </div>
    </div>
    <script>
      import '../scripts/site-navigation';
      import '../scripts/footer-links';
      import '../scripts/follow';
    </script>
  </body>
</html>
