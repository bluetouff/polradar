    "statements": [
      {
        "author": "Emeric Salmon",
        "group": "Rassemblement national",
        "position": "Retirer l’article",
        "description": "Il veut conserver les moyens d’enquête existants. Au nom du RN, il s’engage à écarter toute obligation de porte dérobée et à encadrer les moyens d’enquête sous contrôle du juge si Marine Le Pen est élue."
      },
      {
        "author": "René Pilato",
        "group": "La France insoumise – NFP",
        "position": "Maintenir l’article",
        "description": "Il défend l’article pour empêcher qu’on impose des dispositifs qui affaibliraient la confidentialité des communications."
      },
      {
        "author": "Catherine Hervieu",
        "group": "Écologiste et social",
        "position": "Maintenir l’article",
        "description": "Elle annonce une demande de rapport sur la reconnaissance constitutionnelle du droit au chiffrement."
      }
    ],
    "earlier": {
      "date": "2025-03-20",
      "sourceId": "assemblee-narcotrafic-debat-chiffrement",
      "description": "Alors ministre de l’Intérieur, Bruno Retailleau défend une obligation d’assistance des services de messagerie pour certains accès autorisés. Il affirme que le chiffrement de bout en bout serait préservé."
    }
  }
