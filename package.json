{
  "name": "polradar",
  "version": "0.1.0",
  "private": true,
  "description": "Observatoire indépendant et sourcé de la présidentielle française de 2027.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check && node scripts/validate-content.mjs",
    "test": "node --test tests/*.test.mjs && python3 -m unittest discover -s tests/deploy -v",
    "build": "node scripts/validate-content.mjs && npm run og:render && node scripts/build-pages.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "security:audit": "node scripts/audit-dependencies.mjs",
    "validate": "astro check && npm test && npm run build",
    "og:render": "node scripts/render-social-images.mjs",
    "predev": "npm run og:render"
  },
  "dependencies": {
    "astro": "7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "sharp": "0.35.5",
    "typescript": "6.0.3"
  }
}
